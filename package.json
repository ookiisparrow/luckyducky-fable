{
  "name": "luckyducky-fable",
  "version": "1.0.0",
  "private": true,
  "description": "Lucky Ducky 重写线（fable）——生产源=rewrite/ 各包（本仓不留旧代码）；共用生产云环境（部署闸 guard-deploy）",
  "engines": {
    "node": ">=20.9",
    "npm": ">=10"
  },
  "workspaces": [
    "rewrite/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath scripts/git-hooks || exit 0",
    "dev": "vite --config mp-web/vite.config.mjs",
    "typecheck": "tsc -p rewrite/shared/tsconfig.json --noEmit && tsc -p rewrite/cloud/tsconfig.json && tsc -p rewrite/mp/tsconfig.json && npm exec -w @ldrw/site -- astro sync && tsc -p rewrite/site/tsconfig.json --noEmit && vue-tsc --noEmit -p rewrite/admin/tsconfig.json && vue-tsc --noEmit -p rewrite/agent/tsconfig.json",
    "build:rw-admin": "npm run build -w @ldrw/admin",
    "build:agent": "npm run build -w @ldrw/agent",
    "build:rw-cloud": "node rewrite/cloud/build.mjs",
    "verify:rw-cloud": "npm run build:rw-cloud && node scripts/verify-rw-cloud-bundles.cjs",
    "check:artifacts": "npm run verify:rw-cloud && npm run build:rw-admin && npm run build:agent && npm run build -w @ldrw/site",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:structure": "node scripts/check-structure.mjs",
    "preflight": "node scripts/preflight.mjs",
    "loadtest": "node scripts/loadtest.mjs",
    "env:resolve": "node scripts/env-resolve.mjs",
    "smoke:mp": "node scripts/mp-smoke.cjs",
    "preview:mp": "node scripts/stamp-mp-version-date.mjs && node scripts/push-mp-preview.mjs",
    "deploy:test": "node scripts/deploy-test.mjs",
    "db:export": "node scripts/db-export.mjs",
    "db:check-indexes": "node scripts/check-indexes.mjs",
    "mutation": "stryker run",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run check:structure && npm run typecheck && npm run lint && npm run test",
    "release": "node scripts/release.mjs",
    "mp:stamp-version-date": "node scripts/stamp-mp-version-date.mjs",
    "mac:sync-ends": "node scripts/mac-sync-ends.mjs",
    "device:status": "node scripts/real-device.mjs status",
    "device:open": "node scripts/real-device.mjs open",
    "device:preview": "node scripts/stamp-mp-version-date.mjs && node scripts/real-device.mjs preview",
    "device:debug": "node scripts/real-device.mjs debug",
    "agent:status": "node scripts/wechat-agent.mjs status",
    "agent:open": "node scripts/wechat-agent.mjs open",
    "agent:debug": "node scripts/wechat-agent.mjs debug",
    "agent:preview": "node scripts/stamp-mp-version-date.mjs && node scripts/wechat-agent.mjs preview",
    "agent:net": "node scripts/wechat-agent.mjs net",
    "agent:read": "node scripts/wechat-agent.mjs read-data",
    "agent:nav": "node scripts/wechat-agent.mjs nav",
    "agent:eval": "node scripts/wechat-agent.mjs eval",
    "flow:test": "node scripts/automation-flow.mjs",
    "flow:probe": "node scripts/automation-flow.mjs probe",
    "flow:data": "node scripts/automation-flow.mjs data",
    "test:func": "node scripts/test-api/functional.mjs",
    "test:conc": "node scripts/test-api/concurrent.mjs",
    "test:soak": "node scripts/test-api/soak.mjs",
    "test:sec": "node scripts/test-api/security.mjs",
    "test:auth": "node scripts/test-api/security-auth.mjs",
    "patrol": "sh scripts/daily-patrol.sh",
    "cert:check": "node scripts/check-cert-expiry.mjs"
  },
  "devDependencies": {
    "@cloudbase/manager-node": "5.7.0",
    "@cloudbase/node-sdk": "^4.0.3",
    "@eslint/js": "^9.10.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/compiler-sfc": "^3.5.40",
    "@vue/test-utils": "^2.4.11",
    "esbuild": "^0.28.1",
    "eslint": "^9.10.0",
    "eslint-plugin-vue": "^9.28.0",
    "fast-check": "^4.9.0",
    "globals": "^15.9.0",
    "happy-dom": "^20.11.1",
    "miniprogram-api-typings": "^5.2.2",
    "miniprogram-automator": "^0.12.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8",
    "vue-tsc": "~2.2.10",
    "wx-server-sdk": "file:tests/helpers/wx-server-sdk"
  },
  "overrides": {
    "axios": "^1.19.0",
    "minimist": "^1.2.8",
    "sharp": "^0.35.3",
    "request": {
      "qs": "^6.15.2",
      "tough-cookie": "^4.1.3",
      "form-data": "^4.0.6"
    },
    "vod-js-sdk-v6": {
      "uuid": "^3.4.0"
    }
  }
}
