#!/bin/sh
# 红区双人复核闸（commit-msg hook·老板令）
# pre-commit 阶段拿不到本次提交信息（git log -1 是旧 HEAD），故提交信息标记检查在此做：
# 暂存区含 red 模块文件（订单钱链 orders / 运维配置 ops）→ 提交信息必须带 [red-review: <复核人>]，
# 缺复核即拦下。守卫 rw-gates-wired 盯着本钩子在位、已注册。
#
# 用法：git commit 自动触发；紧急绕过（不建议）：git commit --no-verify
MSG_FILE="$1"
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"

# ① 暂存区是否含 red 文件（与守卫同源：从 modules.json 推导，此处用轻量路径前缀匹配）
RED_DIRS="rewrite/cloud/src/functions/app/actions/orders.ts rewrite/cloud/src/functions/adminApi/actions/orders.ts rewrite/cloud/src/functions/adminApi/actions/refunds.ts rewrite/cloud/src/functions/adminApi/actions/reconciliation.ts rewrite/cloud/src/functions/adminApi/actions/wxbill.ts rewrite/cloud/src/functions/adminApi/actions/ops.ts rewrite/cloud/src/functions/adminApi/actions/configChecklist.ts rewrite/cloud/src/functions/adminApi/actions/secureConfig.ts rewrite/cloud/src/functions/adminApi/actions/dashboard.ts rewrite/cloud/src/kit/gate.ts rewrite/cloud/src/kit/wxpay.ts rewrite/cloud/src/kit/transition.ts rewrite/shared/src/money.ts"

TOUCHED=""
for f in $(git diff --cached --name-only 2>/dev/null); do
  for rf in $RED_DIRS; do
    case "$f" in
      "$rf"|"$rf"/*) TOUCHED="$TOUCHED $f" ;;
    esac
  done
done

[ -z "$TOUCHED" ] && exit 0

# ② 提交信息须带双人复核标记
if ! grep -qE '\[red-review:[[:space:]]*[^]]+\]' "$MSG_FILE"; then
  echo ""
  echo "❌ 红区复核闸：本次改动涉及钱链/运维红区文件：$TOUCHED"
  echo "   须在 commit message 加 [red-review: <复核人>]（谁独立复核过这笔改动），缺复核即拦。"
  echo "   示例：git commit -m \"fix：xxx [red-review: Hermes]\""
  echo ""
  exit 1
fi
exit 0
