#!/bin/sh
# 提交闸（git pre-commit hook）：每次 git commit 前自动跑全套 `npm run check`，红灯则拦下提交。
#
# - 本目录通过 package.json 的 prepare 脚本注册为 git core.hooksPath，npm install 后自动生效。
# - **质量闸单一定义**：本闸与 CI 都调 `npm run check`，守卫 rw-gates-wired 盯接线。
# - 检查当前工作区全量（非仅暂存）：单人短分支流下足够。
# - 红区闸：暂存文件命中 scripts/lib/red-paths.mjs 清单且未显式设 RED_ALLOWED=1 时直接拦下——
#   红区改动须老板授权，与部署闸 DEPLOY_ALLOWED 同模式。闸拦「顺手误用」，拦不住刻意绕过。
# - 紧急绕过（不建议）：git commit --no-verify

# ── 红区提交闸 ──────────────────────────────────────────────
if [ "$RED_ALLOWED" != "1" ]; then
  HIT=$(git diff --cached --name-only | node -e "
    let d='';
    process.stdin.on('data',(c)=>d+=c).on('end',()=>{
      import('./scripts/lib/red-paths.mjs').then(({isRedPath})=>{
        const hits=d.split('\n').filter(Boolean).filter(isRedPath);
        hits.forEach(h=>console.log('  '+h));
        process.exit(0);
      }).catch(()=>{ console.log('  （红区名单 scripts/lib/red-paths.mjs 读不到，按红区处理）'); process.exit(0); });
    });")
  if [ -n "$HIT" ]; then
    echo ""
    echo "❌ 红区提交闸：以下暂存文件属红区（钱链 / 运维配置 / 身份闸），未获授权不可提交："
    echo "$HIT"
    echo ""
    echo "   红区改动须老板明示授权。确认后：RED_ALLOWED=1 git commit ...（其余参数照旧）"
    exit 1
  fi
fi

# 小程序版本脚：提交时自动戳上海当天（并按当前枝对齐通道）。人不用记 mp:stamp-version-date。
node scripts/stamp-mp-version-date.mjs
git add rewrite/mp/lib/appVersion.ts 2>/dev/null || true

echo "提交闸：npm run check（structure + typecheck + lint + test）..."

npm run check || {
  echo ""
  echo "❌ 质量闸未通过，已拦下本次提交。"
  echo "   结构不变量例外加 structure-ok；lint 可试 npm run lint:fix。"
  exit 1
}

echo "✅ 提交闸通过。"
