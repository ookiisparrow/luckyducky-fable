<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.luckyducky.dbbackup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-lc</string>
    <string>cd $HOME/luckyducky-fable &amp;&amp; env -u http_proxy -u https_proxy npm run db:export</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/tmp/luckyducky-dbexport.log</string>
  <key>StandardErrorPath</key><string>/tmp/luckyducky-dbexport.log</string>
</dict>
</plist>
