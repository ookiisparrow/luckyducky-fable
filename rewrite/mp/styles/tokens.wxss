/* 设计 token 单一来源（幸运紫色票——改配色只改这里）。
   CSS 变量在双引擎均已真机验证。 */
page {
  /* 幸运紫 */
  --ld-purple: #a371ea; /* 强调、已验证 */
  --ld-purple-tab: #7b5caf; /* Tab 选中 */
  --ld-purple-meta: #7e6e96; /* 次要图标标签 */
  --ld-purple-line: #c9bbe0; /* 卡片描边 */
  --ld-purple-ink: #241733; /* 深紫黑：主 CTA */
  /* 中性 */
  --ld-ink: #222222;
  --ld-content: #3d3d42; /* 正文墨（重设计中性文字·非暖棕） */
  --ld-content-2: #6e6e76; /* 次要文字：划线价、用户名、说明 */
  --ld-bg: #ffffff;
  --ld-bg-lilac: #fcfaff;
  --ld-bg-sage: #edeee8; /* 媒体/占位底 */
  --ld-bg-grey: #f3f3f3; /* 买家秀条带底 */
  --ld-bg-faint: #fafafa;
  --ld-line: #e7e7e7; /* 中性发丝线：折叠组/分隔 */
  --ld-line-soft: #eeeeee;
  --ld-surface-cream: #e8e2d6; /* 商品卡暖描边 */
  /* 鸭黄暖点（评分/意象） */
  --ld-duck: #f9bf63;
  --ld-duck-deep: #f2ac3c; /* 买家秀星标 */
  /* 几何 */
  --ld-radius: 24rpx;
  --ld-radius-sm: 10rpx; /* 商品/买家秀卡（设计 5px）*/
  --ld-radius-md: 18rpx; /* 折叠组/特写图（设计 9px）*/
  --ld-radius-pill: 999rpx;
  /* 品牌字体（文源圆体 WenYuan Rounded SC）：分层子集 WebFont 远程加载（loadBrandFonts·utils/brandFont.ts）
     ——T1(tab首屏字·最先到) → T2(二级页字) → T3(GB2312兜底·UGC) 三族按 CSS 逐字回退补字，
     到达前/失败时回退系统圆体栈（FOUT 可接受）。
     应用范围＝全局 page（拍板·不只标题）。族名单源 utils/brandFont.ts。 */
  --ld-font-brand: 'WenYuan Rounded SC', 'WenYuan Rounded SC T2', 'WenYuan Rounded SC T3', 'PingFang SC',
    'SF Pro Rounded', ui-rounded, 'Hiragino Sans GB', system-ui, sans-serif;
}

/* ── v5 视觉（Claude Design「Lucky Ducky App v5 字重」稿）──
   重做中的页面只用下面这组；上面旧色票随页面重做逐步退役，全部换完即删。
   字：圆体 300 辅助小字 / 500 正文 / 700 标题 / 900 大标题；价格、单号、时长、计数用等宽 500/600。
   语义色只落在状态灯、描边、短文字上；文字用加深档（-text）；一屏最多两种（紫不计）；主键不上色。
   .v5-scope：自定义组件（custom-tab-bar 等）拿不到 page 上的变量，根节点挂这个类再定义一遍。 */
page,
.v5-scope {
  --v5-canvas: #fafaf8; /* 页面底 */
  --v5-sunk: #ededea; /* 图片占位、凹槽、平面键 */
  --v5-ink: #111111;
  --v5-ink-2: #62625c; /* 次要文字 */
  --v5-ink-3: #8f8f88; /* 弱/不可点 */
  --v5-ink-4: #9a9a92; /* 输入框占位 */
  --v5-hair: rgba(17, 17, 17, 0.14); /* 发丝线、浅色键描边 */
  --v5-key: #1c1c1a; /* 墨黑键 */
  --v5-key-seat: #68685f; /* 墨黑键底部键座 */
  --v5-key-hi: #f7f7f4; /* 键帽白、墨黑键上的字 */
  --v5-violet: #8a5ae0; /* 当前/选中 */
  --v5-violet-text: #6b3fc4;
  --v5-violet-soft: #b79cf0;
  --v5-ok: #3f9a5e;
  --v5-ok-text: #2f7a48;
  --v5-warn: #f4bd3f;
  --v5-warn-text: #8a6100;
  --v5-err: #d9483b;
  --v5-err-text: #b7362b;
  --v5-dark: #121212; /* 播放页暗底 */
  --v5-dark-key: #262626;
  --v5-font-mono: ui-monospace, 'SF Mono', Menlo, monospace;
}
