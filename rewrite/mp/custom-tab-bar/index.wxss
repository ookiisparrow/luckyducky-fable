/* 底部三键 TabBar（v5）：满宽贴底，三颗等宽键；选中＝浅色键，未选＝平面键。
   占高＝上 8 + 键 44 + 下 max(24, 安全区)——tab 页底部留白按这个数算（首页首屏高度同）。 */
.ld-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 8px;
  padding: 8px 16px max(24px, env(safe-area-inset-bottom));
  background: var(--v5-canvas);
}
.ld-tab {
  flex: 1;
  font-size: 15px;
}
.k-flat.ld-tab {
  color: var(--v5-ink-2);
}
.ld-tab-count {
  font-size: 13px;
  letter-spacing: -0.02em;
  color: var(--v5-ink-2);
}
