/* 底部三格 TabBar（v6 Lite「降存在感」·老板 2026-09-30）：三格平面、只放像素图标，紫＝当前、其余 ink-2；
   不显示购物车件数；顶部一条 .10 分隔线。占高＝上 8 + 格 44 + 下 max(24, 安全区)——tab 页底部留白按这个数算。 */
.ld-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 8px;
  padding: 8px 16px max(24px, env(safe-area-inset-bottom));
  background: var(--v5-canvas);
  border-top: 1px solid rgba(17, 17, 17, 0.1);
}
.ld-tab {
  flex: 1;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}
