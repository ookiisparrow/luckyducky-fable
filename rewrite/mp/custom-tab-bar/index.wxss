/* 悬浮胶囊 TabBar（2026-07-16 悬浮形态；2026-09-11 只留图标）。
   高度对齐去字前版本：外垫 12 + tab 上下 20 + icon 38（原先文字与 icon 横排，高度由 icon 决定）。 */
.ld-tabbar {
  position: fixed;
  left: 44rpx;
  right: 44rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 8rpx;
  padding: 12rpx;
  background: var(--ld-bg, #ffffff);
  border-radius: var(--ld-radius-pill, 999rpx);
  box-shadow: 0 12rpx 40rpx rgba(28, 28, 32, 0.2), 0 4rpx 12rpx rgba(28, 28, 32, 0.1);
}
.ld-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  border-radius: var(--ld-radius-pill, 999rpx);
}
.ld-tab-iconwrap {
  position: relative;
}
.ld-tab-icon {
  width: 38rpx;
  height: 38rpx;
  display: block;
}
.ld-tab-badge {
  position: absolute;
  top: -12rpx;
  right: -16rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 8rpx;
  line-height: 28rpx;
  text-align: center;
  border-radius: var(--ld-radius-pill, 999rpx);
  background: var(--ld-purple, #a371ea);
  color: #ffffff;
  font-size: 18rpx;
}
.ld-tab.active {
  background: #f2ebfc;
}
