<view wx:if="{{!hidden}}" class="v5-scope ld-tabbar">
  <view
    wx:for="{{tabs}}"
    wx:key="id"
    class="k ld-tab {{active === item.id ? 'k-light ld-tab-on' : 'k-flat'}}"
    hover-class="{{active === item.id ? 'k-light-down' : 'k-flat-down'}}"
    hover-stay-time="100"
    data-id="{{item.id}}"
    data-path="{{item.path}}"
    bind:tap="onTap"
  >
    <text>{{item.label}}</text>
    <text wx:if="{{item.id === 'cart' && cartCount > 0}}" class="ld-tab-count">{{cartCount > 99 ? '99+' : cartCount}}</text>
  </view>
</view>
