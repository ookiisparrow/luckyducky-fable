<view wx:if="{{!hidden}}" class="v5-scope ld-tabbar">
  <view
    wx:for="{{tabs}}"
    wx:key="id"
    class="k ld-tab {{active === item.id ? 'k-light ld-tab-on' : 'k-flat'}}"
    hover-start-time="20" hover-class="{{active === item.id ? 'k-light-down' : 'k-flat-down'}}"
    hover-stay-time="100"
    data-id="{{item.id}}"
    data-path="{{item.path}}"
    bind:tap="onTap"
   data-k="{{active === item.id ? 'light' : 'flat'}}" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">
    <px-i name="{{item.id}}" />
    <text wx:if="{{item.id === 'cart' && cartCount > 0}}" class="t-sys ld-tab-count {{bump ? 'ld-tab-bump' : ''}}">{{cartCount > 99 ? '99+' : cartCount}}</text>
  </view>
</view>
