/* 编辑收货地址（v5「字重」稿 A7） */
page {
  background: var(--v5-canvas);
  color: var(--v5-ink);
}
/* 整页一列：顶栏 + 表单（scroll-view 自己滚·leave-sheet 武装时页面级滚动被冻结）+ 底部键 */
.ae-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.ae-scroll {
  flex: 1;
  height: 0;
}
.ae {
  padding: 4px 16px 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.ae-field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.ae-label {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.ae-input {
  width: 100%;
  height: 44px;
  padding: 0 16px;
  font-size: 17px;
  font-weight: 500;
  color: var(--v5-ink);
}
/* 详细地址（设计稿 L261）：最小高 64、内边距 16、行高 1.5、随内容长高。
   auto-height 由组件按内容写高度，用 content-box 让内边距加在外面不被吃掉（总高仍 ≥64） */
.ae-area {
  box-sizing: content-box;
  width: calc(100% - 32px);
  min-height: 32px;
  padding: 16px;
  font-size: 17px;
  font-weight: 500;
  line-height: 1.5;
  color: var(--v5-ink);
}
.ae-mono {
  font-family: var(--v5-font-mono);
  font-size: 15px;
  letter-spacing: 0.02em;
}
.ae-warn {
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.14), 0 0 0 1.5px var(--v5-warn);
}
.ae-ph {
  color: var(--v5-ink-4);
}
.ae-err {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-warn-text);
}
/* 地区框：平面键手感（按下沉 2px·松手回弹·同 .k） */
.ae-region {
  transition: transform 260ms cubic-bezier(0.2, 2.6, 0.5, 1), box-shadow 260ms cubic-bezier(0.25, 0.8, 0.35, 1),
    background-color 180ms ease-out;
  height: 44px;
  padding: 0 16px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.ae-region-t {
  flex: 1;
  min-width: 0;
  font-size: 17px;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ae-pick {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
/* 默认开关：凹槽轨道 + 键帽滑块，开＝滑到右侧并亮紫灯 */
.ae-def {
  padding-top: 4px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.ae-def-t {
  flex: 1;
  font-size: 17px;
  font-weight: 500;
}
.ae-switch {
  position: relative;
  width: 52px;
  height: 30px;
  flex: 0 0 auto;
}
.ae-knob {
  position: absolute;
  top: 3px;
  left: 3px;
  width: 24px;
  height: 24px;
  padding: 0;
  border-radius: 4px;
  transition: left 0.18s cubic-bezier(0.3, 1.3, 0.5, 1);
}
.ae-knob.on {
  left: 25px;
}

.ae-dock {
  flex: 0 0 auto;
  padding: 12px 16px max(28px, env(safe-area-inset-bottom));
  display: flex;
  gap: 8px;
  background: var(--v5-canvas);
}
.ae-del {
  position: relative;
  flex: 0 0 88px;
  padding: 0;
  overflow: hidden;
}
.ae-del-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  transform: scaleX(0);
  transform-origin: left;
  background: rgba(217, 72, 59, 0.14);
}
.ae-del-on .ae-del-fill {
  transform: scaleX(1);
  transition: transform 700ms linear;
}
.ae-del-t {
  position: relative;
  color: var(--v5-err-text);
}
.ae-save {
  flex: 1;
}
