/* 课程目录（v5「字重」稿 C6） */
page {
  background: var(--v5-canvas);
  color: var(--v5-ink);
}
.ct {
  padding-bottom: max(24px, env(safe-area-inset-bottom));
}

/* 主图：方形（padding-top 百分比法，避 aspect-ratio 旧 WebView 不支持）+ 上下渐隐到底色 */
.ct-hero {
  position: relative;
  padding-top: 100%;
  overflow: hidden;
  background: var(--v5-sunk);
}
.ct-hero-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.ct-fade-top,
.ct-fade-bot {
  position: absolute;
  left: 0;
  right: 0;
  pointer-events: none;
}
.ct-fade-top {
  top: 0;
  height: 12%;
  background: linear-gradient(to top, rgba(250, 250, 248, 0), #fafaf8);
}
.ct-fade-bot {
  bottom: 0;
  height: 16%;
  background: linear-gradient(to bottom, rgba(250, 250, 248, 0), #fafaf8 88%);
}

/* 课时分段进度：高 4、间隔 2、直角 */
.ct-segs {
  padding: 4px 16px 0;
  display: flex;
  gap: 2px;
}
.ct-seg {
  flex: 1;
  height: 4px;
  background: #e0e1d9;
}
.ct-seg-done {
  background: var(--v5-ink);
}
.ct-seg-current {
  background: var(--v5-violet);
}

.ct-cta-wrap {
  padding: 12px 16px 0;
}

/* 目录 */
.ct-toc {
  padding: 4px 16px 0;
}
.ct-ch {
  padding: 24px 0 8px;
  display: flex;
  align-items: baseline;
  gap: 8px;
  font-size: 17px;
  font-weight: 500;
}
.ct-ch-no {
  color: var(--v5-ink-3);
}
.ct-ch-no.cur {
  color: var(--v5-violet-text);
}
.ct-lesson {
  height: 44px;
  display: flex;
  align-items: center;
  gap: 12px;
  border-top: 1px solid var(--v5-hair);
}
.ct-no {
  min-width: 22px;
  font-size: 13px;
  font-weight: 500;
  letter-spacing: -0.02em;
  color: var(--v5-ink-3);
}
/* 节点位宽取 nodeCur（7 格×2px），node/ring 居中对齐 */
.ct-node {
  width: 14px;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ct-name {
  flex: 1;
  min-width: 0;
  font-size: 17px;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ct-dur {
  font-size: 13px;
  font-weight: 500;
  letter-spacing: -0.02em;
  color: var(--v5-ink-3);
}
.ct-lesson.done .ct-no,
.ct-lesson.done .ct-dur {
  color: var(--v5-ink-2);
}
.ct-lesson.done .ct-name {
  color: var(--v5-ink-2);
}
.ct-lesson.current .ct-no {
  color: var(--v5-violet-text);
}
.ct-lesson.current .ct-name {
  font-weight: 700;
}
.ct-toc-end {
  border-top: 1px solid var(--v5-hair);
}

/* 加载中骨架 */
.ct-skel {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.ct-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 2px 0 4px;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.ct-skel-bar {
  height: 12px;
  background: var(--v5-sunk);
}
.ct-skel-segs {
  height: 4px;
  background: repeating-linear-gradient(90deg, #e0e1d9 0 12px, transparent 12px 14px);
}
.ct-skel-key {
  height: 44px;
  border-radius: 6px;
  background: var(--v5-sunk);
}

/* 失败 / 不存在 */
.ct-state {
  padding: 88px 16px 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  text-align: center;
}
.ct-state-t {
  font-size: 17px;
  font-weight: 500;
}
.ct-state-h {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.ct-retry {
  margin-top: 8px;
  width: 120px;
}
.ct-go {
  margin-top: 8px;
}
