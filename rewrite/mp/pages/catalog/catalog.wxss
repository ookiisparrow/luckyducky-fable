/* 课程目录（v6 Lite 稿 C6） */
.ct {
  padding-bottom: max(24px, env(safe-area-inset-bottom));
}

/* 主图：方形（padding-top 百分比法，避 aspect-ratio 旧 WebView 不支持）+ 上下渐隐到底色 */
.ct-hero {
  position: relative;
  padding-top: 100%;
  overflow: hidden;
  background: var(--v5-sunk);
}
.ct-hero-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.ct-fade-top,
.ct-fade-bot {
  position: absolute;
  left: 0;
  right: 0;
  pointer-events: none;
}
.ct-fade-top {
  top: 0;
  height: 12%;
  background: linear-gradient(to top, rgba(250, 250, 248, 0), var(--v5-canvas));
}
.ct-fade-bot {
  bottom: 0;
  height: 16%;
  background: linear-gradient(to bottom, rgba(250, 250, 248, 0), var(--v5-canvas) 88%);
}

.ct-cta-wrap {
  padding: 12px 24px 0;
}

/* 目录：章行可点（展开 / 收起），课时行 = 方块播放图标 + 课时名 + 逐段细条 */
.ct-toc {
  padding: 4px 24px 0;
}
.ct-ch {
  min-height: 44px;
  margin-top: 12px;
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 20px;
  font-weight: 700;
}
.ct-ch-title {
  flex: 1;
  min-width: 0;
  font-weight: 600; /* 后台来的文本走黑体（UI 审查 6 问 3a） */
}
.ct-ch-no {
  color: var(--v5-ink-2);
}
.ct-ch-no.cur {
  color: var(--v5-violet-text);
}
/* chev 原朝右：收起转朝下、展开转朝上 */
.ct-chev {
  display: flex;
  transform: rotate(90deg);
}
.ct-chev.open {
  transform: rotate(-90deg);
}
.ct-lesson {
  padding: 10px 0;
  display: flex;
  align-items: center;
  gap: 16px;
}
.ct-tile {
  width: 40px;
  height: 40px;
  flex: 0 0 auto;
  box-sizing: border-box;
  padding-left: 2px; /* 播放三角视觉居中 */
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--v5-track);
}
.ct-lesson.done .ct-tile {
  background: var(--v5-key);
}
.ct-lesson.current .ct-tile {
  background: var(--v5-violet);
}
.ct-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.ct-name {
  font-size: 17px;
  font-weight: 400;
  color: var(--v5-ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ct-lesson.done .ct-name {
  color: var(--v5-ink);
}
.ct-lesson.current .ct-name {
  color: var(--v5-ink);
  font-weight: 600;
}
/* 逐段细条：高 2、间隔 2、直角，最宽 96 */
.ct-segs {
  max-width: 96px;
  display: flex;
  gap: 2px;
}
.ct-seg {
  flex: 1;
  height: 2px;
  background: rgba(17, 17, 17, 0.08);
}
.ct-seg.done {
  background: rgba(17, 17, 17, 0.36);
}
.ct-seg.current {
  background: rgba(138, 90, 224, 0.6);
}

/* 加载中骨架 */
.ct-skel {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.ct-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 2px 0 4px;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.ct-skel-bar {
  height: 12px;
}
.ct-skel-segs {
  height: 4px;
  background: repeating-linear-gradient(90deg, var(--v5-track) 0 12px, transparent 12px 14px);
}
.ct-skel-key {
  height: 44px;
  border-radius: 6px;
}

/* 失败 / 不存在 */
.ct-state {
  padding: 88px 16px 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  text-align: center;
}
.ct-state-t {
  font-size: 17px;
  font-weight: 500;
}
.ct-retry {
  margin-top: 8px;
  width: 120px;
}
.ct-go {
  margin-top: 8px;
}
