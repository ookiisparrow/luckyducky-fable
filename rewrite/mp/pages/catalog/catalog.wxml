<!-- 课程目录（v5「字重」稿 C6·含「课程 · 主图」）：方形产品主图 + 课时像素分段进度 + 墨黑「开始/继续」键 +
     大章节 > 小课时两层目录（段落层级只活在播放页 segstrip）。主图复用激活背景回退链（CMS heroImage 优先），取不到落凹槽灰。 -->
<v5-nav />

<view class="ct">
  <!-- 失败态：目录拉取网络失败（根因#14·守卫 rw-mp-list-loadfailed-state）——与「课程不存在」分治，给重试 -->
  <view class="ct-state" wx:if="{{state === 'failed'}}">
    <px-anim name="signal" size="4" />
    <text class="ct-state-t">网络开小差</text>
    <text class="t-sys ct-state-h">目录没加载出来，请重试</text>
    <view class="k k-light ct-retry" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onRetryLoad" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">重试</view>
  </view>

  <!-- 课程不存在（courseId 缺失或云端查无此课）：给出路，扫码进来的用户到此不能没路走 -->
  <view class="ct-state" wx:elif="{{state === 'missing'}}">
    <text class="ct-state-t">没找到这门课</text>
    <text class="t-sys ct-state-h">可能课程已下架，或者这个链接不对</text>
    <view class="k k-light ct-go" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onGoCourses" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">去我的课程看看</view>
  </view>

  <!-- 骨架（加载中，不写死假章节） -->
  <view wx:elif="{{state === 'loading'}}">
    <view class="ct-hero"></view>
    <view class="ct-skel">
      <view class="t-sys ct-loading"><px-anim name="loader" size="2" /><text>加载中</text></view>
      <view class="ct-skel-bar" style="width: 50%"></view>
      <view class="ct-skel-segs"></view>
      <view class="ct-skel-key"></view>
      <view class="ct-skel-bar" style="width: 72%"></view>
      <view class="ct-skel-bar" style="width: 64%"></view>
      <view class="ct-skel-bar" style="width: 40%"></view>
    </view>
  </view>

  <block wx:else>
    <view class="ct-hero">
      <image wx:if="{{bg}}" class="ct-hero-img" src="{{bg}}" mode="aspectFill" />
      <view class="ct-fade-top"></view>
      <view class="ct-fade-bot"></view>
    </view>

    <!-- 课时像素分段进度：学完墨色 / 当前紫 / 未到凹槽灰（一课时一格·直角） -->
    <view class="ct-segs">
      <block wx:for="{{chapters}}" wx:key="title" wx:for-item="ch">
        <view wx:for="{{ch.lessons}}" wx:key="lessonId" wx:for-item="sg" class="ct-seg ct-seg-{{sg.status}}"></view>
      </block>
    </view>

    <!-- 「开始学习」：continueTarget 为空（全课无可播段）换平面键，点按诚实提示，不留死跳转 -->
    <view class="ct-cta-wrap">
      <view class="k ct-start {{continueTarget ? 'k-ink' : 'k-flat k-off'}}" hover-start-time="20" hover-class="{{continueTarget ? 'k-ink-down' : 'k-flat-down'}}" hover-stay-time="100" bind:tap="onStart" data-k="{{continueTarget ? 'ink' : 'flat'}}" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">
        <px-i name="play" />
        <text>{{resumeCta}}</text>
      </view>
    </view>

    <view class="ct-toc">
      <block wx:for="{{chapters}}" wx:key="title" wx:for-item="ch" wx:for-index="ci">
        <view class="ct-ch">
          <text class="ct-ch-no {{ch.cur ? 'cur' : ''}}">{{ci + 1}}</text>
          <text class="ct-ch-title">{{ch.title}}</text>
        </view>
        <view
          class="ct-lesson {{lesson.status}}"
          wx:for="{{ch.lessons}}"
          wx:key="lessonId"
          wx:for-item="lesson"
          data-seg="{{lesson.firstPlayableSegId}}"
          bind:tap="onTapLesson"
          hover-start-time="20" hover-class="k-row-down"
        >
          <text class="mono ct-no">{{lesson.no}}</text>
          <view class="ct-node">
            <px-i wx:if="{{lesson.status === 'current'}}" name="nodeCur" tone="var(--v5-violet)" />
            <px-i wx:elif="{{lesson.status === 'done'}}" name="node" tone="var(--v5-ink)" />
            <px-i wx:else name="ring" tone="var(--v5-ink-4)" />
          </view>
          <text class="ct-name">{{lesson.name}}</text>
          <text class="mono ct-dur" wx:if="{{lesson.minutes}}">{{lesson.minutes}} 分钟</text>
        </view>
      </block>
      <view class="ct-toc-end"></view>
    </view>
  </block>
</view>

<!-- v5 全屏像素特效层（撒花/转场·lib/pxFx）：页面根下、不进滚动容器 -->
<px-fx id="fx" />
