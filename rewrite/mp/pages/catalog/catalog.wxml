<!-- 课程目录（v6 Lite 稿 C6·2026-10-13）：方形产品主图 + 通栏墨黑「继续学习」键 + 可折叠的章 > 课时两层目录
     （课时＝方块播放图标 + 课时名 + 逐段细条）。主图复用激活背景回退链（CMS heroImage 优先），取不到落凹槽灰。 -->
<v5-nav />

<view class="ct">
  <!-- 失败态：目录拉取网络失败（根因#14·守卫 rw-mp-list-loadfailed-state）——与「课程不存在」分治，给重试 -->
  <view class="ct-state" wx:if="{{state === 'failed'}}">
    <px-anim name="signal" size="4" />
    <text class="ct-state-t">网络开小差</text>
    <text class="t-sys ct-state-h t-cap">目录没加载出来，请重试</text>
    <view class="k k-light ct-retry" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onRetryLoad" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">重试</view>
  </view>

  <!-- 课程不存在（courseId 缺失或云端查无此课）：给出路，扫码进来的用户到此不能没路走 -->
  <view class="ct-state" wx:elif="{{state === 'missing'}}">
    <text class="ct-state-t">没找到这门课</text>
    <text class="t-sys ct-state-h t-cap">可能课程已下架，或者这个链接不对</text>
    <view class="k k-light ct-go" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onGoCourses" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">去我的课程看看</view>
  </view>

  <!-- 骨架（加载中，不写死假章节） -->
  <view wx:elif="{{state === 'loading'}}">
    <view class="ct-hero"></view>
    <view class="ct-skel">
      <view class="t-sys ct-loading"><px-anim name="loader" size="2" /><text>加载中</text></view>
      <view class="ct-skel-bar skel" style="width: 50%"></view>
      <view class="ct-skel-segs"></view>
      <view class="ct-skel-key skel"></view>
      <view class="ct-skel-bar skel" style="width: 72%"></view>
      <view class="ct-skel-bar skel" style="width: 64%"></view>
      <view class="ct-skel-bar skel" style="width: 40%"></view>
    </view>
  </view>

  <block wx:else>
    <view class="ct-hero">
      <image wx:if="{{bg}}" class="ct-hero-img" src="{{bg}}" mode="aspectFill" />
      <view class="ct-fade-top"></view>
      <view class="ct-fade-bot"></view>
    </view>

    <!-- 「继续学习」通栏墨黑键：播放图标 + 续学位置（决策 §42 老板定保留文案；v6 Lite 稿是纯图标，待拍板）。
         continueTarget 为空（全课无可播段）换平面键，点按诚实提示，不留死跳转 -->
    <view class="ct-cta-wrap">
      <view class="k k-48 ct-start {{continueTarget ? 'k-ink' : 'k-flat k-off'}}" hover-start-time="20" hover-class="{{continueTarget ? 'k-ink-down' : 'k-flat-down'}}" hover-stay-time="100" bind:tap="onStart" data-k="{{continueTarget ? 'ink' : 'flat'}}" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">
        <px-i name="play" />
        <text>{{resumeLabel || resumeCta}}</text>
      </view>
    </view>

    <!-- 目录：点章名展开 / 收起（默认只展开当前课时所在章）；课时方块 学完墨 / 当前紫 / 未学灰，细条一段一格 -->
    <view class="ct-toc">
      <block wx:for="{{chapters}}" wx:key="title" wx:for-item="ch" wx:for-index="ci">
        <view class="ct-ch" data-i="{{ci}}" bind:tap="onToggleChapter">
          <text class="ct-ch-no {{ch.cur ? 'cur' : ''}}">{{ci + 1}}.</text>
          <text class="t-sys ct-ch-title">{{ch.title}}</text>
          <view class="ct-chev {{ch.open ? 'open' : ''}}"><px-i name="chev" tone="var(--v5-ink-2)" /></view>
        </view>
        <block wx:if="{{ch.open}}">
          <view
            class="ct-lesson {{lesson.status}}"
            wx:for="{{ch.lessons}}"
            wx:key="lessonId"
            wx:for-item="lesson"
            data-seg="{{lesson.firstPlayableSegId}}"
            bind:tap="onTapLesson"
            hover-start-time="20" hover-class="k-row-down"
          >
            <view class="ct-tile px-clip-6"><px-i name="play" tone="{{lesson.status === 'todo' ? 'var(--v5-ink-2)' : 'var(--v5-key-hi)'}}" /></view>
            <view class="ct-body">
              <text class="t-sys ct-name">{{lesson.name}}</text>
              <view class="ct-segs"><view wx:for="{{lesson.segs}}" wx:key="index" wx:for-item="sg" class="ct-seg {{sg}}"></view></view>
            </view>
          </view>
        </block>
      </block>
    </view>
  </block>
</view>

<!-- v5 全屏像素特效层（撒花/转场·lib/pxFx）：页面根下、不进滚动容器 -->
<px-fx id="fx" />
