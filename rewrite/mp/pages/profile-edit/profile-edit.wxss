/* 编辑资料（v5「字重」稿 D3 + 放弃编辑确认） */
page {
  background: var(--v5-canvas);
  color: var(--v5-ink);
}
/* 自绘顶栏（同 components/v5-nav 版式） */
.pe-nav-space {
  flex: 0 0 auto;
}
.pe-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 20;
  height: 44px;
  padding-left: 10px;
  padding-right: 104px;
  display: flex;
  align-items: center;
  gap: 4px;
  background: var(--v5-canvas);
  box-sizing: content-box;
}
.pe-hit {
  width: 44px;
  height: 44px;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pe-back {
  width: 32px;
  height: 30px;
  padding: 0;
}
.pe-nav-t {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}

/* 头像：84 方块 + 右下角「换」小键；整块是 chooseAvatar 能力按钮（去掉 button 默认样式） */
.pe-av-wrap {
  padding: 8px 16px 0;
  display: flex;
  justify-content: center;
}
.pe-av-btn {
  position: relative;
  width: 84px;
  height: 84px;
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: normal;
  overflow: visible;
}
.pe-av-btn::after {
  border: none;
}
.pe-av {
  width: 84px;
  height: 84px;
  border-radius: 8px;
  overflow: hidden;
  background: var(--v5-sunk);
}
.pe-av-img {
  width: 100%;
  height: 100%;
  display: block;
}
.pe-av-k {
  position: absolute;
  right: -6px;
  bottom: -6px;
  width: 28px;
  height: 28px;
  padding: 0;
  font-size: 13px;
  font-weight: 500; /* 圆体不出细体字重（只 500/700/900·字体瘦身） */
}

.pe-form {
  padding: 24px 16px 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.pe-field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.pe-label {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.pe-input {
  width: 100%;
  height: 44px;
  padding: 0 16px;
  font-size: 17px;
  font-weight: 500;
  color: var(--v5-ink);
}
.pe-ph {
  color: var(--v5-ink-4);
}
.pe-skel {
  height: 44px;
  border-radius: 6px;
}
.pe-fail {
  padding: 48px 16px 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}
.pe-fail-t {
  font-size: 17px;
  font-weight: 500;
  color: var(--v5-ink-2);
}

.pe-dock-space {
  height: calc(72px + max(28px, env(safe-area-inset-bottom)));
}
.pe-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12px 16px max(28px, env(safe-area-inset-bottom));
  display: flex;
  gap: 8px;
  background: var(--v5-canvas);
}
.pe-save {
  flex: 1;
}

/* 放弃编辑确认半屏 */
.pe-sheet {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 140;
}
.pe-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17, 17, 17, 0.42);
  animation: pe-fade 180ms ease-out;
}
.pe-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 12px 12px 0 0;
  background: var(--v5-canvas);
  padding: 12px 16px max(28px, env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16px;
  animation: pe-up 220ms cubic-bezier(0.2, 0.9, 0.3, 1);
}
.pe-grip {
  align-self: center;
  width: 36px;
  height: 4px;
  border-radius: 2px;
  background: rgba(17, 17, 17, 0.2);
}
.pe-sheet-t {
  padding-top: 4px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.pe-sheet-h {
  font-size: 20px;
  font-weight: 700;
}
.pe-sheet-sub {
  font-size: 17px;
  font-weight: 500;
  line-height: 1.5;
  color: var(--v5-ink-2);
}
.pe-sheet-ks {
  padding-top: 8px;
  display: flex;
  gap: 8px;
}
.pe-leave {
  flex: 1;
  color: var(--v5-err-text);
}
.pe-stay {
  flex: 1.6;
}
@keyframes pe-fade {
  from {
    opacity: 0;
  }
}
@keyframes pe-up {
  from {
    transform: translateY(100%);
  }
}

/* 账号操作：按住确认，填充从左往右走满 */
.pe-acct {
  padding: 28px 16px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}
.pe-acct-k {
  position: relative;
  overflow: hidden;
}
.pe-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  transform: scaleX(0);
  transform-origin: left;
}
.pe-fill-out {
  background: rgba(17, 17, 17, 0.08);
}
.pe-fill-del {
  background: rgba(217, 72, 59, 0.14);
}
.pe-hold-on .pe-fill-out {
  transform: scaleX(1);
  transition: transform 600ms linear;
}
.pe-hold-on .pe-fill-del {
  transform: scaleX(1);
  transition: transform 900ms linear;
}
.pe-acct-t {
  position: relative;
}
.pe-danger {
  color: var(--v5-err-text);
}
