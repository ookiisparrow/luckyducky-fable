/* 编辑资料（v5「字重」稿 D3 + 放弃编辑确认） */
page {
  background: var(--v5-canvas);
  color: var(--v5-ink);
}
/* 整页一列：顶栏 + 滚动内容 + 底坞（同 checkout·放弃确认武装时页面级滚动被冻，只让中间 scroll-view 滚） */
.pe-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.pe-scroll {
  flex: 1;
  height: 0;
}

/* 头像：84 方块 + 右下角「换」小键；整块是 chooseAvatar 能力按钮（去掉 button 默认样式） */
.pe-av-wrap {
  padding: 8px 16px 0;
  display: flex;
  justify-content: center;
}
.pe-av-btn {
  position: relative;
  width: 84px;
  height: 84px;
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: normal;
  overflow: visible;
}
.pe-av-btn::after {
  border: none;
}
.pe-av {
  width: 84px;
  height: 84px;
  border-radius: 8px;
  overflow: hidden;
  background: var(--v5-sunk);
}
.pe-av-img {
  width: 100%;
  height: 100%;
  display: block;
}
.pe-av-k {
  position: absolute;
  right: -6px;
  bottom: -6px;
  width: 28px;
  height: 28px;
  padding: 0;
  font-size: 13px;
  font-weight: 500; /* 圆体不出细体字重（只 500/700/900·字体瘦身） */
}
/* 按住头像：「换」键下沉（同 app.wxss .k-sm.k-light-down） */
.pe-av-down .pe-av-k {
  transform: translateY(1px);
  background: var(--v5-press);
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.12), 0 0 0 1px var(--v5-hair);
  transition: transform 60ms ease-out, box-shadow 60ms ease-out, background-color 60ms ease-out;
}

.pe-form {
  padding: 24px 16px 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.pe-field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.pe-label {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.pe-input {
  width: 100%;
  height: 44px;
  padding: 0 16px;
  font-size: 17px;
  font-weight: 500;
  color: var(--v5-ink);
}
.pe-ph {
  color: var(--v5-ink-4);
}
.pe-skel {
  height: 44px;
  border-radius: 6px;
}
.pe-fail {
  padding: 48px 16px 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}
.pe-fail-t {
  font-size: 17px;
  font-weight: 500;
  color: var(--v5-ink-2);
}

.pe-dock {
  flex: 0 0 auto;
  padding: 12px 16px max(28px, env(safe-area-inset-bottom));
  display: flex;
  gap: 8px;
  background: var(--v5-canvas);
}
.pe-save {
  flex: 1;
}

/* 账号操作：按住确认，填充从左往右走满 */
.pe-acct {
  padding: 28px 16px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}
.pe-acct-k {
  position: relative;
  overflow: hidden;
}
.pe-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  transform: scaleX(0);
  transform-origin: left;
}
.pe-fill-del {
  background: var(--v5-err-soft);
}
.pe-hold-on .pe-fill-del {
  transform: scaleX(1);
  transition: transform 900ms linear;
}
.pe-acct-t {
  position: relative;
}
.pe-danger {
  color: var(--v5-err-text);
}
.pe-acct-note {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
