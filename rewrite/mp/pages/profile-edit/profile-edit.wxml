<!-- 编辑资料（v5「字重」稿 D3 + 「放弃编辑确认」半屏）：头像（能力按钮 open-type=chooseAvatar·隐私能力·privacy-sheet 保命）
     + 昵称（type=nickname）+ 手机号（账户联系电话·手动输入·云端 updateProfile 白名单归一化校验·与地址电话独立）；底部保存。
     顶栏自绘（同 v5-nav 版式）：返回键要先问「放弃修改？」。 -->
<view class="pe-nav-space" style="height: {{sb + 44}}px">
  <view class="pe-nav" style="padding-top: {{sb}}px">
    <view class="pe-hit" bind:tap="onBack">
      <view class="k k-light pe-back" hover-class="k-light-down" hover-stay-time="100"><px-i name="back" /></view>
    </view>
    <text class="pe-nav-t">编辑资料</text>
  </view>
</view>

<!-- 加载中：骨架占位，不画空白可编辑档（根因#14） -->
<view wx:if="{{loading}}" class="pe">
  <view class="pe-av-wrap"><view class="pe-av skel"></view></view>
  <view class="pe-form">
    <view class="pe-skel skel"></view>
    <view class="pe-skel skel"></view>
  </view>
</view>

<!-- 登录失败：给重试，不露出空白可改表单 -->
<block wx:elif="{{!loaded}}">
  <view class="pe pe-fail">
    <px-anim name="signal" size="2" />
    <text class="pe-fail-t">资料没加载好</text>
  </view>
  <view class="pe-dock-space"></view>
  <view class="pe-dock">
    <view class="k k-ink k-48 pe-save" hover-class="k-ink-down" hover-stay-time="100" bind:tap="onRetryLoad">重试</view>
  </view>
</block>

<block wx:else>
  <view class="pe">
    <view class="pe-av-wrap">
      <button class="pe-av-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar" hover-class="none">
        <view class="pe-av">
          <image wx:if="{{avatarTemp || avatar}}" class="pe-av-img" src="{{avatarTemp || avatar}}" mode="aspectFill" />
          <image wx:else class="pe-av-img" src="/static/hero-full.jpg" mode="aspectFill" />
        </view>
        <view class="k k-light pe-av-k">换</view>
      </button>
    </view>

    <view class="pe-form">
      <view class="pe-field">
        <text class="pe-label">昵称</text>
        <input class="well pe-input" type="nickname" value="{{nickname}}" bind:input="onNickname" maxlength="20"
          placeholder="起个名字" placeholder-class="pe-ph" />
      </view>
      <view class="pe-field">
        <text class="pe-label">手机号 · 选填</text>
        <input class="well pe-input" type="number" value="{{phone}}" bind:input="onPhone" maxlength="11"
          placeholder="便于联系与售后" placeholder-class="pe-ph" />
      </view>
    </view>
  </view>

  <view class="pe-dock-space"></view>
  <view class="pe-dock">
    <view wx:if="{{busy}}" class="k k-flat k-48 pe-save">保存</view>
    <view wx:else class="k k-ink k-48 pe-save" hover-class="k-ink-down" hover-stay-time="100" bind:tap="onSave">保存</view>
  </view>
</block>

<!-- 放弃编辑确认：有改动时点返回才出 -->
<view wx:if="{{leaveOpen}}" class="pe-sheet">
  <view class="pe-mask" bind:tap="onLeaveStay"></view>
  <view class="pe-panel">
    <view class="pe-grip"></view>
    <view class="pe-sheet-t">
      <text class="pe-sheet-h">放弃这次修改？</text>
      <text class="pe-sheet-sub t-sys">改过的内容不会保存。</text>
    </view>
    <view class="pe-sheet-ks">
      <view class="k k-light k-48 pe-leave" hover-class="k-light-down" hover-stay-time="100" bind:tap="onLeaveGo">放弃</view>
      <view class="k k-ink k-48 pe-stay" hover-class="k-ink-down" hover-stay-time="100" bind:tap="onLeaveStay">继续编辑</view>
    </view>
  </view>
</view>

<privacy-sheet />
