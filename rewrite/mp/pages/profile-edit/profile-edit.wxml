<!-- 编辑资料（v5「字重」稿 D3）：头像（能力按钮 open-type=chooseAvatar·隐私能力·privacy-sheet 保命）
     + 昵称（type=nickname）+ 手机号（账户联系电话·手动输入·云端 updateProfile 白名单归一化校验·与地址电话独立）；底部保存。
     有改动（dirty）时共用 <leave-sheet> 拦返回键/侧滑/安卓返回先问；拦截武装会冻页面级滚动，
     所以整页一列、中间 scroll-view 自己滚、底坞不动（同 checkout/feedback）。 -->
<view class="pe-page">
<v5-nav title="编辑资料" guard="{{true}}" bind:back="onBack" />

<scroll-view class="pe-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
<!-- 加载中：骨架占位，不画空白可编辑档（根因#14） -->
<view wx:if="{{loading}}" class="pe">
  <view class="pe-av-wrap"><view class="pe-av skel"></view></view>
  <view class="pe-form">
    <view class="pe-skel skel"></view>
    <view class="pe-skel skel"></view>
  </view>
</view>

<!-- 登录失败：给重试（底坞），不露出空白可改表单 -->
<view wx:elif="{{!loaded}}" class="pe pe-fail">
  <px-anim name="signal" size="2" />
  <text class="pe-fail-t">资料没加载好</text>
</view>

<view wx:else class="pe">
  <view class="pe-av-wrap">
    <!-- 按头像任意处「换」键都下沉（hover-class 挂在能力按钮上，.pe-av-down .pe-av-k 落到键帽） -->
    <button class="pe-av-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar" hover-start-time="20" hover-class="pe-av-down" hover-stay-time="100">
      <view class="pe-av">
        <image wx:if="{{avatarTemp || avatar}}" class="pe-av-img" src="{{avatarTemp || avatar}}" mode="aspectFill" />
        <image wx:else class="pe-av-img" src="/static/avatar-duck-22.svg" mode="aspectFill" />
      </view>
      <view class="k k-sm k-light pe-av-k">换</view>
    </button>
  </view>

  <view class="pe-form">
    <view class="pe-field">
      <text class="t-sys pe-label">昵称</text>
      <input class="well pe-input {{focus === 'nickname' ? 'well-focus' : ''}}" type="nickname" value="{{nickname}}" bind:input="onNickname" maxlength="20"
        data-f="nickname" bind:focus="onFocus" bind:blur="onBlur" placeholder="起个名字" placeholder-class="pe-ph" />
    </view>
    <view class="pe-field">
      <text class="t-sys pe-label">手机号 · 选填</text>
      <input class="well pe-input {{focus === 'phone' ? 'well-focus' : ''}}" type="number" value="{{phone}}" bind:input="onPhone" maxlength="11"
        data-f="phone" bind:focus="onFocus" bind:blur="onBlur" placeholder="便于联系与售后" placeholder-class="pe-ph" />
    </view>
  </view>

  <!-- 账号操作（老板 2026-09-30·§39）：按住 0.6s 退出登录（墨色填充）。只退本机，同一微信再登资料、课程、进度都回来。
       删除个人资料在隐私政策正文末尾。 -->
  <view class="pe-acct">
    <view class="k k-light pe-acct-k {{holdOut ? 'pe-hold-on' : ''}}" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100"
      catch:touchstart="onLogoutStart" bind:touchmove="onLogoutMove" catch:touchend="onLogoutEnd" catch:touchcancel="onLogoutCancel">
      <view class="pe-fill pe-fill-out"></view>
      <text class="pe-acct-t">退出登录</text>
    </view>
    <text class="t-sys pe-acct-note">退出后用同一个微信再登录，资料和课程都会回来</text>
  </view>
</view>
</scroll-view>

<view wx:if="{{!loading}}" class="pe-dock">
  <view wx:if="{{!loaded}}" class="k k-ink k-48 pe-save" hover-start-time="20" hover-class="k-ink-down" hover-stay-time="100" bind:tap="onRetryLoad" data-k="ink" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">重试</view>
  <view wx:elif="{{busy}}" class="k k-flat k-off k-48 pe-save">保存中</view>
  <view wx:else class="k k-ink k-48 pe-save" hover-start-time="20" hover-class="k-ink-down" hover-stay-time="100" bind:tap="onSave" data-k="ink" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i name="check" /></view>
</view>
</view>

<leave-sheet id="leave" dirty="{{dirty}}" title="放弃修改资料？" sub="这次的改动不会保存。" />
<privacy-sheet />
<px-fx id="fx" />
