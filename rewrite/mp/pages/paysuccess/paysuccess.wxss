/* 支付成功（v5「字重」稿 A8） */
page {
  background: var(--v5-canvas);
  color: var(--v5-ink);
}
/* 金币：落在与小货车同一条地面线（顶栏下 120px）——结算页开走的车与这枚金币接得上 */
.ps-coin {
  padding: 0 16px 12px;
}
.ps-body {
  padding: 4px 16px 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.ps-title-row {
  display: flex;
  align-items: center;
  gap: 8px;
}
.ps-title {
  font-size: 30px;
  font-weight: 900;
  letter-spacing: -0.01em;
}
.ps-paid {
  display: flex;
  align-items: baseline;
  gap: 8px;
}
.ps-amount {
  font-size: 22px;
  font-weight: 600;
}
.ps-no {
  font-size: 13px;
  color: var(--v5-ink-2);
}
.ps-home {
  flex: 1;
}
.ps-order {
  flex: 1.6;
}
