/* 我的订单（v5「字重」稿 B1 / E2 / E3） */
page {
  background: var(--v5-canvas);
  color: var(--v5-ink);
}
.ol {
  min-height: 100vh;
  box-sizing: border-box;
}
/* 凹槽分段筛选：选中＝浅色键，其余透明 */
.ol-tabs {
  margin: 0 16px;
  padding: 4px;
  border-radius: 8px;
  display: flex;
  gap: 2px;
}
.ol-tab {
  flex: 1;
  height: 36px;
  padding: 0;
  font-size: 13px;
  font-weight: 500; /* 圆体不出细体字重（只 500/700/900·字体瘦身） */
  color: var(--v5-ink-2);
}
.ol-tab-on {
  font-weight: 500;
  color: var(--v5-ink);
}
.ol-body {
  padding: 12px 16px 24px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
/* 切 tab 方向性滑入动画（switchTab 置 anim-next/anim-prev·播一次）：轻量 CSS keyframe，
   不上 <swiper> 跟手（那要拆五份独立 tab 状态·与游标分页/_seq 冲突·防过度工程同 lib/orderSwipe 头注）。 */
.ol-body.anim-next {
  animation: olSlideNext 0.24s ease-out;
}
.ol-body.anim-prev {
  animation: olSlidePrev 0.24s ease-out;
}
@keyframes olSlideNext {
  from {
    opacity: 0.35;
    transform: translateX(24px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}
@keyframes olSlidePrev {
  from {
    opacity: 0.35;
    transform: translateX(-24px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* 订单卡 */
.ol-card {
  padding: 16px;
  border-radius: 8px;
  background: var(--v5-surface);
  box-shadow: 0 0 0 1px var(--v5-hair);
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.ol-head {
  display: flex;
  align-items: center;
  gap: 8px;
}
.ol-truck {
  margin: -4px 0;
}
.ol-status {
  flex: 1;
  font-size: 17px;
  font-weight: 500;
}
.ol-time {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
/* 待支付倒计时（设计稿：等宽 600 15px 琥珀 + 13/300「后自动取消」·与详情同口径） */
.ol-cd {
  display: flex;
  align-items: baseline;
  gap: 4px;
}
.ol-cd-n {
  font-size: 15px;
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--v5-warn-text);
}
.ol-row {
  display: flex;
  align-items: center;
  gap: 12px;
}
.ol-thumbs {
  flex: 1;
  display: flex;
  gap: 8px;
}
.ol-thumb {
  width: 44px;
  height: 44px;
  flex: 0 0 auto;
  border-radius: 4px;
  overflow: hidden;
  background: repeating-linear-gradient(135deg, var(--v5-sunk) 0 5px, var(--v5-sunk-2) 5px 10px);
}
.ol-thumb-img {
  display: block;
  width: 100%;
  height: 100%;
}
.ol-amt {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
}
.ol-total {
  font-size: 17px;
  font-weight: 600;
}
.ol-amt-t {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.ol-acts {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
}
.ol-act {
  position: relative;
  height: 32px;
  padding: 0 12px;
}
/* 热区补到 44 高（上下各让 6px·看不见，视觉仍 32 高）；取消键 overflow:hidden 裁掉伪元素，改由外层 .ol-hold 让位 */
/* 已评价（拍板 6·设计稿灰底标签 32 高·不可点，不是键） */
.ol-reviewed {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  border-radius: 6px;
  font-size: 17px;
  font-weight: 500;
  background: var(--v5-sunk);
  color: var(--v5-ink-2);
}
.ol-hold {
  padding: 6px 0;
  margin: -6px 0;
}
.ol-danger {
  position: relative;
  overflow: hidden;
  color: var(--v5-err-text);
}
/* 按住取消：浅红从左往右填满（HOLD_MS 700ms·同购物车按住删除写法） */
.ol-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  transform: scaleX(0);
  transform-origin: left;
  background: var(--v5-err-soft);
}
.ol-hold-on .ol-fill {
  transform: scaleX(1);
  transition: transform 700ms linear;
}
.ol-act-t {
  position: relative;
}
.ol-act-busy {
  opacity: 0.6;
}

/* 加载 / 失败 / 空 */
.ol-loading {
  padding: 2px 0 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.ol-skel-bar {
  height: 12px;
}
.ol-skel-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.ol-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}
.ol-signal {
  padding-top: 88px;
  display: flex;
}
.ol-empty {
  padding-top: 88px;
}
.ol-state-t {
  font-size: 17px;
  font-weight: 500;
}
.ol-state-h {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.ol-retry {
  margin-top: 8px;
  min-width: 120px;
}
.ol-more {
  padding: 8px 0;
  text-align: center;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
