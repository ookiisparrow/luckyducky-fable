/* 课程播放页（v6 Lite 稿 C7）：暗底 #121212，暗色键 .k-dk，主键反相 .k-inv（全局 app.wxss）。
   整页纵向 flex：顶栏 → 弹性视频舞台（上沿压分段条 + 课时胶囊，下沿压 seek 条）→ 底栏三键。求助面板与加桌引导是浅色 sheet（同设计稿 help/leave sheet）。
   seek 条节点（.lp-seek-fill/.lp-seek-handle/.lp-seek-preview）的 width/left/显隐由 seek.wxs 写，这里只给静态外观。 */
/* 本页 page 底也用暗底、根容器 fixed 四边贴齐窗口：暗底页任何缝都不露浅色全局底。
   注：老板安卓真机两侧 / 底边露白不是这层——只在推开发版后第一次自动打开时出现：微信把窗口高算成含
   手势条的整屏（805，正常 792），页面被等比缩进显示区；刷新即好、正常打开不出现（#487·运维手册） */
page {
  background: var(--v5-dark);
}
.ld-player {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: var(--v5-dark);
  color: var(--v5-dark-ink);
}

/* —— 顶栏：只有返回键；右侧 104px 留给原生胶囊 —— */
.lp-topbar {
  flex: 0 0 auto;
}
.lp-bar {
  height: 44px;
  padding: 0 104px 0 10px;
  display: flex;
  align-items: center;
  gap: 4px;
}
.lp-back {
  width: 44px;
  height: 44px;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 按下态挂在 44 热区上（同 v5-nav .nv-hit-down·暗键版） */
.lp-back-down .lp-back-key {
  transform: translateY(1px);
  background: var(--v5-dark-3);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04), inset 0 -1px 0 rgba(0, 0, 0, 1), 0 0 0 1px rgba(255, 255, 255, 0.06);
}
.lp-back-key {
  width: 32px;
  height: 30px;
  padding: 0;
}
/* —— 视频舞台 —— */
.lp-stage {
  position: relative;
  flex: 1;
  min-height: 180px;
  margin: 0 8px;
  border-radius: 8px;
  overflow: hidden;
  background: repeating-linear-gradient(135deg, var(--v5-dark-2) 0 8px, var(--v5-dark-3) 8px 16px);
}
.lp-video {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.lp-skeleton {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
}
.lp-skeleton-text {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-4);
}
.lp-tapzone {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
}
.lp-tap-hint {
  position: absolute;
  left: 50%;
  top: 96px; /* 让开顶部分段条与课时胶囊 */
  transform: translateX(-50%);
  padding: 8px 12px;
  background: rgba(0, 0, 0, 0.45);
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-dark-ink);
  white-space: nowrap;
  pointer-events: none;
}
.lp-pause-badge {
  width: 56px;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 4px;
  box-sizing: border-box;
}
.lp-buffering {
  position: absolute;
  left: 50%;
  bottom: 56px; /* 让开底部 seek 条 */
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  background: rgba(0, 0, 0, 0.45);
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-dark-ink);
  white-space: nowrap;
}

/* 段末：画面底部一条反相「重播本段」（外观取 .k-inv，这里只给位置与尺寸） */
.lp-replay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 非播放态（空/未激活/找不到/失败）：同尺寸暗框 + 标题 + 说明 + 键 */
.lp-state {
  padding: 0 32px;
  background: var(--v5-dark-2);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  text-align: center;
}
.lp-state-title {
  font-size: 17px;
  font-weight: 500;
  color: var(--v5-dark-ink);
}
.lp-state-hint {
  font-size: 13px;
  font-weight: 300;
  line-height: 1.5;
  color: var(--v5-ink-4);
}
.lp-state-key {
  margin-top: 8px;
}
.lp-state-keys {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
}

/* —— 画面底部：段内 seek 条 + 剩余时长（容器不接点按，只有 seek 条接；段末 visibility 隐藏、不卸载） —— */
.lp-foot {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  padding: 24px 12px 8px;
  display: flex;
  align-items: center;
  gap: 12px;
  background: linear-gradient(rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.4));
  pointer-events: none;
}
.lp-foot.is-off {
  visibility: hidden;
}
.lp-seek {
  position: relative;
  flex: 1;
  height: 32px;
  display: flex;
  align-items: center;
  pointer-events: auto;
}
.lp-seek-track,
.lp-seek-buffer,
.lp-seek-fill {
  position: absolute;
  left: 0;
  top: 14px;
  height: 4px;
}
.lp-seek-track {
  right: 0;
  background: rgba(255, 255, 255, 0.24);
}
/* 缓冲水位：介于轨道与紫填充之间的灰（DOM 序 track→buffer→fill） */
.lp-seek-buffer {
  background: var(--v5-dark-buffer);
}
.lp-seek-fill {
  background: var(--v5-violet);
}
/* 关键动作节点：4px 黄方格（注意色·节点位置提示） */
.lp-seek-node {
  position: absolute;
  top: 14px;
  width: 4px;
  height: 4px;
  margin-left: -2px;
  background: var(--v5-warn);
}
.lp-seek-handle {
  position: absolute;
  top: 10px;
  width: 12px;
  height: 12px;
  margin-left: -6px;
  background: var(--v5-dark-ink);
}
.lp-seek-handle.big {
  top: 8px;
  width: 16px;
  height: 16px;
  margin-left: -8px;
}
/* 拖动浮层（常驻 DOM·默认隐藏·left 与 .on 由 seek.wxs 控制） */
.lp-seek-preview {
  position: absolute;
  bottom: 100%;
  margin-bottom: 8px;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  pointer-events: none;
  opacity: 0;
  visibility: hidden;
}
.lp-seek-preview.on {
  opacity: 1;
  visibility: visible;
}
.lp-seek-preview-time {
  padding: 6px 12px;
  background: var(--v5-dark-key);
  font-size: 15px;
  color: var(--v5-dark-ink);
  white-space: nowrap;
}
.lp-seek-preview-bubble {
  padding: 6px 12px;
  background: var(--v5-warn);
  color: var(--v5-ink);
  font-size: 13px;
  font-weight: 500;
  white-space: nowrap;
}

/* 剩余时长：定宽（量轨只量一次，文字变宽会挤短 seek 条） */
.lp-remain {
  flex: 0 0 auto;
  width: 48px;
  text-align: right;
  font-size: 13px;
  font-weight: 500;
  letter-spacing: -0.02em;
  color: var(--v5-dark-ink);
}

/* —— 视频顶部浮层：本课时分段条 + 课时胶囊（top 由 wxml 按状态栏给·不接点按） —— */
.lp-top {
  position: absolute;
  left: 8px;
  right: 8px;
  z-index: 4;
  padding: 12px 8px 16px 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  background: linear-gradient(rgba(0, 0, 0, 0.32), rgba(0, 0, 0, 0));
  pointer-events: none;
}
.lp-cells {
  display: flex;
  gap: 2px;
  padding-right: 4px;
}
.lp-cell {
  position: relative;
  flex: 1;
  height: 4px;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.16);
}
.lp-cell.done {
  background: var(--v5-dark-ink);
}
.lp-cell-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  background: var(--v5-violet);
}
.lp-chip {
  align-self: flex-start;
  max-width: 100%;
  box-sizing: border-box;
  padding: 6px 10px;
  display: flex;
  align-items: baseline;
  gap: 8px;
  background: rgba(0, 0, 0, 0.45);
}
.lp-chip-t {
  min-width: 0;
  font-size: 15px;
  font-weight: 500;
  color: var(--v5-dark-ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.lp-chip-n {
  flex: 0 0 auto;
  font-size: 13px;
  font-weight: 500;
  color: var(--v5-rule);
}

/* —— 底栏：上一段 / 求助 / 下一段 三颗 48 方键，两端对齐 —— */
.lp-controls {
  flex: 0 0 auto;
  padding: 12px 16px max(28px, env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-between;
  align-items: center;
}
/* 暗底不可用键：平面、无键座、弱字 */
.lp-key-off {
  background: var(--v5-dark-2);
  color: var(--v5-dark-off);
}
/* 全课第一段没有上一段：键藏起来但占位（visibility 不收空间、也不接点按），求助键留在正中 */
.lp-hide {
  visibility: hidden;
}

/* —— 求助面板（浅色 sheet·顶边落在顶栏下沿，由 wxml top 动态给） —— */
.lp-help-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  background: rgba(0, 0, 0, 0.5);
}
.lp-help-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  color: var(--v5-ink);
  padding: 20px 16px max(28px, env(safe-area-inset-bottom)); /* 去拖动条后上边距 12→20（15 问 14a） */
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.lp-help-nav {
  display: flex;
  align-items: center;
  gap: 8px;
}
.lp-help-sq {
  width: 32px;
  height: 30px;
  padding: 0;
  flex: 0 0 auto;
}
.lp-help-title {
  flex: 1;
  min-width: 0;
  font-size: 20px;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.lp-help-close {
  width: 44px;
  height: 44px;
  margin: -7px -6px;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}
.lp-help-card,
.lp-help-seg {
  height: 56px;
  justify-content: space-between;
  gap: 12px;
}
.lp-help-seg {
  margin-top: 8px;
}
.lp-help-card-tx {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.lp-help-card-title {
  font-size: 17px;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 同 .t-cap 但留本页：要压过动态挂上的 .mono 字重（app.wxss 里 .mono 在 .t-cap 之后），挪进 .t-cap 会变 500 */
.lp-help-seg-dur {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.k-flat .lp-help-seg-dur {
  color: var(--v5-ink-3);
}
.lp-help-scroll {
  flex: 1;
  min-height: 0;
}
.lp-help-topic {
  padding-top: 16px;
}
.lp-help-topic-title {
  font-size: 17px;
  font-weight: 600;
}
.lp-help-topic-sub {
  margin-top: 4px;
  font-size: 13px;
  line-height: 1.5;
  color: var(--v5-ink-2);
}

/* 常见问题问答（CMS help.faq）：发丝线分隔的问答行；q/a 字号随容器（KB 条目另有 .lp-help-faq-item 下的同名规则） */
.lp-help-faq {
  padding: 16px 0;
  border-bottom: 1px solid var(--v5-hair);
  font-size: 15px;
}
.lp-help-faq-q {
  font-weight: 500;
  color: var(--v5-ink);
}
.lp-help-faq-a {
  margin-top: 8px;
  line-height: 1.6;
  color: var(--v5-ink-2);
}

/* 帮助视频/常见问题空态（loading/empty/fail 共用容器，文案由 wxml 分支） */
.lp-help-empty {
  padding: 24px 0 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  text-align: center;
  font-size: 17px;
  font-weight: 500;
  color: var(--v5-ink-2);
}
.lp-help-empty-key {
  align-self: stretch;
  color: var(--v5-ink);
}

/* 常见问题条目（R37·KB 精选 FAQ）：同 CMS 问答行版式 */
.lp-help-faq-item {
  padding: 16px 0;
  border-bottom: 1px solid var(--v5-hair);
}
.lp-help-faq-item .lp-help-faq-q {
  font-size: 15px;
  font-weight: 500;
  color: var(--v5-ink);
}
.lp-help-faq-item .lp-help-faq-a {
  margin-top: 8px;
  font-size: 15px;
  line-height: 1.6;
  color: var(--v5-ink-2);
}

/* 内嵌播放视图（原生 <video controls>，不做自绘控制条——辅助内容非主路径） */
.lp-help-play {
  flex: 1;
  min-height: 180px;
  border-radius: 8px;
  overflow: hidden;
  background: var(--v5-dark);
}
.lp-help-play-video {
  width: 100%;
  height: 100%;
}

/* —— 首次成功退出加桌引导（浅色底部 sheet） —— */
.lp-dg-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  background: rgba(0, 0, 0, 0.5);
}
.lp-dg-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  color: var(--v5-ink);
  padding: 20px 16px max(28px, env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16px;
}
/* 加桌引导两步（15 问 11a）：序号 28 方块 + 说明 */
.lp-dg-steps {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.lp-dg-step {
  display: flex;
  align-items: center;
  gap: 12px;
}
.lp-dg-no {
  width: 28px;
  height: 28px;
  flex: 0 0 auto;
  background: var(--v5-sunk);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  font-weight: 600;
}
.lp-dg-t {
  font-size: 17px;
  font-weight: 500;
}
.lp-dg-ok {
  margin-top: 8px; /* 与步骤间距 16+8＝24 */
}
