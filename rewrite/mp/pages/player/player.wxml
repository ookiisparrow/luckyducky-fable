<!-- 课程播放页（v5 设计稿 C7 播放页 / 段间·停在本段末 / C9 学完一节）：暗底 #121212，暗色键 .k-dk，主键反相 .k-inv。
     结构：顶栏（返回+一行课时名·右侧 104px 留白给原生胶囊）→ 视频舞台（弹性高·圆角）→ 底部（seek 条 + 段名/时长 + 上一段|播放暂停|下一段|求助）。
     回归红线：playToken 乱序防护/首帧埋点/segment_done/watch_at/25min 地址缓存；
     段落播完不自动切下一段（onEnded 停在完成态·段内停「段间」浮层、课时末段换 C9 学完一节版式，重播/切段交由用户，见 player.ts）。
     自绘 seek 条两段式语义（WXS sk.onStart/onMove/onEnd + 逻辑层 onSeekTick/onSeekCommit：拖动中只改显示，松手才真 seek）+
     关键动作节点磁吸/震感（单源 lib/haptics）。seek.wxs 按 class 操作 .lp-seek-fill/.lp-seek-handle/.lp-seek-preview（setStyle + addClass），
     这些节点 class 不做数据绑定（错题本 E29：同一样式属性/类只能一个写入方）。
     求助面板：底部 sheet（menu/videos/faq 三态），播放不阻断，唯一暂停例外＝帮助视频内嵌播放（原生 <video controls>）。
     返回二次确认 + 首次成功退出加桌引导：手势/系统返回无法拦截（WebView 页无 onBackPress），仅自绘返回键经此。 -->
<!-- 自绘 seek 拖动几何·渲染层驱动（根因#15）：外置 WXS 模块 sk（内联 <wxs> 里的 < 比较会被 rw-mp-wxml-well-formed 咬红，必须外置） -->
<wxs src="./seek.wxs" module="sk" />
<view class="ld-player">

  <!-- 顶栏：暗色返回键 + 一行课时名（数据源 lib/player lessonStrip；拿不到课时按态兜底，missing/error 不写「正在学习」自相矛盾） -->
  <view class="lp-topbar" style="padding-top: {{statusBarHeight}}px">
    <view class="lp-bar">
      <view class="lp-back" bind:tap="onBack" hover-start-time="20" hover-class="lp-back-down" hover-stay-time="100" data-k="dk" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">
        <view class="k k-sm k-dk lp-back-key"><px-i name="back" /></view>
      </view>
      <text class="t-sys lp-nav-cap">{{strip ? strip.lessonNo + ' · ' + strip.lessonName : (title || (state === 'missing' ? '课程' : (state === 'error' ? '加载失败' : '正在学习')))}}</text>
    </view>
  </view>

  <!-- 视频舞台：弹性高圆角框（C9 学完一节时收成 200px 留本段最后一帧·<video> 不卸载） -->
  <block wx:if="{{state === 'playing' || state === 'loading'}}">
    <view class="lp-stage {{segDone && strip && strip.segIndex === strip.segTotal ? 'lesson-done' : ''}}">
      <video
        wx:if="{{src}}"
        id="lp-video"
        class="lp-video"
        src="{{src}}"
        autoplay
        initial-time="{{initialTime}}"
        controls="{{false}}"
        show-center-play-btn="{{false}}"
        show-loading="{{false}}"
        object-fit="contain"
        bind:play="onVideoPlay"
        bind:pause="onVideoPause"
        bind:ended="onEnded"
        bind:error="onVideoError"
        bind:waiting="onVideoWaiting"
        bind:progress="onVideoProgress"
        bind:timeupdate="onTimeUpdate"
        bind:loadedmetadata="onVideoMeta"
      ></video>
      <view wx:else class="lp-video lp-skeleton">
        <px-anim name="loader" size="2" dark />
        <text class="t-sys lp-skeleton-text">正在加载首帧…</text>
      </view>

      <!-- 全屏单击播放/暂停（透明点击层·paused 以 bind:play/bind:pause 回报为准）；暂停大圆/缓冲角标是它的子节点，点它们冒泡到 tapzone。 -->
      <view wx:if="{{src && !segDone}}" class="lp-tapzone" bind:tap="onTapVideo">
        <!-- 首帧前转圈（不加字·老板 2026-09-29 选定）；被拦自动播放时换下方播放键 -->
        <view wx:if="{{!started && !blocked}}" class="lp-first-loader"><px-anim name="loader" size="2" dark /></view>
        <view wx:if="{{state === 'playing' && started && !hintDismissed}}" class="t-sys lp-tap-hint px-clip-6">单击画面 播放 / 暂停</view>
        <view wx:if="{{paused || blocked}}" class="lp-pause-badge px-circle-disc"><px-i name="playL" tone="var(--v5-dark-ink)" /></view>
        <!-- 缓冲失速角标·见 ts onVideoWaiting -->
        <view wx:if="{{buffering && !paused && started}}" class="t-sys lp-buffering px-clip-6">
          <px-anim name="loader" size="2" dark />
          <text>正在缓冲…</text>
        </view>
      </view>

      <!-- 段间 · 停在本段末（课时内还有下一段）：本段完成文案 + 重播本段 / 继续下一段 -->
      <view wx:if="{{segDone && !(strip && strip.segIndex === strip.segTotal)}}" class="lp-segend">
        <text class="lp-segend-cap">{{capText}}</text>
        <view class="lp-segend-keys">
          <view class="k k-dk" hover-start-time="20" hover-class="k-dk-down" hover-stay-time="100" bind:tap="onReplay" data-k="dk" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">重播本段</view>
          <view wx:if="{{canNext}}" class="k k-dk" hover-start-time="20" hover-class="k-dk-down" hover-stay-time="100" bind:tap="onNext" data-k="dk" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">继续下一段<px-i name="arrow" /></view>
        </view>
      </view>
    </view>
  </block>

  <view class="lp-stage lp-state" wx:elif="{{state === 'empty'}}">
    <text class="lp-state-title">这段视频还在整理中</text>
    <text class="lp-state-hint t-sys">先看看别的段落吧</text>
    <view wx:if="{{canNext}}" class="k k-dk lp-state-key" hover-start-time="20" hover-class="k-dk-down" hover-stay-time="100" bind:tap="onNext" data-k="dk" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">跳到下一段</view>
  </view>
  <view class="lp-stage lp-state" wx:elif="{{state === 'denied'}}">
    <text class="lp-state-title">先激活课程才能观看</text>
    <view class="k k-inv lp-state-key" hover-start-time="20" hover-class="k-inv-down" hover-stay-time="100" bind:tap="onGoActivate" data-k="inv" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">去输入激活码</view>
  </view>
  <!-- missing 态补出路：别只有「没找到」一句、一个可点的都没有（同页 error 态有重试按钮）。 -->
  <view class="lp-stage lp-state" wx:elif="{{state === 'missing'}}">
    <text class="lp-state-title">没找到这门课</text>
    <text class="lp-state-hint t-sys">可能课程已下架，或者这个链接不对</text>
    <view class="k k-inv lp-state-key" hover-start-time="20" hover-class="k-inv-down" hover-stay-time="100" bind:tap="onGoCourses" data-k="inv" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">去我的课程看看</view>
  </view>
  <!-- error 态双语义：current 有值=段级失败（取址/媒体）；current 空=课程目录都没拉到，重试都走 onRetryError（内部自分流）。 -->
  <view class="lp-stage lp-state" wx:elif="{{state === 'error'}}">
    <text class="lp-state-title">{{current ? '这段视频暂时播放不了' : '课程内容没加载出来'}}</text>
    <text class="lp-state-hint t-sys">{{current ? '可能是网络或格式问题，换一段或稍后再试' : '网络开小差了，稍后再试'}}</text>
    <view class="lp-state-keys">
      <view class="k k-inv lp-state-key" hover-start-time="20" hover-class="k-inv-down" hover-stay-time="100" bind:tap="onRetryError" data-k="inv" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">{{current ? '重试本段' : '重新加载'}}</view>
      <view wx:if="{{canNext}}" class="k k-dk lp-state-key" hover-start-time="20" hover-class="k-dk-down" hover-stay-time="100" bind:tap="onNext" data-k="dk" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">跳到下一段</view>
    </view>
  </view>

  <!-- 底部（仅播放中）：C9 学完一节时整块隐藏（不卸载·seek 节点与 WXS 状态留着），换学完版式 -->
  <view wx:if="{{state === 'playing'}}" class="lp-bottombar {{segDone && strip && strip.segIndex === strip.segTotal ? 'is-off' : ''}}">
    <view
      class="lp-seek hit44"
      bind:touchstart="{{sk.onStart}}"
      catch:touchmove="{{sk.onMove}}"
      bind:touchend="{{sk.onEnd}}"
      bind:touchcancel="{{sk.onEnd}}"
      change:cfg="{{sk.onCfg}}"
      cfg="{{seekCfg}}"
      change:pct="{{sk.onPct}}"
      pct="{{seekPct}}"
    >
      <!-- 拖动浮层（常驻不 wx:if：显隐与 left 由 seek.wxs setStyle+addClass('on') 渲染层控）；命中关键动作节点再叠黄气泡 -->
      <view class="lp-seek-preview">
        <view class="lp-seek-preview-time mono px-clip-6">{{curClock}}</view>
        <view wx:if="{{snapName}}" class="t-sys lp-seek-preview-bubble px-clip-6">关键动作 · {{snapName}}</view>
      </view>
      <view class="lp-seek-track"></view>
      <!-- 缓冲水位（bind:progress 尽力而为·换段清零 bufferPct·WXS 不碰） -->
      <view class="lp-seek-buffer" style="width: {{bufferPct}}%"></view>
      <!-- fill 宽/handle left：非拖动期由 seekPct 经 change:pct→sk.onPct 落位；拖动期 seek.wxs setStyle 接管 -->
      <view class="lp-seek-fill" style="width: {{seekPct}}%"></view>
      <view class="lp-seek-node" wx:for="{{markVMs}}" wx:key="at" style="left: {{item.pct}}%"></view>
      <view class="lp-seek-handle" style="left: {{seekPct}}%"></view>
    </view>

    <view class="lp-info">
      <view class="lp-info-l">
        <text class="t-sys lp-seg-no">{{strip ? '段落 ' + strip.segIndex + ' / ' + strip.segTotal : ''}}</text>
        <text class="t-sys lp-seg-title">{{current ? current.segName : ''}}</text>
      </view>
      <text class="lp-time mono {{seeking ? 'on' : ''}}">{{curClock}} / {{durClock}}</text>
    </view>

    <view class="lp-controls">
      <view class="k k-48 k-sq lp-ctl {{canPrev ? 'k-dk' : 'lp-key-off'}}" hover-start-time="20" hover-class="{{canPrev ? 'k-dk-down' : 'none'}}" hover-stay-time="100" bind:tap="onPrev" data-k="{{canPrev ? 'dk' : 'none'}}" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i name="prev" /></view>
      <view class="k k-48 k-inv lp-ctl-main" hover-start-time="20" hover-class="k-inv-down" hover-stay-time="100" bind:tap="onTapVideo" data-k="inv" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i name="{{paused ? 'play' : 'pause'}}" tone="var(--v5-ink)" /></view>
      <view class="k k-48 k-sq lp-ctl {{canNext ? 'k-dk' : 'lp-key-off'}}" hover-start-time="20" hover-class="{{canNext ? 'k-dk-down' : 'none'}}" hover-stay-time="100" bind:tap="onNext" data-k="{{canNext ? 'dk' : 'none'}}" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i name="next" /></view>
      <view class="k k-48 k-dk k-sq" hover-start-time="20" hover-class="k-dk-down" hover-stay-time="100" bind:tap="onHelp" data-k="dk" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i name="help" /></view>
    </view>
  </view>

  <!-- C9 学完一节（课时末段播完）：分段全亮 + 完成文案 + 重看本节 / 继续下一节。
       全课最后一段（无下一节）：重看本节 / 完成课程（进 C10 结业页 pages/finish）。 -->
  <view wx:if="{{state === 'playing' && segDone && strip && strip.segIndex === strip.segTotal}}" class="lp-done">
    <view class="lp-done-body">
      <view class="lp-done-segs">
        <view class="lp-done-seg {{item}}" wx:for="{{strip.cells}}" wx:key="*this"></view>
      </view>
      <text class="t-sys lp-done-cap">{{capText}}</text>
      <text class="lp-done-title">这一节学完了</text>
    </view>
    <view class="lp-done-keys">
      <view class="k k-48 k-dk k-sq" hover-start-time="20" hover-class="k-dk-down" hover-stay-time="100" bind:tap="onReplayLesson" data-k="dk" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i name="replay" /></view>
      <view wx:if="{{canNext}}" class="k k-48 k-inv lp-done-main" hover-start-time="20" hover-class="k-inv-down" hover-stay-time="100" bind:tap="onNext" data-k="inv" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i name="next" /></view>
      <view wx:else class="k k-48 k-inv lp-done-main" hover-start-time="20" hover-class="k-inv-down" hover-stay-time="100" bind:tap="onFinishCourse" data-k="inv" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">完成课程</view>
    </view>
  </view>

  <!-- 求助面板：浅色底部 sheet，menu/videos/faq 三态，见 player.ts helpPanel。
       scrim 与 sheet 均锁背景滚动（catch:touchmove="noop"）；列表用 scroll-view 自滚。 -->
  <!-- 求助面板（15 问 11a）：全站浅色半屏，高度按内容、超出面板内滚；帮助视频播放子页才撑到导航栏下 -->
  <view class="lp-help-mask sh-mask {{helpOut ? 'out' : ''}}" wx:if="{{helpPanel}}" bind:tap="onHelpClose" catch:touchmove="noop">
    <view class="lp-help-sheet sh-panel {{helpOut ? 'out' : ''}}" style="{{helpSrc ? 'top: ' + (statusBarHeight + 44) + 'px' : 'max-height: calc(100% - ' + (statusBarHeight + 44) + 'px)'}}" catch:tap="noop" catch:touchmove="noop">
      <view class="lp-help-nav">
        <view wx:if="{{helpPanel === 'videos' && helpSrc}}" class="k k-sm k-light lp-help-sq hit44" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onHelpVideoBack" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i name="back" /></view>
        <view wx:elif="{{helpPanel !== 'menu'}}" class="k k-sm k-light lp-help-sq hit44" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onHelpBackMenu" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i name="back" /></view>
        <text class="lp-help-title">{{helpPanel === 'menu' ? '需要帮忙吗？' : (helpPanel === 'faq' ? help.faqTitle : (helpSrc ? (helpSegName || '正在播放') : help.videosTitle))}}</text>
        <view class="lp-help-close" bind:tap="onHelpClose">
          <view class="k k-sm k-light lp-help-sq hit44" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i name="times" /></view>
        </view>
      </view>

      <!-- menu 层 -->
      <block wx:if="{{helpPanel === 'menu'}}">
        <view class="k k-light lp-help-card" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onHelpVideos" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">
          <view class="lp-help-card-tx">
            <text class="t-sys lp-help-card-title">{{help.videosTitle}}</text>
            <text class="t-sys lp-help-card-sub t-cap">小段讲解都在这里</text>
          </view>
          <px-i name="chev" tone="var(--v5-ink-2)" />
        </view>
        <view class="k k-light lp-help-card" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onHelpFaq" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">
          <view class="lp-help-card-tx">
            <text class="t-sys lp-help-card-title">{{help.faqTitle}}</text>
            <text class="t-sys lp-help-card-sub t-cap">高频问题都在这里</text>
          </view>
          <px-i name="chev" tone="var(--v5-ink-2)" />
        </view>
        <view class="k k-48 k-light" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onHelpContact" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">{{help.contactTitle}}</view>
      </block>

      <!-- videos 子层：helpSrc 非空切到内嵌播放视图，否则主题列表 -->
      <block wx:if="{{helpPanel === 'videos'}}">
        <view wx:if="{{helpSrc}}" class="lp-help-play">
          <video class="lp-help-play-video" src="{{helpSrc}}" controls autoplay bind:error="onHelpVideoError"></video>
        </view>
        <scroll-view wx:else class="lp-help-scroll" scroll-y>
          <block wx:if="{{helpVideosState === 'ok'}}">
            <view class="t-sys lp-help-group-title t-cap">全部课程通用</view>
            <view class="lp-help-topic" wx:for="{{helpTopics}}" wx:key="id">
              <view class="t-sys lp-help-topic-title">{{item.title}}</view>
              <view class="lp-help-topic-sub t-sys" wx:if="{{item.sub}}">{{item.sub}}</view>
              <view
                class="k lp-help-seg {{seg.url ? 'k-light' : 'k-flat k-off'}}"
                hover-start-time="20" hover-class="{{seg.url ? 'k-light-down' : 'none'}}"
                hover-stay-time="100"
                wx:for="{{item.segments}}"
                wx:for-item="seg"
                wx:key="id"
                data-url="{{seg.url}}"
                data-name="{{seg.name}}"
                bind:tap="onHelpPlaySegment"
               data-k="{{seg.url ? 'light' : 'none'}}" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">
                <view class="lp-help-card-tx">
                  <text class="t-sys lp-help-card-title">{{seg.name}}</text>
                  <text class="t-sys lp-help-seg-dur {{seg.url ? 'mono' : ''}}">{{seg.url ? seg.dur : '整理中'}}</text>
                </view>
                <px-i wx:if="{{seg.url}}" name="chev" tone="var(--v5-ink-2)" />
              </view>
            </view>
          </block>
          <view class="lp-help-empty" wx:elif="{{helpVideosState === 'loading'}}">
            <px-anim name="loader" size="2" />
            <text>正在加载…</text>
          </view>
          <view class="lp-help-empty" wx:else>
            <text>帮助视频整理中，先问客服吧</text>
            <view class="k k-48 k-light lp-help-empty-key" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onHelpContact" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">联系客服</view>
          </view>
        </scroll-view>
      </block>

      <!-- faq 子层：CMS 自由文本（help.faq）非空则优先；否则 KB 精选单源（getPublicFaq）。
           接口失败走 helpFaqState=fail，真没有才空态导流客服（根因#14·失败≠没有 FAQ）。 -->
      <block wx:if="{{helpPanel === 'faq'}}">
        <scroll-view wx:if="{{help.faq.length > 0}}" class="lp-help-scroll" scroll-y>
          <view class="lp-help-faq" wx:for="{{help.faq}}" wx:key="q">
            <view class="t-sys lp-help-faq-q">{{item.q}}</view>
            <view class="lp-help-faq-a t-sys">{{item.a}}</view>
          </view>
        </scroll-view>
        <scroll-view wx:else class="lp-help-scroll" scroll-y>
          <block wx:if="{{helpFaqState === 'ok'}}">
            <view class="lp-help-faq-item" wx:for="{{helpFaqList}}" wx:key="key">
              <view class="t-sys lp-help-faq-q">{{item.title}}</view>
              <view class="lp-help-faq-a t-sys">{{item.content}}</view>
            </view>
          </block>
          <view class="lp-help-empty" wx:elif="{{helpFaqState === 'loading'}}">
            <px-anim name="loader" size="2" />
            <text>加载中…</text>
          </view>
          <view class="lp-help-empty" wx:elif="{{helpFaqState === 'fail'}}">
            <text>常见问题暂时查不到，请稍后再试</text>
            <view class="k k-48 k-light lp-help-empty-key" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onHelpContact" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">联系客服</view>
          </view>
          <view class="lp-help-empty" wx:else>
            <text>常见问题还在整理中，先问客服吧</text>
            <view class="k k-48 k-light lp-help-empty-key" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onHelpContact" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">联系客服</view>
          </view>
        </scroll-view>
      </block>
    </view>
  </view>

  <!-- 首次退出加桌引导（仅一次·分端文案·15 问 11a）：同全站浅色半屏。知道了＝继续退出；关闭键/遮罩＝留在播放页。
       iOS 标题含子集外的「序」，走黑体；两步说明是说明句，一律黑体。 -->
  <view class="lp-dg-mask sh-mask" wx:if="{{deskGuide}}" bind:tap="onDeskGuideStay" catch:touchmove="noop">
    <view class="lp-dg-sheet sh-panel" catch:tap="noop">
      <view class="lp-help-nav">
        <text wx:if="{{deskGuideIOS}}" class="t-sys lp-help-title">加到我的小程序，下次一点就开</text>
        <text wx:else class="lp-help-title">加到桌面，下次一点就开</text>
        <view class="lp-help-close" bind:tap="onDeskGuideStay">
          <view class="k k-sm k-light lp-help-sq hit44" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i name="times" /></view>
        </view>
      </view>
      <view class="lp-dg-steps">
        <view class="lp-dg-step"><text class="mono lp-dg-no px-clip-6">1</text><text class="t-sys lp-dg-t">点右上角的 ···</text></view>
        <view class="lp-dg-step"><text class="mono lp-dg-no px-clip-6">2</text><text class="t-sys lp-dg-t">{{deskGuideIOS ? '选「添加到我的小程序」' : '选「添加到桌面」'}}</text></view>
      </view>
      <view class="k k-48 k-ink lp-dg-ok" hover-start-time="20" hover-class="k-ink-down" hover-stay-time="100" bind:tap="onDeskGuideExit" data-k="ink" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">知道了</view>
    </view>
  </view>
</view>
