/* 商品评价（v5「字重」稿 A3） */
page {
  background: var(--v5-canvas);
  color: var(--v5-ink);
}
.rv {
  padding-bottom: 24px;
}

/* 摘要：大号均分 + 分布条 */
.rv-sum {
  padding: 4px 16px 0;
  display: flex;
  align-items: center;
  gap: 16px;
}
.rv-score {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.rv-num {
  font-size: 43px;
  font-weight: 600;
  line-height: 1.1;
}
.rv-count {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.rv-bars {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.rv-bar {
  display: flex;
  align-items: center;
  gap: 8px;
}
.rv-bar-lbl {
  font-size: 11px;
  color: var(--v5-ink-2);
}
/* 分段条：高 4、每段 4 间隔 2、直角（设计规范·像素小元素） */
.rv-track {
  position: relative;
  flex: 1;
  max-width: 142px;
  height: 4px;
  background: repeating-linear-gradient(90deg, #e0e1d9 0 4px, transparent 4px 6px);
}
.rv-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  background: repeating-linear-gradient(90deg, var(--v5-ink) 0 4px, transparent 4px 6px);
}

/* 标签 */
.rv-tags {
  padding: 16px 16px 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.rv-tags .rv-tag {
  height: 32px;
  padding: 0 12px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 13px;
  font-weight: 500; /* 圆体不出细体字重（只 500/700/900·字体瘦身） */
  color: var(--v5-ink); /* 未选中是凹键底，但字不置灰（设计稿 A3 标签一律 #111） */
}
.rv-tag-n {
  font-size: 11px;
  color: var(--v5-ink-2);
}

/* 列表 */
.rv-list {
  padding: 12px 16px 0;
}
.rv-item {
  padding: 12px 0;
  border-top: 1px solid var(--v5-hair);
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.rv-top {
  display: flex;
  align-items: center;
  gap: 8px;
}
.rv-name {
  min-width: 0;
  font-size: 17px;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rv-stars {
  flex: 1;
  display: flex;
  gap: 2px;
}
.rv-date {
  font-size: 13px;
  color: var(--v5-ink-2);
}
.rv-spec {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.rv-text {
  font-size: 17px;
  font-weight: 500;
  line-height: 1.55;
}
.rv-pics {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}
.rv-pic {
  width: 56px;
  height: 56px;
  border-radius: 4px;
  background: var(--v5-sunk);
}
.rv-skel-bar {
  height: 17px;
  border-radius: 4px;
}

/* 失败 / 空 / 翻页 */
.rv-state {
  padding: 32px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  text-align: center;
}
.rv-state-title {
  font-size: 17px;
  font-weight: 500;
}
.rv-state-hint {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.rv-retry {
  margin-top: 8px;
}
.rv-more {
  padding: 16px 0;
  text-align: center;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
