/* 确认订单（v5「字重」稿 A5） */
page {
  background: var(--v5-canvas);
  color: var(--v5-ink);
}
/* 整页一列：顶栏 + 小货车 + 滚动内容 + 底坞（设计稿 A5：车在滚动区外不跟着滚） */
.co {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
/* 小货车：顶栏下 groundGap 处落地（屏高<700 为 56、其余 120·lib/ground·全站同一条地面线） */
.co-truck {
  flex: 0 0 auto;
  padding: 0 16px 12px;
}
.co-scroll {
  flex: 1;
  height: 0;
}
.co-body {
  padding: 0 16px 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.co-card {
  border-radius: 8px;
  background: var(--v5-surface);
  box-shadow: 0 0 0 1px var(--v5-hair);
}
.co-k {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}

/* 地址 */
.co-addr {
  padding: 16px;
}
.co-addr-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.co-change {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 300;
}
/* 姓名 · 打码手机号一行（设计稿 co.who：17px 黑字） */
.co-who {
  display: block;
  margin-top: 8px;
  font-size: 17px;
  font-weight: 500;
  color: var(--v5-ink);
}
.co-where {
  display: block;
  margin-top: 2px;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.co-addr-none {
  padding: 16px 12px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.co-addr-add {
  flex: 1;
  font-size: 17px;
  font-weight: 500;
}

/* 商品 / 搭配购 */
.co-items {
  padding: 0 16px;
  overflow: hidden;
}
.co-item {
  padding: 12px 0;
  display: flex;
  align-items: center;
  gap: 12px;
  border-top: 1px solid var(--v5-hair);
}
.co-item:first-child,
.co-addon-head + .co-item {
  border-top: 0;
}
.co-thumb {
  width: 40px;
  height: 40px;
  flex: 0 0 auto;
  border-radius: 4px;
  overflow: hidden;
  background: repeating-linear-gradient(135deg, var(--v5-sunk) 0 5px, var(--v5-sunk-2) 5px 10px);
}
.co-thumb-img {
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: 50% 40%;
}
.co-item-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.co-item-name {
  font-size: 17px;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.co-item-sub {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.co-item-price {
  font-size: 15px;
  font-weight: 600;
}
/* 改数量（老板拍板 9）：价格在上、−/+ 在下，键帽与热区同购物车（28px 键·44×44 热区） */
.co-item-right {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8px;
}
.co-step {
  display: flex;
  align-items: center;
}
.co-step-hit {
  position: relative;
  width: 34px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.co-step-l {
  margin: -8px 0 -8px -3px;
}
.co-step-r {
  margin: -8px -3px -8px 0;
}
.co-step-hit::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  width: 10px;
}
.co-step-l::after {
  left: -10px;
}
.co-step-r::after {
  right: -10px;
}
.co-step-key {
  width: 28px;
  height: 28px;
  padding: 0;
  border-radius: 4px;
}
/* 到头（1 件 / 上限）或提交在途：置灰、按了不动 */
.co-step-off {
  opacity: 0.35;
}
.co-qty {
  width: 24px;
  text-align: center;
  font-size: 15px;
  font-weight: 600;
}
.co-addon-head {
  display: block;
  padding: 12px 0 0;
}
.co-addon-name {
  flex: 1;
  min-width: 0;
}
.co-check {
  width: 22px;
  height: 22px;
  padding: 0;
  border-radius: 4px;
}

/* 明细 */
.co-sum {
  padding: 4px 4px 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.co-sum-row {
  display: flex;
  align-items: center;
  gap: 8px;
}
.co-leader {
  flex: 1;
  height: 2px;
  background: repeating-linear-gradient(90deg, var(--v5-rule) 0 2px, transparent 2px 4px);
}
.co-v {
  font-size: 15px;
}
.co-policy {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}

/* 底部：应付 + 提交（主键宽度随设计稿公式：与详情页 加购1:直买1.25 的主键对齐不跳） */
.co-dock {
  flex: 0 0 auto;
  padding: 12px 16px max(28px, env(safe-area-inset-bottom));
  display: flex;
  flex-wrap: wrap; /* 协议小字独占第一行，应付 + 提交在第二行 */
  align-items: center;
  gap: 12px;
  border-top: 1px solid var(--v5-hair);
  background: var(--v5-canvas);
}
/* 协议小字（老板拍板 10）：书名号上下各让 8px 扩热区，负外边距抵掉、视觉不变 */
.co-agree {
  flex: 0 0 100%;
  margin: -8px 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  align-items: center;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.co-link {
  padding: 8px 0;
  color: var(--v5-ink);
  font-weight: 500;
}
.co-total {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.co-amount {
  font-size: 22px;
  font-weight: 600;
}
.co-submit {
  flex: 0 0 calc((100% - 108px) * 1.25 / 2.25 + 24px);
  gap: 12px;
}
