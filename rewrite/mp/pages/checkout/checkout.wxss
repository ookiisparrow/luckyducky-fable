/* 确认订单（v5「字重」稿 A5） */
page {
  background: var(--v5-canvas);
  color: var(--v5-ink);
}
/* 小货车：顶栏下 120px 处落地（全站同一条地面线） */
.co-truck {
  padding: 120px 16px 12px;
}
.co-body {
  padding: 0 16px 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.co-card {
  border-radius: 8px;
  background: #ffffff;
  box-shadow: 0 0 0 1px var(--v5-hair);
}
.co-k {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}

/* 地址 */
.co-addr {
  padding: 16px;
}
.co-addr-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.co-change {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 300;
}
.co-who {
  margin-top: 8px;
  display: flex;
  align-items: baseline;
  gap: 8px;
  font-size: 17px;
  font-weight: 500;
}
.co-phone {
  font-size: 15px;
  color: var(--v5-ink-2);
}
.co-where {
  display: block;
  margin-top: 2px;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.co-addr-none {
  padding: 16px 12px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.co-addr-add {
  flex: 1;
  font-size: 17px;
  font-weight: 500;
}

/* 商品 / 搭配购 */
.co-items {
  padding: 0 16px;
  overflow: hidden;
}
.co-item {
  padding: 12px 0;
  display: flex;
  align-items: center;
  gap: 12px;
  border-top: 1px solid var(--v5-hair);
}
.co-item:first-child,
.co-addon-head + .co-item {
  border-top: 0;
}
.co-thumb {
  width: 40px;
  height: 40px;
  flex: 0 0 auto;
  border-radius: 4px;
  overflow: hidden;
  background: repeating-linear-gradient(135deg, var(--v5-sunk) 0 5px, #e3e3df 5px 10px);
}
.co-thumb-img {
  display: block;
  width: 100%;
  height: 100%;
}
.co-item-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.co-item-name {
  font-size: 17px;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.co-item-sub {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.co-item-price {
  font-size: 15px;
  font-weight: 600;
}
.co-addon-head {
  display: block;
  padding: 12px 0 0;
}
.co-addon-name {
  flex: 1;
  min-width: 0;
}
.co-check {
  width: 22px;
  height: 22px;
  padding: 0;
  border-radius: 4px;
}

/* 明细 */
.co-sum {
  padding: 4px 4px 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.co-sum-row {
  display: flex;
  align-items: center;
  gap: 8px;
}
.co-leader {
  flex: 1;
  height: 2px;
  background: repeating-linear-gradient(90deg, #c9c9c2 0 2px, transparent 2px 4px);
}
.co-v {
  font-size: 15px;
}
.co-policy {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}

/* 底部：应付 + 提交（主键宽度随设计稿公式：与详情页 加购1:直买1.25 的主键对齐不跳） */
.co-dock-space {
  height: calc(80px + max(28px, env(safe-area-inset-bottom)));
}
.co-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12px 16px max(28px, env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 12px;
  border-top: 1px solid var(--v5-hair);
  background: var(--v5-canvas);
}
.co-total {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.co-amount {
  font-size: 22px;
  font-weight: 600;
}
.co-submit {
  flex: 0 0 calc((100% - 108px) * 1.25 / 2.25 + 24px);
  gap: 12px;
}
