<!-- 确认订单（v5「字重」稿 A5）：开进来的小货车 + 地址卡 + 商品卡 + 搭配购（设计稿未画·真实在卖保留）+ 点线明细；
     底部 应付 + 提交（在途换像素 loader）。业务逻辑全在 checkout.ts：地址(onPickAddress)/搭配购(onToggleAddon)/提交(onSubmit)。
     顾客页不展示券类折扣（已拍板·no-customer-coupon-ui 测试钉）。商品行 −/+ 改数量（老板拍板 9：只改本次草稿、不回写购物车；
     键帽/热区同购物车；到头或提交在途置灰且 onQtyInc/onQtyDec 不响应）。搭配购恒 1 件不带 −/+。
     整页一列（设计稿 L212-213）：顶栏 + 小货车固定在滚动区外，只有中间内容滚，底部应付/提交也不动。 -->
<view class="co">
  <v5-nav title="确认订单" />
  <view class="co-truck" style="padding-top: {{groundGap}}px"><px-truck id="truck" pose="drive" arrive="160" cargo="{{cargo}}" /></view>

  <scroll-view class="co-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
  <view class="co-body">
    <!-- 收货地址 -->
    <view wx:if="{{address}}" class="k-card co-card co-addr" hover-start-time="20" hover-class="k-card-down" bind:tap="onPickAddress">
      <view class="co-addr-top">
        <text class="t-sys co-k">收货地址</text>
        <view class="t-sys co-change"><text>更换</text><px-i name="arrow" /></view>
      </view>
      <text class="t-sys co-region">{{address.region}}</text>
      <text class="t-sys co-detail">{{address.detail}}</text>
      <text class="t-sys co-who">{{address.who}}</text>
    </view>
    <view wx:else class="k-card co-card co-addr-none" hover-start-time="20" hover-class="k-card-down" bind:tap="onPickAddress">
      <px-i name="led" tone="var(--v5-warn)" />
      <text class="co-addr-add">添加收货地址</text>
      <px-i name="arrow" tone="var(--v5-ink-2)" />
    </view>

    <!-- 商品 -->
    <view class="co-card co-items">
      <view class="co-item" wx:for="{{items}}" wx:key="lineId">
        <view class="co-thumb">
          <!-- 焦点 50% 40%（设计稿 object-position）：<image> 的 aspectFill 只能居中，改背景图定焦点 -->
          <view wx:if="{{item.cover}}" class="co-thumb-img" style="background-image: url('{{item.cover}}')"></view>
        </view>
        <view class="co-item-mid">
          <text class="t-sys co-item-name">{{item.name}}</text>
          <text wx:if="{{item.step}}" class="t-sys co-item-sub">{{item.sku || item.tag}}</text>
          <text wx:else class="t-sys co-item-sub">{{item.sku || item.tag}}{{item.sku || item.tag ? ' · ' : ''}}×{{item.qty}}</text>
        </view>
        <view wx:if="{{item.step}}" class="co-item-right">
          <text class="mono co-item-price">¥{{item.priceNum}}</text>
          <view class="co-step">
            <view class="co-step-hit co-step-l" data-line="{{item.lineId}}" bind:tap="onQtyDec">
              <view class="k k-sm k-light co-step-key {{item.canDec && !submitting ? '' : 'co-step-off'}}" hover-start-time="20" hover-class="{{item.canDec && !submitting ? 'k-light-down' : ''}}" hover-stay-time="100" data-k="{{item.canDec && !submitting ? 'light' : ''}}" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i name="minus" /></view>
            </view>
            <text class="mono co-qty">{{item.qty}}</text>
            <view class="co-step-hit co-step-r" data-line="{{item.lineId}}" bind:tap="onQtyInc">
              <view class="k k-sm k-light co-step-key {{item.canInc && !submitting ? '' : 'co-step-off'}}" hover-start-time="20" hover-class="{{item.canInc && !submitting ? 'k-light-down' : ''}}" hover-stay-time="100" data-k="{{item.canInc && !submitting ? 'light' : ''}}" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i name="plus" /></view>
            </view>
          </view>
        </view>
        <text wx:else class="mono co-item-price">¥{{item.priceNum}}</text>
      </view>
    </view>

    <!-- 搭配购买：只有真能卖的加项才露整块；checkoutConst 里 hook/yarn 是占位，空则整块不渲染。 -->
    <view class="co-card co-items" wx:if="{{addons.length}}">
      <text class="t-sys co-k co-addon-head">搭配购买</text>
      <view class="co-item" wx:for="{{addons}}" wx:key="id" hover-start-time="20" hover-class="k-row-down" data-id="{{item.id}}" bind:tap="onToggleAddon">
        <view class="k k-sm k-light co-check"><px-i wx:if="{{item.added}}" name="check" tone="var(--v5-violet)" /></view>
        <text class="t-sys co-item-name co-addon-name">{{item.name}}</text>
        <text class="mono co-item-price">¥{{item.priceNum}}</text>
      </view>
    </view>

    <!-- 金额明细（点线引导）：运费行仍用 shipLabel（SHIP=0 显示「包邮」）；政策说明另起一行，不算钱 -->
    <view class="co-sum">
      <view class="co-sum-row"><text class="t-sys co-k">商品</text><view class="co-leader"></view><text class="mono co-v">{{goodsLabel}}</text></view>
      <view class="co-sum-row"><text class="t-sys co-k">运费</text><view class="co-leader"></view><text class="mono co-v">顺丰速运 · {{shipLabel}}</text></view>
      <text class="t-sys co-policy">包邮到家 · 售后无忧</text>
    </view>
  </view>
  </scroll-view>

  <view class="co-dock">
    <!-- 协议小字（老板拍板 10）：书名号点开对应协议页；提交在途不跳（防下单成功换页替掉协议页） -->
    <view class="t-sys co-agree">
      <text>提交订单即表示同意</text>
      <text class="co-link hit44" data-type="user" bind:tap="onAgreement">《用户协议》</text>
      <text class="co-link hit44" data-type="privacy" bind:tap="onAgreement">《隐私政策》</text>
    </view>
    <view class="co-total">
      <text class="t-sys co-k">应付</text>
      <text class="mono co-amount">¥{{amountNum}}</text>
    </view>
    <!-- 在途反馈：像素 loader + 「提交中」→ 建单成功打勾「已提交」（停 600ms）→ 调支付参数期间转圈「正在拉起支付」
         （刻意不用 wx.showLoading：本链多分支 return，hideLoading 配对易漏→锁屏） -->
    <view class="k k-ink k-48 co-submit" hover-start-time="20" hover-class="{{submitting ? '' : 'k-ink-down'}}" hover-stay-time="100" bind:tap="onSubmit" data-k="{{submitting ? '' : 'ink'}}" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">
      <block wx:if="{{submitted}}"><px-anim name="checkin" size="2" dark hold="700" /><text>已提交</text></block>
      <block wx:elif="{{paying}}"><px-anim name="loader" size="2" dark /><text>正在拉起支付</text></block>
      <block wx:elif="{{submitting}}"><px-anim name="loader" size="2" dark /><text>提交中</text></block>
      <text wx:else>提交订单</text>
    </view>
  </view>
</view>

<px-fx id="fx" />
