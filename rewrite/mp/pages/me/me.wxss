/* 我（v5「字重」稿 D1） */
page {
  background: var(--v5-canvas);
  color: var(--v5-ink);
}
/* 滚动容器：退出提醒的 page-container 武装态冻结页面级滚动（决策§30），滚动改在 scroll-view 内发生。
   须填满视口——height 而非 min-height（scroll-view 靠固定高度才产生内部滚动）。 */
.me-scroll {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--v5-canvas);
}
.me-bar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 10;
  background: var(--v5-canvas);
}
.me-head {
  height: 44px;
  padding: 0 104px 0 16px;
  display: flex;
  align-items: center;
}
.me-title {
  font-size: 20px;
  font-weight: 700;
}
/* 小鸭蛋：顶栏下 120px 处落地（全站同一条地面线·同 cart .ca-truck） */
.me-egg {
  padding: 120px 16px 12px;
}

/* 身份行 */
.me-id {
  padding: 8px 16px 0;
  display: flex;
  align-items: center;
  gap: 16px;
}
.me-av {
  width: 64px;
  height: 64px;
  flex: 0 0 auto;
  border-radius: 6px;
  overflow: hidden;
  background: var(--v5-sunk);
}
.me-av-out {
  background: repeating-linear-gradient(135deg, #ededea 0 5px, #e3e3df 5px 10px);
}
.me-av-img {
  width: 100%;
  height: 100%;
  display: block;
}
.me-id-t {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.me-nick {
  font-size: 20px;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.me-id-sub {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
/* 小键（高 32）：编辑 / 登录 / 重试 / 扫码激活 */
.me-mini {
  height: 32px;
  padding: 0 12px;
  flex: 0 0 auto;
}
.me-mini-weak {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}

/* 继续学习卡 */
.me-card {
  margin: 24px 16px 0;
  padding: 16px;
  border-radius: 8px;
  background: #ffffff;
  box-shadow: 0 0 0 1px var(--v5-hair);
  display: flex;
  align-items: center;
  gap: 12px;
}
.me-thumb {
  width: 52px;
  height: 52px;
  flex: 0 0 auto;
  border-radius: 4px;
  background: repeating-linear-gradient(135deg, #ededea 0 5px, #e3e3df 5px 10px);
}
.me-card-t {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.me-card-sub {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.me-card-main {
  font-size: 17px;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.me-card-grow {
  flex: 1;
  min-width: 0;
}
.me-play {
  width: 44px;
  padding: 0 0 0 2px;
  flex: 0 0 auto;
}
.me-skel-l {
  width: 60%;
  height: 13px;
  border-radius: 4px;
}
.me-skel-s {
  width: 80%;
  height: 17px;
  border-radius: 4px;
}

/* 订单四格 */
.me-grid {
  margin: 12px 16px 0;
  display: flex;
  gap: 4px;
}
.me-cell {
  flex: 1;
  min-width: 0;
  height: 56px;
  padding: 0 4px;
  flex-direction: column;
  gap: 4px;
}
.me-cell-top {
  height: 22px;
  display: flex;
  align-items: center;
  gap: 4px;
}
.me-cell-n {
  font-size: 17px;
  font-weight: 500;
  letter-spacing: -0.02em;
  color: var(--v5-ink);
}
.me-cell-zero {
  color: var(--v5-ink-4);
}
.me-cell-arrow {
  color: var(--v5-ink-2);
}
.me-cell-l {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}

/* 入口行 */
.me-rows {
  margin: 12px 16px 0;
  border-bottom: 1px solid var(--v5-hair);
}
.me-row {
  height: 48px;
  display: flex;
  align-items: center;
  gap: 12px;
  border-top: 1px solid var(--v5-hair);
  color: var(--v5-ink-2);
}
.me-row-t {
  flex: 1;
  font-size: 17px;
  font-weight: 500;
  color: var(--v5-ink);
}

/* 客服 | 反馈 | 关于 */
.me-links {
  margin: 16px 16px 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.me-link {
  height: 44px;
  padding: 0 16px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  font-size: 15px;
}
.me-sep {
  width: 1px;
  height: 12px;
  flex: 0 0 auto;
  background: rgba(17, 17, 17, 0.22);
}

/* 账号操作：危险操作＝浅色键 + 红字 */
/* 版本号：数字/日期用系统字（品牌字体子集只收首屏上屏字） */
/* 给 TabBar 留位：8 + 44 + max(24px, 安全区)，再多留 12 呼吸 */
.me-tab-space {
  height: calc(64px + max(24px, env(safe-area-inset-bottom)));
}
