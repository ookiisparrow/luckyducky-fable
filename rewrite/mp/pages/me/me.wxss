/* 我（v5「字重」稿 D1） */
/* 滚动容器：退出提醒的 page-container 武装态冻结页面级滚动（决策§30），滚动改在 scroll-view 内发生。
   须填满视口——height 而非 min-height（scroll-view 靠固定高度才产生内部滚动）。 */
.me-scroll {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--v5-canvas);
}
.me-bar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 10;
  background: var(--v5-canvas);
}
.me-head {
  height: 44px;
  padding: 0 104px 0 16px;
  display: flex;
  align-items: center;
}
.me-title {
  font-size: 20px;
  font-weight: 700;
}
/* 小鸭蛋：顶栏下 groundGap 处落地（屏高<700 为 56、其余 120·lib/ground·全站同一条地面线） */
.me-egg {
  padding: 0 16px 12px;
}

/* 身份行 */
.me-id {
  padding: 8px 16px 0;
  display: flex;
  align-items: center;
  gap: 16px;
}
.me-av {
  width: 64px;
  height: 64px;
  flex: 0 0 auto;
  overflow: hidden;
  background: var(--v5-sunk);
}
/* 头像换头像能力键（去掉 button 默认样式）+ 右下角「换」小键（同编辑资料页 .pe-av-k·按下下沉） */
.me-av-btn {
  position: relative;
  flex: 0 0 auto;
  width: 64px;
  height: 64px;
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: normal;
  overflow: visible;
}
.me-av-btn::after {
  border: none;
}
.me-av-k {
  position: absolute;
  right: -6px;
  bottom: -6px;
  width: 24px;
  height: 24px;
  padding: 0;
  font-size: 12px;
  font-weight: 500; /* 圆体只 500/700/900 */
}
.me-av-down .me-av-k {
  transform: translateY(1px);
  background: var(--v5-press);
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.12), 0 0 0 1px var(--v5-hair);
  transition: transform 60ms ease-out, box-shadow 60ms ease-out, background-color 60ms ease-out;
}
.me-av-out {
  background: repeating-linear-gradient(135deg, var(--v5-sunk) 0 5px, var(--v5-sunk-2) 5px 10px);
}
.me-av-img {
  width: 100%;
  height: 100%;
  display: block;
}
.me-id-t {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.me-nick {
  font-size: 20px;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 小键（高 32）：编辑 / 登录 / 重试 / 扫码激活 */
.me-mini {
  position: relative;
  height: 32px;
  padding: 0 12px;
  flex: 0 0 auto;
}
/* 热区扩到 44px（上下各 6px·左右同扩）：透明伪元素随键接住点按，键本身视觉不变 */
.me-mini::after {
  content: '';
  position: absolute;
  top: -6px;
  bottom: -6px;
  left: -6px;
  right: -6px;
}
.me-mini-weak {
  font-size: 13px;
  font-weight: 500; /* 圆体不出细体字重（只 500/700/900·字体瘦身） */
  color: var(--v5-ink-2);
}

/* 继续学习卡 */
.me-card {
  margin: 24px 16px 0;
  padding: 16px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.me-thumb {
  width: 52px;
  height: 52px;
  flex: 0 0 auto;
  background: repeating-linear-gradient(135deg, var(--v5-sunk) 0 5px, var(--v5-sunk-2) 5px 10px);
}
.me-card-t {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.me-card-sub {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.me-card-main {
  font-size: 17px;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.me-card-grow {
  flex: 1;
  min-width: 0;
}
.me-play {
  width: 44px;
  padding: 0 0 0 2px;
  flex: 0 0 auto;
}
/* 按住继续学习卡：卡片不变色，右侧墨黑播放键下沉（同 app.wxss .k-ink-down；hover-class 只能挂在卡上，借后代选择器落到键帽） */
.me-card-down .me-play {
  transform: translateY(2px);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), inset 0 -1px 0 var(--v5-key-seat), 0 0 0 var(--v5-ink),
    0 1px 2px -1px rgba(0, 0, 0, 0.35);
  transition: transform 60ms ease-out, box-shadow 60ms ease-out;
}
.me-skel-l {
  width: 60%;
  height: 13px;
  border-radius: 4px;
}
.me-skel-s {
  width: 80%;
  height: 17px;
  border-radius: 4px;
}

/* 订单四格 */
.me-grid {
  margin: 12px 16px 0;
  display: flex;
  gap: 4px;
}
.me-cell {
  flex: 1;
  min-width: 0;
  height: 56px;
  padding: 0 4px;
  flex-direction: column;
  gap: 4px;
}
.me-cell-top {
  height: 22px;
  display: flex;
  align-items: center;
  gap: 4px;
}
.me-cell-n {
  font-size: 17px;
  font-weight: 500;
  letter-spacing: -0.02em;
  color: var(--v5-ink);
}
.me-cell-zero {
  color: var(--v5-ink-2);
}
.me-cell-arrow {
  color: var(--v5-ink-2);
}

/* 入口行 */
.me-rows {
  margin: 12px 16px 0;
  border-bottom: 1px solid var(--v5-hair);
}
.me-row {
  height: 48px;
  display: flex;
  align-items: center;
  gap: 12px;
  border-top: 1px solid var(--v5-hair);
  color: var(--v5-ink-2);
}
.me-row-t {
  flex: 1;
  font-size: 17px;
  font-weight: 400;
  color: var(--v5-ink);
}

/* 客服 | 反馈 | 关于 */
.me-links {
  margin: 16px 16px 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.me-link {
  height: 44px;
  padding: 0 16px;
  display: flex;
  align-items: center;
  font-size: 15px;
  font-weight: 400;
}
.me-sep {
  width: 1px;
  height: 12px;
  flex: 0 0 auto;
  background: rgba(17, 17, 17, 0.22);
}

/* 账号操作：危险操作＝浅色键 + 红字 */
/* 版本号：数字/日期用系统字（品牌字体子集只收首屏上屏字） */
/* 给 TabBar 留位：8 + 44 + max(24px, 安全区)，再多留 12 呼吸 */
.me-tab-space {
  height: calc(64px + max(24px, env(safe-area-inset-bottom)));
}
