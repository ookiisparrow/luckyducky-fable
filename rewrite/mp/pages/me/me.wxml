<!-- 我（v5「字重」稿 D1）：标题 → 小鸭蛋（学完一门课孵化）→ 身份行 → 继续学习卡 → 订单四格 → 入口行 → 客服/反馈/关于 → 账号操作。
     整页内容套 <scroll-view>：退出提醒的 page-container 武装态会冻结页面级滚动（决策§30·见 utils/exitGuard），
     滚动须发生在 scroll-view 内部。login-sheet/page-container 留在外层当兄弟（浮层不随内容滚）。 -->
<scroll-view class="me-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
<view class="me" style="padding-top: {{statusBarHeight}}px">
  <view class="me-head"><text class="me-title">我</text></view>

  <!-- 小鸭蛋：hatchKey 非空＝有一门课全部看完 → 孵化；按 hatchKey 做 key，孵化/换课时整个重挂（组件只在 ready 读参数） -->
  <view class="me-egg">
    <block wx:for="{{[hatchKey]}}" wx:key="*this">
      <px-ground kind="egg" hatched="{{!!item}}" hatch-key="{{item}}" />
    </block>
  </view>

  <!-- 身份行：已登录＝头像昵称 + 编辑；登出态＝占位 + 登录 -->
  <view class="me-id">
    <view class="me-av {{loggedIn ? '' : 'me-av-out'}}">
      <image wx:if="{{loggedIn && avatar}}" class="me-av-img" src="{{avatar}}" mode="aspectFill" />
      <image wx:elif="{{loggedIn}}" class="me-av-img" src="/static/hero-full.jpg" mode="aspectFill" />
    </view>
    <view class="me-id-t">
      <text class="me-nick">{{nickname}}</text>
      <text wx:if="{{!loggedIn}}" class="me-id-sub">登录后同步订单与学习进度</text>
    </view>
    <view wx:if="{{loggedIn}}" class="k k-flat me-mini me-mini-weak" hover-class="k-flat-down" hover-stay-time="100" bind:tap="onEditProfile">编辑</view>
    <view wx:else class="k k-light me-mini" hover-class="k-light-down" hover-stay-time="100" bind:tap="onLoginTap">登录</view>
  </view>

  <!-- 继续学习：有卡 / 取数失败（失败≠没进度，不显假空态）/ 真无课（contLoaded 后）/ 加载中骨架 -->
  <view wx:if="{{cont}}" class="me-card" hover-class="k-row-down" bind:tap="onContinue">
    <view class="me-thumb"></view>
    <view class="me-card-t">
      <text class="me-card-sub">{{cont.courseTitle}}</text>
      <text class="me-card-main">{{cont.lessonName}}</text>
    </view>
    <view class="k k-ink me-play"><px-i name="play" /></view>
  </view>
  <view wx:elif="{{contFailed}}" class="me-card">
    <px-anim name="signal" size="2" />
    <text class="me-card-main me-card-grow">没连上网络</text>
    <view class="k k-light me-mini" hover-class="k-light-down" hover-stay-time="100" bind:tap="onRetryCont">重试</view>
  </view>
  <view wx:elif="{{contLoaded}}" class="me-card">
    <text class="me-card-main me-card-grow">还没有学习记录</text>
    <view class="k k-light me-mini" hover-class="k-light-down" hover-stay-time="100" bind:tap="onActivate">扫码激活</view>
  </view>
  <view wx:else class="me-card">
    <view class="me-thumb skel"></view>
    <view class="me-card-t">
      <view class="skel me-skel-l"></view>
      <view class="skel me-skel-s"></view>
    </view>
  </view>

  <!-- 订单四格：三格带 data-tab 直落分栏；「全部订单」不带 tab（order-list.ts query.tab 契约）。订单数没有现成数据，只放字 -->
  <view class="me-grid">
    <view class="k k-flat me-cell" data-tab="pending" bind:tap="onOrders" hover-class="k-flat-down" hover-stay-time="100">待支付</view>
    <view class="k k-flat me-cell" data-tab="paid" bind:tap="onOrders" hover-class="k-flat-down" hover-stay-time="100">待发货</view>
    <view class="k k-flat me-cell" data-tab="shipped" bind:tap="onOrders" hover-class="k-flat-down" hover-stay-time="100">待收货</view>
    <view wx:if="{{entries.orders.visible}}" class="k k-flat me-cell" bind:tap="onOrders" hover-class="k-flat-down" hover-stay-time="100">
      <text>{{entries.orders.label}}</text><px-i name="arrow" />
    </view>
  </view>

  <!-- 入口行（标题/可见性走 CMS entries） -->
  <view class="me-rows">
    <view wx:if="{{entries.courses.visible}}" class="me-row" hover-class="k-row-down" bind:tap="onCourses">
      <text class="me-row-t">{{entries.courses.label}}</text><px-i name="arrow" />
    </view>
    <view wx:if="{{entries.activate.visible}}" class="me-row" hover-class="k-row-down" bind:tap="onActivate">
      <text class="me-row-t">{{entries.activate.label}}</text><px-i name="arrow" />
    </view>
    <view wx:if="{{entries.aftersales.visible}}" class="me-row" hover-class="k-row-down" bind:tap="onAfterSales">
      <text class="me-row-t">{{entries.aftersales.label}}</text><px-i name="arrow" />
    </view>
    <view wx:if="{{entries.address.visible}}" class="me-row" hover-class="k-row-down" bind:tap="onAddress">
      <text class="me-row-t">{{entries.address.label}}</text><px-i name="arrow" />
    </view>
    <!-- 数据共享授权（隐私政策承诺可撤回·合规入口·设计稿未画，放入口行末） -->
    <view wx:if="{{entries.consent.visible}}" class="me-row" hover-class="k-row-down" bind:tap="onConsent">
      <text class="me-row-t">{{entries.consent.label}}</text><px-i name="arrow" />
    </view>
  </view>

  <view class="me-links">
    <view wx:if="{{entries.kefu.visible}}" class="me-link" hover-class="k-row-down" bind:tap="onKefu">{{entries.kefu.label}}</view>
    <view wx:if="{{entries.kefu.visible && entries.feedback.visible}}" class="me-sep"></view>
    <view wx:if="{{entries.feedback.visible}}" class="me-link" hover-class="k-row-down" bind:tap="onFeedback">{{entries.feedback.label}}</view>
    <view wx:if="{{(entries.kefu.visible || entries.feedback.visible) && entries.about.visible}}" class="me-sep"></view>
    <view wx:if="{{entries.about.visible}}" class="me-link" hover-class="k-row-down" bind:tap="onAbout">{{entries.about.label}}</view>
  </view>

  <!-- 账号操作（仅已登录）：退出登录（清本地登录 hint·openid 身份与服务端订单/学习不受影响）；
       删除资料（隐私政策第六条·两次确认在 ts·危险操作＝浅色键 + 红字）。文案不用「注销账户」——那三字不在「我」页首屏字体。 -->
  <view wx:if="{{loggedIn}}" class="me-acct">
    <view wx:if="{{loggedIn}}" class="k k-light me-acct-k" hover-class="k-light-down" hover-stay-time="100" bind:tap="onLogout">退出登录</view>
    <view wx:if="{{loggedIn}}" class="k k-light me-acct-k me-danger" hover-class="k-light-down" hover-stay-time="100" bind:tap="onDeleteAccount">删除资料</view>
    <text class="me-note">删除后学习记录和地址都会没有，订单还在</text>
  </view>

  <view class="me-ver">
    <text>{{versionLine}}</text>
    <text wx:if="{{versionDetail}}">{{versionDetail}}</text>
  </view>
  <view class="me-tab-space"></view>
</view>
</scroll-view>

<!-- 登录授权半屏（R1·软门槛）：未同意登录进「我」页弹出、可「暂不登录」关掉继续逛·经 lib/loginGate 单例驱动 -->
<login-sheet bind:login="onLoggedIn" />

<!-- 误触退出提醒（决策§30）：隐形容器武装拦第一次返回 →「再按一次退出」·仅安卓返回键·见 utils/exitGuard -->
<page-container show="{{exitGuardArmed}}" overlay="{{false}}" duration="{{0}}" bindbeforeleave="onExitGuardBeforeLeave" />
