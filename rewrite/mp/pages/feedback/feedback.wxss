/* 意见反馈（v5「字重」稿 D4） */
page {
  background: var(--v5-canvas);
  color: var(--v5-ink);
}
/* 整页一列：顶栏 + 滚动内容 + 底坞（同 checkout·放弃确认武装时页面级滚动被冻，只让中间 scroll-view 滚） */
.fb-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.fb-scroll {
  flex: 1;
  height: 0;
}
.fb {
  padding: 4px 16px 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.fb-title {
  padding-bottom: 4px;
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.01em;
}
.fb-cats {
  padding: 4px;
  border-radius: 8px;
  display: flex;
  gap: 4px;
}
.fb-cat {
  flex: 1;
  min-width: 0;
  height: 36px;
  padding: 0 8px;
}
.fb-cat-off {
  font-weight: 500; /* 圆体不出细体字重（只 500/700/900·字体瘦身） */
  color: var(--v5-ink-2);
}
.fb-area-wrap {
  position: relative;
}
.fb-area {
  display: block;
  width: 100%;
  height: 140px;
  padding: 12px 16px 28px;
  font-size: 17px;
  font-weight: 500;
  line-height: 1.6;
  color: var(--v5-ink);
}
.fb-count {
  position: absolute;
  right: 12px;
  bottom: 10px;
  font-size: 13px;
  letter-spacing: -0.02em;
  color: var(--v5-ink-2);
  pointer-events: none;
}
.fb-field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.fb-label {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.fb-input {
  width: 100%;
  height: 44px;
  padding: 0 16px;
  font-size: 17px;
  font-weight: 500;
  color: var(--v5-ink);
}
.fb-ph {
  color: var(--v5-ink-4);
}
.fb-dock {
  flex: 0 0 auto;
  padding: 12px 16px max(28px, env(safe-area-inset-bottom));
  display: flex;
  gap: 8px;
  background: var(--v5-canvas);
}
.fb-submit {
  flex: 1;
}
