/* 关于我们（v5 稿 D5） */
.ab {
  padding: 12px 16px 16px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.ab-logo {
  width: 58px; /* wordmark 70:34 → 高 28 */
  height: 28px;
}
.ab-lead {
  font-size: 17px;
  font-weight: 500;
  line-height: 1.7;
}
.ab-sec {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.ab-h {
  font-size: 17px;
  font-weight: 600;
}
.ab-p {
  font-size: 17px;
  font-weight: 500;
  line-height: 1.65;
  color: var(--v5-ink-2);
}

/* 底部：两行链接（48 高·发丝线）+ 版本行，固定在最底 */
.ab-dock-space {
  height: calc(136px + max(28px, env(safe-area-inset-bottom)));
}
.ab-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 16px max(28px, env(safe-area-inset-bottom));
  background: var(--v5-canvas);
}
.ab-row {
  height: 48px;
  display: flex;
  align-items: center;
  gap: 12px;
  border-top: 1px solid var(--v5-hair);
}
.ab-row-t {
  flex: 1;
  font-size: 17px;
  font-weight: 500;
}
.ab-ver {
  padding-top: 16px;
  text-align: center;
  font-size: 13px;
  color: var(--v5-ink-2);
}
