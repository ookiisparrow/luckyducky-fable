<!-- 关于我们（v5 稿 D5）：左对齐 wordmark + 自述 + CMS 段落；底部两条合规链接行 + 等宽版本行。 -->
<v5-nav title="关于我们" />

<view class="ab">
  <image class="ab-logo" src="/static/logo-wordmark.svg" mode="aspectFit" aria-label="{{brand}}" />
  <text class="ab-lead t-sys">{{lead}}</text>
  <!-- wx:key 用 title（CMS 段落·标题唯一）：mapAbout 产出 {title,body} 对象 -->
  <view class="ab-sec" wx:for="{{sections}}" wx:key="title">
    <text class="t-sys ab-h">{{item.title}}</text>
    <text class="ab-p t-sys">{{item.body}}</text>
  </view>
</view>

<view class="ab-dock-space"></view>
<view class="ab-dock">
  <view class="ab-row" hover-start-time="20" hover-class="k-row-down" bind:tap="onUserAgreement">
    <text class="ab-row-t">用户协议</text>
    <px-i name="arrow" tone="var(--v5-ink-2)" />
  </view>
  <view class="ab-row" hover-start-time="20" hover-class="k-row-down" bind:tap="onPrivacy">
    <text class="ab-row-t">隐私政策</text>
    <px-i name="arrow" tone="var(--v5-ink-2)" />
  </view>
  <view class="ab-ver mono">{{version}}</view>
</view>
