<!-- 用户协议 / 隐私政策（v5 稿 D6）：大标题 + 等宽更新日期 + 逐条条款（正文原样·只换版式）；
     隐私政策底部固定「管理数据共享授权」行。 -->
<v5-nav title="{{doc.title}}" />

<view class="ag">
  <view class="ag-head">
    <text class="ag-title">{{doc.title}}</text>
    <text class="ag-updated mono">更新日期：{{doc.updated}}</text>
  </view>
  <text class="ag-p t-sys">{{doc.intro}}</text>

  <!-- 条款正文（逐条法律文本原样） -->
  <view class="ag-art" wx:for="{{doc.articles}}" wx:key="title">
    <text class="t-sys ag-h">{{item.title}}</text>
    <text class="ag-p t-sys {{item.important ? 'ag-p-key' : ''}}">{{item.body}}</text>
  </view>

  <text class="t-sys ag-note">如对本条款有任何疑问，可通过本小程序客服与我们联系。</text>
  <view class="ag-row" hover-start-time="20" hover-class="k-row-down" bind:tap="onKefu">
    <text class="ag-row-t">联系客服</text>
    <px-i name="arrow" tone="var(--v5-ink-2)" />
  </view>
  <!-- 删除个人资料（隐私政策第六条·§39）：放正文末尾——读到底才看得到；已解锁课程与学习进度保留 -->
  <view wx:if="{{isPrivacy}}" class="ag-row" hover-start-time="20" hover-class="k-row-down" bind:tap="onDeleteData">
    <text class="ag-row-t ag-danger">删除个人资料</text>
    <px-i name="arrow" tone="var(--v5-ink-2)" />
  </view>
</view>

<!-- 隐私政策：数据共享授权管理入口 -->
<block wx:if="{{isPrivacy}}">
  <view class="ag-dock-space"></view>
  <view class="ag-dock">
    <view class="ag-row" hover-start-time="20" hover-class="k-row-down" bind:tap="onConsent">
      <text class="ag-row-t">管理数据共享授权</text>
      <px-i name="arrow" tone="var(--v5-ink-2)" />
    </view>
  </view>
</block>
<px-fx id="fx" />
