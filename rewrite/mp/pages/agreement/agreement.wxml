<!-- 用户协议 / 隐私政策（v5 稿 D6）：大标题 + 等宽更新日期 + 逐条条款（正文原样·只换版式）；
     隐私政策底部固定「管理数据共享授权」行。 -->
<v5-nav title="{{doc.title}}" />

<view class="ag">
  <view class="ag-head">
    <text class="ag-title">{{doc.title}}</text>
    <text class="ag-updated mono">更新日期：{{doc.updated}}</text>
  </view>
  <text class="ag-p t-sys">{{doc.intro}}</text>

  <!-- 条款正文（逐条法律文本原样） -->
  <view class="ag-art" wx:for="{{doc.articles}}" wx:key="title">
    <text class="ag-h">{{item.title}}</text>
    <text class="ag-p t-sys">{{item.body}}</text>
  </view>

  <text class="ag-note">如对本条款有任何疑问，可通过本小程序客服与我们联系。</text>
</view>

<!-- 隐私政策：数据共享授权管理入口 -->
<block wx:if="{{isPrivacy}}">
  <view class="ag-dock-space"></view>
  <view class="ag-dock">
    <view class="ag-row" hover-class="k-row-down" bind:tap="onConsent">
      <text class="ag-row-t">管理数据共享授权</text>
      <px-i name="arrow" tone="#62625c" />
    </view>
  </view>
</block>
