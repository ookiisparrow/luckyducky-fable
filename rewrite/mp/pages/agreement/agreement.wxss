/* 用户协议 / 隐私政策（v5 稿 D6）：只管版式不动内容。 */
page {
  background: var(--v5-canvas);
  color: var(--v5-ink);
}
.ag {
  padding: 4px 16px 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.ag-head {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.ag-title {
  font-size: 24px;
  font-weight: 700;
}
.ag-updated {
  font-size: 13px;
  color: var(--v5-ink-2);
}
.ag-art {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.ag-h {
  font-size: 17px;
  font-weight: 500;
}
.ag-p {
  font-size: 17px;
  font-weight: 500;
  line-height: 1.65;
  color: var(--v5-ink-2);
}
.ag-note {
  font-size: 13px;
  font-weight: 300;
  line-height: 1.6;
  color: var(--v5-ink-2);
}

.ag-dock-space {
  height: calc(50px + max(28px, env(safe-area-inset-bottom)));
}
.ag-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 16px max(28px, env(safe-area-inset-bottom));
  background: var(--v5-canvas);
}
.ag-row {
  height: 48px;
  display: flex;
  align-items: center;
  gap: 12px;
  border-top: 1px solid var(--v5-hair);
  border-bottom: 1px solid var(--v5-hair);
}
.ag-row-t {
  flex: 1;
  font-size: 17px;
  font-weight: 500;
}
