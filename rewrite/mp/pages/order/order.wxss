/* 订单详情（v5「字重」稿 B2） */
page {
  background: var(--v5-canvas);
  color: var(--v5-ink);
}
/* 小货车：顶栏下 120px 处落地（全站同一条地面线） */
.od-truck {
  padding: 120px 16px 12px;
}
.od-body {
  padding: 0 16px 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.od-card {
  padding: 16px;
  border-radius: 8px;
  background: #ffffff;
  box-shadow: 0 0 0 1px var(--v5-hair);
}
.od-k {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}

/* 状态 + 四步进度 */
.od-state {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.od-state-l {
  display: flex;
  align-items: center;
  gap: 12px;
}
.od-head {
  font-size: 20px;
  font-weight: 700;
}
.od-sub {
  display: block;
  margin-top: 4px;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.od-steps {
  margin-top: 16px;
  display: flex;
  align-items: flex-start;
}
.od-step {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}
/* 步骤连线：2px 虚线（设计规范·像素小元素），走过的墨色、未到的灰 */
.od-line {
  position: absolute;
  top: 6px;
  right: calc(50% + 10px);
  width: calc(100% - 20px);
  height: 2px;
  background: repeating-linear-gradient(90deg, #c9c9c2 0 2px, transparent 2px 4px);
}
.od-line-on {
  background: repeating-linear-gradient(90deg, var(--v5-ink) 0 2px, transparent 2px 4px);
}
.od-node {
  position: relative;
  height: 14px;
  display: flex;
  align-items: center;
}
.od-step-t {
  font-size: 13px;
  font-weight: 500;
}
.od-step-cur {
  color: var(--v5-violet-text);
}
.od-step-todo {
  font-weight: 300;
  color: var(--v5-ink-3);
}

/* 物流 */
.od-logi-top,
.od-logi-bot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}
.od-logi-bot {
  margin-top: 8px;
}
.od-logi-no {
  display: flex;
  align-items: baseline;
  gap: 8px;
  min-width: 0;
}
.od-track {
  font-size: 15px;
}
.od-more {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 0 0 auto;
  font-size: 13px;
  font-weight: 300;
}
.od-mini {
  height: 28px;
  padding: 0 10px;
  font-size: 13px;
  font-weight: 500; /* 圆体不出细体字重（只 500/700/900·字体瘦身） */
  flex: 0 0 auto;
}

/* 地址 */
.od-who {
  margin-top: 8px;
  display: flex;
  align-items: baseline;
  gap: 8px;
  font-size: 17px;
  font-weight: 500;
}
.od-phone {
  font-size: 15px;
  color: var(--v5-ink-2);
}
.od-where {
  display: block;
  margin-top: 2px;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}

/* 商品 + 金额 */
.od-goods {
  padding-top: 4px;
}
.od-item {
  padding: 12px 0;
  display: flex;
  align-items: center;
  gap: 12px;
  border-bottom: 1px solid var(--v5-hair);
}
.od-thumb {
  width: 44px;
  height: 44px;
  flex: 0 0 auto;
  border-radius: 4px;
  overflow: hidden;
  background: repeating-linear-gradient(135deg, var(--v5-sunk) 0 5px, #e3e3df 5px 10px);
}
.od-thumb-img {
  display: block;
  width: 100%;
  height: 100%;
}
.od-item-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.od-item-name {
  font-size: 17px;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.od-item-sub {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.od-item-r {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
}
.od-item-price {
  font-size: 15px;
  font-weight: 600;
}
.od-sum {
  padding-top: 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.od-sum-row {
  display: flex;
  align-items: center;
  gap: 8px;
}
.od-leader {
  flex: 1;
  height: 2px;
  background: repeating-linear-gradient(90deg, #c9c9c2 0 2px, transparent 2px 4px);
}
.od-v {
  font-size: 15px;
}
.od-total-k {
  font-size: 17px;
  font-weight: 500;
}
.od-total-v {
  font-size: 15px;
  font-weight: 600;
}

/* 订单信息 */
.od-info {
  padding: 4px 4px 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.od-info-row {
  min-height: 28px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.od-info-v {
  flex: 1;
  min-width: 0;
  font-size: 13px;
  color: var(--v5-ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 底部：返回 48 + 次 1 : 主 1.6 */
.od-dock-space {
  height: calc(72px + max(28px, env(safe-area-inset-bottom)));
}
.od-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12px 16px max(28px, env(safe-area-inset-bottom));
  display: flex;
  gap: 8px;
  background: var(--v5-canvas);
}
.od-back {
  flex: 0 0 48px;
  padding: 0;
  font-size: 15px;
}
.od-side {
  flex: 1;
  min-width: 0;
}
.od-main {
  flex: 1.6;
  min-width: 0;
}
.od-danger {
  color: var(--v5-err-text);
}
.od-busy {
  opacity: 0.8;
}

/* 骨架 / 失败 / 不存在 */
.od-skel {
  padding: 136px 16px 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.od-skel-bar {
  height: 14px;
  margin-top: 8px;
}
.od-state-page {
  padding: 120px 16px 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}
.od-state-t {
  font-size: 17px;
  font-weight: 500;
}
.od-retry {
  margin-top: 8px;
  min-width: 120px;
}
