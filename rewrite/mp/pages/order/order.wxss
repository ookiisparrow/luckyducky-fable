/* 订单详情（v5「字重」稿 B2） */
page {
  background: var(--v5-canvas);
  color: var(--v5-ink);
}
/* 小货车：顶栏下 120px 处落地（全站同一条地面线） */
.od-truck {
  padding: 120px 16px 12px;
}
.od-body {
  padding: 0 16px 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.od-card {
  padding: 16px;
  border-radius: 8px;
  background: var(--v5-surface);
  box-shadow: 0 0 0 1px var(--v5-hair);
}
.od-k {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}

/* 状态 + 四步进度 */
.od-state {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}
.od-state-l {
  display: flex;
  align-items: center;
  gap: 12px;
}
.od-head {
  font-size: 20px;
  font-weight: 700;
}
/* 状态卡右侧小字：次要灰；待支付/待退款琥珀；剩不到 1 分钟 / 支付异常红（设计稿 subC） */
.od-sub {
  flex: 0 1 auto;
  min-width: 0;
  text-align: right;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.od-sub-warn {
  color: var(--v5-warn-text);
}
.od-sub-err {
  color: var(--v5-err-text);
}
/* 待退款 / 支付异常说明行：分隔线 + 状态灯 + 13/300 说明 */
.od-warn {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid var(--v5-hair);
  display: flex;
  align-items: flex-start;
  gap: 8px;
}
.od-warn-led {
  margin-top: 4px;
}
.od-warn-t {
  flex: 1;
  font-size: 13px;
  font-weight: 300;
  line-height: 1.5;
}
/* 有售后记录：「查看售后进度 →」行（分隔线 + 右对齐小字，同物流卡「查看物流」口径） */
.od-as-go {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid var(--v5-hair);
  justify-content: flex-end;
}
.od-steps {
  margin-top: 16px;
  display: flex;
  align-items: flex-start;
}
.od-step {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}
/* 步骤连线：2px 虚线（设计规范·像素小元素），走过的墨色、未到的灰 */
.od-line {
  position: absolute;
  top: 6px;
  right: calc(50% + 10px);
  width: calc(100% - 20px);
  height: 2px;
  background: repeating-linear-gradient(90deg, var(--v5-rule) 0 2px, transparent 2px 4px);
}
.od-line-on {
  background: repeating-linear-gradient(90deg, var(--v5-ink) 0 2px, transparent 2px 4px);
}
.od-node {
  position: relative;
  height: 14px;
  display: flex;
  align-items: center;
}
.od-step-t {
  font-size: 13px;
  font-weight: 500;
}
/* 步骤文字（设计稿 steps fw/c）：走过的黑 500、当前黑 700、未到 #62625c 500 */
.od-step-cur {
  font-weight: 700;
}
.od-step-todo {
  color: var(--v5-ink-2);
}

/* 物流 */
.od-logi-top,
.od-logi-bot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}
.od-logi-bot {
  margin-top: 8px;
}
.od-logi-no {
  display: flex;
  align-items: baseline;
  gap: 8px;
  min-width: 0;
}
.od-track {
  font-size: 15px;
}
.od-more {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 0 0 auto;
  font-size: 13px;
  font-weight: 300;
}
.od-mini {
  position: relative;
  height: 28px;
  padding: 0 10px;
  font-size: 13px;
  font-weight: 500; /* 圆体不出细体字重（只 500/700/900·字体瘦身） */
  flex: 0 0 auto;
}
/* 已评价（拍板 6·设计稿灰底标签·不可点，不是键） */
.od-reviewed {
  display: flex;
  align-items: center;
  border-radius: 6px;
  background: var(--v5-sunk);
  color: var(--v5-ink-2);
}
/* 热区补到 44 高（上下各让 8px·看不见，视觉仍 28 高） */

/* 地址 */
.od-who {
  margin-top: 8px;
  display: flex;
  align-items: baseline;
  gap: 8px;
  font-size: 17px;
  font-weight: 500;
}
.od-phone {
  font-size: 15px;
  color: var(--v5-ink-2);
}
.od-where {
  display: block;
  margin-top: 2px;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}

/* 商品 + 金额 */
.od-goods {
  padding-top: 4px;
}
.od-item {
  padding: 12px 0;
  display: flex;
  align-items: center;
  gap: 12px;
  border-bottom: 1px solid var(--v5-hair);
}
.od-thumb {
  width: 44px;
  height: 44px;
  flex: 0 0 auto;
  border-radius: 4px;
  overflow: hidden;
  background: repeating-linear-gradient(135deg, var(--v5-sunk) 0 5px, var(--v5-sunk-2) 5px 10px);
}
.od-thumb-img {
  display: block;
  width: 100%;
  height: 100%;
}
.od-item-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.od-item-name {
  font-size: 17px;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.od-item-sub {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
/* 商品行售后小标（退款中 / 已退款） */
.od-as-tag {
  align-self: flex-start;
  margin-top: 2px;
  padding: 0 6px;
  font-size: 12px;
  line-height: 18px;
  border-radius: 4px;
  background: var(--v5-sunk);
  color: var(--v5-ink-2);
}
.od-item-r {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
}
.od-item-price {
  font-size: 15px;
  font-weight: 600;
}
.od-sum {
  padding-top: 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.od-sum-row {
  display: flex;
  align-items: center;
  gap: 8px;
}
.od-leader {
  flex: 1;
  height: 2px;
  background: repeating-linear-gradient(90deg, var(--v5-rule) 0 2px, transparent 2px 4px);
}
.od-v {
  font-size: 15px;
}
.od-total-k {
  font-size: 17px;
  font-weight: 500;
}
.od-total-v {
  font-size: 15px;
  font-weight: 600;
}

/* 订单信息 */
.od-info {
  padding: 4px 4px 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.od-info-row {
  min-height: 28px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.od-info-v {
  flex: 1;
  min-width: 0;
  font-size: 13px;
  color: var(--v5-ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 底部：返回 48 + 次 1 : 主 1.6 */
.od-dock-space {
  height: calc(72px + max(28px, env(safe-area-inset-bottom)));
}
.od-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12px 16px max(28px, env(safe-area-inset-bottom));
  display: flex;
  gap: 8px;
  background: var(--v5-canvas);
}
.od-back {
  flex: 0 0 48px;
  padding: 0;
  font-size: 17px;
}
.od-side {
  flex: 1;
  min-width: 0;
}
.od-main {
  flex: 1.6;
  min-width: 0;
}
.od-danger {
  position: relative;
  overflow: hidden;
  color: var(--v5-err-text);
}
/* 按住取消：浅红从左往右填满（HOLD_MS 700ms·同购物车按住删除写法） */
.od-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  transform: scaleX(0);
  transform-origin: left;
  background: var(--v5-err-soft);
}
.od-hold-on .od-fill {
  transform: scaleX(1);
  transition: transform 700ms linear;
}
.od-danger-t {
  position: relative;
}
.od-busy {
  opacity: 0.8;
}

/* 骨架 / 失败 / 不存在 */
.od-skel {
  padding: 136px 16px 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.od-skel-bar {
  height: 14px;
  margin-top: 8px;
}
.od-state-page {
  padding: 120px 16px 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}
.od-state-t {
  font-size: 17px;
  font-weight: 500;
}
.od-retry {
  margin-top: 8px;
  min-width: 120px;
}

/* 申请售后半屏（设计稿 main.dc.html 680-688）：z 125、圆角 12、内边距 12/16/28、间距 16 */
.as-root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 125;
}
.as-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}
.as-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 12px 12px 0 0;
  background: var(--v5-canvas);
  padding: 12px 16px max(28px, env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.as-grip {
  align-self: center;
  width: 36px;
  height: 4px;
  border-radius: 2px;
  background: var(--v5-grab);
}
.as-t {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.as-h {
  font-size: 20px;
  font-weight: 700;
}
.as-sub,
.as-cap {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
/* 三段：凹槽里选中＝浅色键带紫灯，其余透明灰字 */
.as-seg {
  padding: 4px;
  border-radius: 8px;
  display: flex;
  gap: 4px;
}
.as-seg-k {
  flex: 1;
  height: 36px;
  padding: 0;
  color: var(--v5-ink-2);
}
.as-seg-k.as-on {
  color: var(--v5-ink);
}
/* 没有可退商品：「退款」段置灰（点了提示原因，不切过去） */
.as-seg-k.as-seg-off {
  color: var(--v5-ink-4);
}
/* 退款不可选 / 被拒说明（+ 联系客服键·拍板 5） */
.as-note {
  margin-top: -8px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.as-note-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.as-block {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.as-kefu {
  flex: 0 0 auto;
  height: 32px;
  padding: 0 12px;
  font-size: 13px;
}
/* 预计退款（拍板 4·云端试算） */
.as-est {
  margin-bottom: -8px;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
  text-align: right;
}
.as-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.as-lines {
  max-height: 128px;
}
.as-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.as-chip {
  height: auto;
  min-height: 36px;
  padding: 4px 12px;
}
/* 商品名一行 + 规格单独一行：名字再长也只截名字，同款不同色靠规格行分得清 */
.as-chip-col {
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.as-chip-t,
.as-chip-spec {
  max-width: 240px;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 15px;
}
.as-chip-spec {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.as-ks {
  display: flex;
  gap: 8px;
}
.as-cancel {
  flex: 1;
}
.as-go {
  flex: 1.6;
}
