<!-- 订单详情（v5「字重」稿 B2）：小货车（姿态随订单态）+ 状态卡（短状态名 + 右侧小字 + 四步进度 + 异常说明）+ 物流卡 + 收货地址 + 商品与金额 + 订单信息；
     底部按状态：返回 + 按住取消/去支付 | 返回 + 申请售后 (+ 确认收货) | 返回 + 联系客服（待退款/支付异常）；已关闭不出底部栏。
     续付(onPay)/按住取消(onCancelStart/Move/End·拍板 7·挪开 10px 作废)/按住撤回售后(onWithdrawStart/Move/End·底部代替申请售后)/确认收货(onConfirm)/申请售后(onAfterSale·自绘半屏)/写评价(onWriteReview·per-line)/
     物流页(onViewLogistics)/复制(onCopyTracking/onCopyOrderNo)/客服(onKefu) 全承接 order.ts。订单行为历史快照·只读。 -->
<v5-nav title="订单详情" />

<view class="od" wx:if="{{vm}}">
  <!-- 整单退完（ended）：订单结束，货车换静止纸箱（同一条地面线·同售后记录页） -->
  <view class="od-truck" style="padding-top: {{groundGap}}px"><px-ground wx:if="{{ended}}" kind="box" /><px-truck wx:else pose="{{truckPose}}" cargo="{{cargo}}" /></view>

  <view class="od-body">
    <!-- 状态卡（UI 审查 15 问 6a）：灯 + 状态名（墨 17/500·与列表同名），下一行完整说明句（灰；只有待支付倒计时深黄） -->
    <view class="od-card px-skin px-card">
      <view class="od-state">
        <view class="od-state-l">
          <px-anim wx:if="{{vm.status === 'pending' && !expired}}" name="hourglass" size="2" />
          <px-i wx:elif="{{asLed}}" name="led" tone="{{asLed.tone}}" halo="{{asLed.halo}}" />
          <text class="od-head">{{head}}</text>
        </view>
        <text class="t-sys od-sub od-sub-{{sub.tone}}" wx:if="{{sub.text}}">{{sub.text}}</text>
      </view>
      <view class="od-steps">
        <view class="od-step" wx:for="{{steps}}" wx:key="label">
          <view wx:if="{{index > 0}}" class="od-line {{item.state === 'todo' ? '' : 'od-line-on'}}"></view>
          <view class="od-node">
            <px-i wx:if="{{item.state === 'done'}}" name="node" tone="var(--v5-ink)" />
            <px-i wx:elif="{{item.state === 'cur'}}" name="nodeCur" tone="var(--v5-violet)" />
            <px-i wx:else name="ring" tone="var(--v5-rule)" />
          </view>
          <text class="t-sys od-step-t {{item.state === 'cur' ? 'od-step-cur' : ''}} {{item.state === 'todo' ? 'od-step-todo' : ''}}">{{item.label}}</text>
        </view>
      </view>
      <!-- 有售后记录（含被拒）：进我的售后看进度（云端退款不改订单状态，进度在售后页） -->
      <view class="t-sys od-more od-as-go hit44" wx:if="{{asHas}}" bind:tap="onGoAfterSales" hover-start-time="20" hover-class="k-row-down" hover-stay-time="100"><text>查看售后进度</text><px-i name="arrow" /></view>
    </view>

    <!-- 物流（有运单号时·真实数据仅运单号+公司，实时轨迹经快递100插件；插件打不开回退复制运单号） -->
    <view class="k-card od-card od-logi px-skin px-card" wx:if="{{vm.trackingNo}}" hover-start-time="20" hover-class="k-card-down" bind:tap="onViewLogistics">
      <view class="od-logi-top">
        <view class="od-logi-no">
          <text class="t-sys od-k t-cap" wx:if="{{vm.shipCompany}}">{{vm.shipCompany}}</text>
          <text class="mono od-track" user-select>{{vm.trackingNo}}</text>
        </view>
        <view class="t-sys od-more"><text>查看物流</text><px-i name="arrow" /></view>
      </view>
      <view class="od-logi-bot">
        <text class="t-sys od-k t-cap">物流状态以承运方为准</text>
        <view class="k k-sm k-flat od-mini hit44" hover-start-time="20" hover-class="k-flat-down" hover-stay-time="100" catch:tap="onCopyTracking" data-k="flat" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">复制</view>
      </view>
    </view>

    <!-- 收货地址（历史快照·只读） -->
    <view class="od-card px-skin px-card" wx:if="{{vm.address}}">
      <text class="t-sys od-k t-cap">收货地址</text>
      <text class="t-sys od-region">{{vm.address.region}}</text>
      <text class="t-sys od-detail">{{vm.address.detail}}</text>
      <view class="od-who">
        <text class="t-sys">{{vm.address.name}}</text>
        <text class="mono od-phone">{{vm.address.phone}}</text>
      </view>
    </view>

    <!-- 商品（只读 ×N）+ 金额 -->
    <view class="od-card od-goods px-skin px-card">
      <view class="od-item" wx:for="{{vm.items}}" wx:key="lineId">
        <view class="od-thumb">
          <image wx:if="{{item.cover}}" class="od-thumb-img" src="{{item.cover}}" mode="aspectFill" lazy-load />
        </view>
        <view class="od-item-mid">
          <text class="t-sys od-item-name">{{item.name}}</text>
          <text class="t-sys od-item-sub t-cap">{{item.spec}}{{item.spec ? ' · ' : ''}}×{{item.qty}}</text>
          <text wx:if="{{lineTags[item.lineId]}}" class="t-sys od-as-tag px-clip-4">{{lineTags[item.lineId]}}</text>
        </view>
        <view class="od-item-r">
          <text class="mono od-item-price">{{item.priceLabel}}</text>
          <!-- 已评价的行：灰底「已评价」标签不可点（拍板 6·设计稿 #ededea 底 #8f8f88 字）；没评的出「写评价」 -->
          <text wx:if="{{vm.status === 'done' && item.reviewed}}" class="od-mini hit44 od-reviewed px-clip-6">已评价</text>
          <view wx:elif="{{vm.status === 'done'}}" class="k k-sm k-light od-mini hit44" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100"
            data-i="{{index}}" catch:tap="onWriteReview" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">写评价</view>
        </view>
      </view>
      <view class="od-sum">
        <view class="od-sum-row" wx:if="{{vm.goodsLabel}}"><text class="t-sys od-k t-cap">商品</text><view class="od-leader"></view><text class="mono od-v">{{vm.goodsLabel}}</text></view>
        <view class="od-sum-row"><text class="t-sys od-k t-cap">运费</text><view class="od-leader"></view><text class="mono od-v">{{vm.shipLabel}}</text></view>
        <view class="od-sum-row"><text class="od-total-k">{{vm.amountTitle}}</text><view class="od-leader"></view><text class="mono od-total-v">{{vm.amountLabel}}</text></view>
      </view>
    </view>

    <!-- 订单信息 -->
    <view class="od-info">
      <view class="od-info-row">
        <text class="t-sys od-k t-cap">订单编号</text>
        <text class="mono od-info-v" user-select>{{vm.id}}</text>
        <view class="k k-sm k-flat od-mini hit44" hover-start-time="20" hover-class="k-flat-down" hover-stay-time="100" bind:tap="onCopyOrderNo" data-k="flat" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">复制</view>
      </view>
      <view class="od-info-row" wx:if="{{vm.createdAtLabel}}">
        <text class="t-sys od-k t-cap">下单时间</text>
        <text class="mono od-info-v">{{vm.createdAtLabel}}</text>
      </view>
    </view>
  </view>

  <view class="od-dock-space" wx:if="{{dock}}"></view>
  <view class="od-dock dock" wx:if="{{dock}}">
    <view class="k k-light k-48 od-back k-sq" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onBack" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i name="back" /></view>
    <block wx:if="{{vm.status === 'pending'}}">
      <!-- 按住 700ms 取消（设计稿 data-hold·键内红色进度条；轻点提示「按住取消订单」） -->
      <view class="od-side" catch:touchstart="onCancelStart" catch:touchmove="onCancelMove" catch:touchend="onCancelEnd" catch:touchcancel="onCancelEnd">
        <view class="k k-light k-48 od-danger {{holding ? 'od-hold-on' : ''}}" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100"
          data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><view class="od-fill"></view><text class="od-danger-t">取消订单</text></view>
      </view>
      <!-- 倒计时归零（expired）：藏「去支付」，状态卡小字已写「已超时」，并自动刷新一次看云端关单 -->
      <view wx:if="{{!expired}}" class="k k-ink k-48 od-main {{paying ? 'od-busy' : ''}}" hover-start-time="20" hover-class="k-ink-down" hover-stay-time="100" bind:tap="onPay" data-k="ink" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">
        <block wx:if="{{paying}}"><px-anim name="loader" size="2" dark /><text>支付中</text></block>
        <text wx:else>去支付</text>
      </view>
    </block>
    <!-- 有申请中的售后：「撤回申请」代替「申请售后」（老板 2026-09-29）——按住 700ms 撤回本单申请中的售后（轻点提示·挪开 10px 作废） -->
    <view wx:if="{{canAfterSale && wdLines.length}}" class="od-side" catch:touchstart="onWithdrawStart" catch:touchmove="onWithdrawMove" catch:touchend="onWithdrawEnd" catch:touchcancel="onWithdrawEnd">
      <view class="k k-light k-48 od-danger {{wdHold ? 'od-hold-on' : ''}}" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100"
        data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><view class="od-fill"></view><text class="od-danger-t">撤回申请</text></view>
    </view>
    <view wx:elif="{{canAfterSale}}" class="k k-light k-48 od-side" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onAfterSale" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">申请售后</view>
    <view wx:if="{{vm.status === 'shipped' && !ended}}" class="k k-ink k-48 od-main" hover-start-time="20" hover-class="k-ink-down" hover-stay-time="100" bind:tap="onConfirm" data-k="ink" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">确认收货</view>
    <view wx:if="{{help}}" class="k k-light k-48 od-side" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onKefu" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">联系客服</view>
  </view>
</view>

<!-- 加载骨架（根因#8·loading 且 vm 空时三分支曾全假→白屏） -->
<view class="od-skel" wx:elif="{{loading}}">
  <view class="od-card px-skin px-card">
    <view class="od-skel-bar skel" style="width: 120px"></view>
    <view class="od-skel-bar skel" style="width: 80%"></view>
  </view>
  <view class="od-card od-item px-skin px-card">
    <view class="od-thumb skel"></view>
    <view class="od-item-mid">
      <view class="od-skel-bar skel" style="width: 60%"></view>
      <view class="od-skel-bar skel" style="width: 36%"></view>
    </view>
  </view>
</view>

<!-- 失败态与不存在分治（根因#14·守卫 rw-mp-list-loadfailed-state）：弱网失败给重试，不误报「订单不存在」 -->
<view class="od-state-page" style="padding-top: {{groundGap}}px" wx:elif="{{!loading && loadFailed}}">
  <px-anim name="signal" size="4" />
  <text class="od-state-t">网络开小差</text>
  <text class="t-sys od-k t-cap">订单没加载出来，请重试</text>
  <view class="k k-light od-retry k-sq" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onRetryLoad" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i name="replay" /></view>
</view>

<!-- 订单不存在 -->
<view class="od-state-page" style="padding-top: {{groundGap}}px" wx:elif="{{!loading}}">
  <text class="od-state-t">订单不存在</text>
  <text class="t-sys od-k t-cap">可能已被删除或不属于当前账号</text>
</view>

<!-- 申请售后半屏（设计稿 sheet aftersales·拍板 7）：退款/换货/补发 三段 + 原因标签（无理由默认） + 多件单选商品 + 预计退款 + 取消/提交。
     只有「退款」调 applyRefund；换货/补发后台无接口，提交键改「联系客服办理」走客服入口。 -->
<view wx:if="{{asOpen}}" class="as-root" catch:touchmove="noop">
  <view class="sh-mask as-mask {{asOut ? 'out' : ''}}" bind:tap="onAsClose"></view>
  <view class="sh-panel as-panel {{asOut ? 'out' : ''}}">
    <view class="as-t">
      <text class="as-h">申请售后</text>
      <block wx:for="{{asLines}}" wx:key="lineId"><text wx:if="{{item.lineId === asLine}}" class="t-sys as-sub t-cap">{{item.name}}{{item.spec ? ' · ' + item.spec : ''}}</text></block>
    </view>
    <view class="well as-seg">
      <view wx:for="{{asTypes}}" wx:key="*this" class="k as-seg-k hit44 {{asType === item ? 'k-light as-on' : ''}} {{asBlock && item === '退款' ? 'as-seg-off' : ''}}" hover-start-time="20" hover-class="{{asType === item ? 'k-light-down' : 'k-flat-down'}}" hover-stay-time="100"
        data-v="{{item}}" bind:tap="onAsType" data-k="{{asType === item ? 'light' : 'flat'}}" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i wx:if="{{asType === item}}" name="led" tone="var(--v5-violet)" />{{item}}</view>
    </view>
    <!-- 没有可退商品（已开课/已申请过/已被拒）：退款段置灰并写原因；换货/补发照常走联系客服。
         被拒的行（拍板 5·被拒维持永久锁）：写清「已被拒绝，有疑问联系客服」+「联系客服」键（带订单上下文复制） -->
    <view wx:if="{{asBlock || asRej}}" class="as-note">
      <view class="as-note-col">
        <text wx:if="{{asBlock}}" class="t-sys as-block t-cap">退款不可选：{{asBlock}}</text>
        <text wx:if="{{asRej}}" class="t-sys as-block t-cap">{{asRej}}：已被拒绝，有疑问联系客服</text>
      </view>
      <view wx:if="{{asRejKefu}}" class="k k-sm k-light as-kefu hit44" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100"
        bind:tap="onAsKefu" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">联系客服</view>
    </view>
    <view class="as-group" wx:if="{{asLines.length > 1}}">
      <text class="t-sys as-cap t-cap">商品</text>
      <scroll-view class="as-lines" scroll-y="{{true}}">
        <view class="as-chips">
          <view wx:for="{{asLines}}" wx:key="lineId" class="k as-chip hit44 hit-wrap {{asLine === item.lineId ? 'k-light' : 'k-flat'}}" hover-start-time="20" hover-class="{{asLine === item.lineId ? 'k-light-down' : 'k-flat-down'}}" hover-stay-time="100"
            data-v="{{item.lineId}}" bind:tap="onAsLine" data-k="{{asLine === item.lineId ? 'light' : 'flat'}}" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i wx:if="{{asLine === item.lineId}}" name="led" tone="var(--v5-violet)" /><view class="as-chip-col"><text class="t-sys as-chip-t">{{item.name}}</text><text wx:if="{{item.spec}}" class="t-sys as-chip-spec">{{item.spec}}</text></view></view>
        </view>
      </scroll-view>
    </view>
    <view class="as-group">
      <text class="t-sys as-cap t-cap">原因</text>
      <view class="as-chips">
        <view wx:for="{{asReasons}}" wx:key="*this" class="k as-chip hit44 hit-wrap {{asReason === item ? 'k-light' : 'k-flat'}}" hover-start-time="20" hover-class="{{asReason === item ? 'k-light-down' : 'k-flat-down'}}" hover-stay-time="100"
          data-v="{{item}}" bind:tap="onAsReason" data-k="{{asReason === item ? 'light' : 'flat'}}" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i wx:if="{{asReason === item}}" name="led" tone="var(--v5-violet)" />{{item}}</view>
      </view>
    </view>
    <!-- 预计退款（拍板 4·云端试算·最终以审核为准）：仅「退款」段 -->
    <text wx:if="{{asEst}}" class="t-sys as-est">{{asEst}}</text>
    <view class="as-ks">
      <view class="k k-light k-48 as-cancel" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onAsClose" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">取消</view>
      <view class="k k-ink k-48 as-go {{asBusy ? 'od-busy' : ''}}" hover-start-time="20" hover-class="k-ink-down" hover-stay-time="100" bind:tap="onAsSubmit" data-k="ink" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">
        <block wx:if="{{asBusy}}"><px-anim name="loader" size="2" dark /><text>提交中</text></block>
        <text wx:elif="{{asType === '退款'}}">提交申请</text>
        <text wx:else>联系客服办理</text>
      </view>
    </view>
  </view>
</view>

<!-- v5 全屏像素特效层（撒花/转场/轻提示·lib/pxFx）：页面根下、不进滚动容器 -->
<px-fx id="fx" />
