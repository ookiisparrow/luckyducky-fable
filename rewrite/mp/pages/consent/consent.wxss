/* 数据共享授权（v5 稿 D7）：声明文案/handler 不动·只换版式。 */
page {
  background: var(--v5-canvas);
  color: var(--v5-ink);
}
.cs {
  padding: 4px 16px 16px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.cs-h {
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.01em;
  line-height: 1.3;
}
.cs-p {
  font-size: 17px;
  font-weight: 500;
  line-height: 1.7;
  color: var(--v5-ink-2);
}
/* 状态牌：浅色键帽外观（不可点）+ LED */
.cs-state {
  justify-content: flex-start;
}
.cs-state-t {
  flex: 1;
  font-size: 17px;
  font-weight: 500;
}
.cs-row {
  height: 48px;
  display: flex;
  align-items: center;
  gap: 12px;
  border-top: 1px solid var(--v5-hair);
  border-bottom: 1px solid var(--v5-hair);
}
.cs-row-t {
  flex: 1;
  font-size: 17px;
  font-weight: 500;
}
.cs-note {
  font-size: 13px;
  font-weight: 300;
  line-height: 1.6;
  color: var(--v5-ink-2);
}

.cs-dock-space {
  height: calc(60px + max(28px, env(safe-area-inset-bottom)));
}
.cs-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12px 16px max(28px, env(safe-area-inset-bottom));
  display: flex;
  gap: 8px;
  background: var(--v5-canvas);
}
/* 撤回：普通浅色键、轻点即撤（撤回同意须与同意同样便捷·不做长按） */
.cs-revoke {
  flex: 1;
}
.cs-main {
  flex: 1.6;
}
.cs-dim {
  opacity: 0.55;
}
