/* 收货地址（v5「字重」稿 A6） */
.ad-title {
  display: block;
  padding: 4px 16px 0;
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.01em;
}
.ad-list {
  margin: 12px 16px 16px;
  border-bottom: 1px solid var(--v5-hair);
}
.ad-row {
  padding: 12px 0;
  display: flex;
  align-items: center;
  gap: 12px;
  border-top: 1px solid var(--v5-hair);
}
/* 像素圆单选（像素化 3a：11×11 格·外形见 px-skin .px-circle-radio(-on)）；选中圆心 px-i dot 居中 */
.ad-radio {
  width: 22px;
  height: 22px;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 0;
}
.ad-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.ad-line1 {
  display: flex;
  align-items: center;
  gap: 8px;
}
/* 地址行三层（UI 审查 15 问 1c：手打的详细地址是全卡唯一重点） */
.ad-region {
  font-size: 13px;
  color: var(--v5-ink-2);
}
.ad-detail {
  font-size: 17px;
  font-weight: 600;
  line-height: 1.4;
  color: var(--v5-ink);
}
.ad-name {
  min-width: 0;
  font-size: 15px;
  font-weight: 400;
  color: var(--v5-ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ad-phone,
.ad-def {
  flex: 0 0 auto; /* 姓名过长时只截姓名，手机号和「默认」不被挤 */
}
.ad-phone {
  font-size: 15px;
  color: var(--v5-ink-2);
}
.ad-def {
  height: 18px;
  padding: 0 4px;
  display: flex;
  align-items: center;
  background: var(--v5-sunk);
  font-size: 13px;
  font-weight: 300;
}
.ad-edit {
  position: relative;
  flex: 0 0 auto;
  height: 32px;
  padding: 0 12px;
  font-size: 13px;
  font-weight: 500; /* 圆体不出细体字重（只 500/700/900·字体瘦身） */
  color: var(--v5-ink-2);
}
/* 「编辑」键热区扩到 ≥44px 高（伪元素·视觉不变） */
.ad-edit::after {
  content: '';
  position: absolute;
  left: -6px;
  right: -6px;
  top: -6px;
  bottom: -6px;
}
.ad-empty {
  padding: 0 0 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}
.ad-empty-t {
  font-size: 17px;
  font-weight: 500;
  color: var(--v5-ink-2);
}
.ad-dock-space {
  height: calc(72px + max(28px, env(safe-area-inset-bottom)));
}
.ad-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12px 16px max(28px, env(safe-area-inset-bottom));
  background: var(--v5-canvas);
}
