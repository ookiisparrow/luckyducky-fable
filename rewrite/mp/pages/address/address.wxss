/* 收货地址（v5「字重」稿 A6） */
page {
  background: var(--v5-canvas);
  color: var(--v5-ink);
}
.ad-title {
  display: block;
  padding: 4px 16px 0;
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.01em;
}
.ad-list {
  margin: 12px 16px 16px;
  border-bottom: 1px solid var(--v5-hair);
}
.ad-row {
  padding: 12px 0;
  display: flex;
  align-items: center;
  gap: 12px;
  border-top: 1px solid var(--v5-hair);
}
.ad-radio {
  width: 22px;
  height: 22px;
  padding: 0;
  flex: 0 0 auto;
  border-radius: 50%;
}
.ad-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.ad-line1 {
  display: flex;
  align-items: center;
  gap: 8px;
}
.ad-name {
  font-size: 17px;
  font-weight: 500;
}
.ad-phone {
  font-size: 15px;
  color: var(--v5-ink-2);
}
.ad-def {
  height: 18px;
  padding: 0 4px;
  border-radius: 4px;
  display: flex;
  align-items: center;
  background: var(--v5-sunk);
  font-size: 13px;
  font-weight: 300;
}
.ad-where {
  font-size: 13px;
  font-weight: 300;
  line-height: 1.5;
  color: var(--v5-ink-2);
}
.ad-edit {
  flex: 0 0 auto;
  height: 32px;
  padding: 0 12px;
  font-size: 13px;
  font-weight: 500; /* 圆体不出细体字重（只 500/700/900·字体瘦身） */
  color: var(--v5-ink-2);
}
.ad-empty {
  padding: 0 0 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}
.ad-empty-t {
  font-size: 17px;
  font-weight: 500;
  color: var(--v5-ink-2);
}
.ad-dock-space {
  height: calc(72px + max(28px, env(safe-area-inset-bottom)));
}
.ad-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12px 16px max(28px, env(safe-area-inset-bottom));
  background: var(--v5-canvas);
}
