<!-- 收货地址（v5「字重」稿 A6）：管理 + 选择两用。
       ?pick=1 结算选地址 → 行首单选圆键，点行＝设默认并返回（结算页 onShow 取默认）；
       管理态 → 点行或「编辑」进编辑页；删除在编辑页按住删除（设计稿：危险操作收进下一级）。 -->
<!-- 顶栏只留返回键：页名由下面的大标题说（原来顶栏小字和大标题重复「收货地址」） -->
<v5-nav />

<view class="ad">
  <text class="ad-title">{{picking ? '选择收货地址' : '收货地址'}}</text>
  <view class="ad-list">
    <view class="ad-row" wx:for="{{list}}" wx:key="id" hover-start-time="20" hover-class="k-row-down" data-id="{{item.id}}" bind:tap="onTapRow">
      <view wx:if="{{picking}}" class="ad-radio {{item.isDefault ? 'px-circle-radio-on' : 'px-circle-radio'}}">
        <px-i wx:if="{{item.isDefault}}" name="dot" tone="var(--v5-violet)" />
      </view>
      <view class="ad-text">
        <text class="t-sys ad-region">{{item.region}}</text>
        <text class="t-sys ad-detail">{{item.detail}}</text>
        <view class="ad-line1">
          <text class="t-sys ad-name">{{item.name}}</text>
          <text class="mono ad-phone">{{item.phoneMasked}}</text>
          <text class="t-sys ad-def px-clip-4" wx:if="{{item.isDefault}}">默认</text>
        </view>
      </view>
      <view class="k k-sm k-flat ad-edit" hover-start-time="20" hover-class="k-flat-down" hover-stay-time="100" data-id="{{item.id}}" catch:tap="onEdit" data-k="flat" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">编辑</view>
    </view>
    <view wx:if="{{!list.length}}" class="ad-empty">
      <px-ground kind="pin" />
      <text class="ad-empty-t">还没有收货地址</text>
    </view>
  </view>
  <view class="ad-dock-space"></view>
</view>

<view class="ad-dock">
  <view class="k k-ink k-48 ad-add" hover-start-time="20" hover-class="k-ink-down" hover-stay-time="100" bind:tap="onAdd" data-k="ink" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">新增收货地址</view>
</view>
<px-fx id="fx" />
