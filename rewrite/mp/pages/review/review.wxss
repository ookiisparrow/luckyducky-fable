/* 写评价（v5 稿 B3） */
page {
  background: var(--v5-canvas);
  color: var(--v5-ink);
}
.rv-egg {
  padding: 0 16px 12px;
}
.rv-main {
  padding: 0 16px 16px;
  display: flex;
  flex-direction: column;
}
.rv-item {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.rv-q {
  margin-top: 24px;
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.01em;
}
/* 5 颗大星键：等分一行、56 高 */
.rv-stars {
  margin-top: 16px;
  display: flex;
  gap: 8px;
}
.rv-star {
  flex: 1;
  height: 56px;
  padding: 0;
}
.rv-label {
  margin-top: 12px;
  text-align: center;
  font-size: 17px;
  font-weight: 500;
  color: var(--v5-ink-3);
}
.rv-label.on {
  color: var(--v5-ink);
}

.rv-more {
  margin-top: 24px;
  padding-top: 16px;
  border-top: 1px solid var(--v5-hair);
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.rv-cap {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.rv-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.rv-tag {
  height: 32px;
  padding: 0 12px;
  font-size: 13px;
  font-weight: 300;
}
.rv-text {
  width: 100%;
  min-height: 56px;
  padding: 12px;
  font-size: 17px;
  font-weight: 500;
  line-height: 1.5;
  color: var(--v5-ink);
}
.rv-ph {
  color: var(--v5-ink-4);
}
.rv-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.rv-photo {
  position: relative;
  width: 56px;
  height: 56px;
  border-radius: 6px;
  overflow: hidden;
  background: var(--v5-sunk);
}
.rv-photo-img {
  width: 100%;
  height: 100%;
}
.rv-photo-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(17, 17, 17, 0.55);
  border-bottom-left-radius: 6px;
}
.rv-add {
  width: 56px;
  height: 56px;
  padding: 0;
  color: var(--v5-ink-2);
}
.rv-anon {
  align-self: flex-start;
  padding: 8px 0;
  display: flex;
  align-items: center;
  gap: 12px;
}
.rv-box {
  width: 22px;
  height: 22px;
  padding: 0;
  border-radius: 4px;
}
.rv-anon-t {
  font-size: 17px;
  font-weight: 500;
}
.rv-anon-sub {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}

.rv-dock-space {
  height: calc(60px + max(28px, env(safe-area-inset-bottom)));
}
.rv-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12px 16px max(28px, env(safe-area-inset-bottom));
  display: flex;
  background: var(--v5-canvas);
}
.rv-pub {
  flex: 1;
}
