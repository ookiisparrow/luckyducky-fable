/* 写评价（v5 稿 B3） */
page {
  background: var(--v5-canvas);
  color: var(--v5-ink);
}
/* 整页纵向三段：顶栏占位 / 滚动内容 / 底部发布栏（放弃拦截武装会冻结页面级滚动，滚动放 scroll-view 里） */
.rv-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.rv-scroll {
  flex: 1;
  min-height: 0;
}
/* 蛋壳地面：顶栏下 groundGap 处落地（屏高<700 为 56、其余 120·lib/ground·全站同一条地面线） */
.rv-egg {
  padding: 0 16px 12px;
}
.rv-main {
  padding: 0 16px 16px;
  display: flex;
  flex-direction: column;
}
.rv-item {
  display: flex;
  align-items: center;
  gap: 8px;
}
.rv-thumb {
  width: 28px;
  height: 28px;
  flex: 0 0 auto;
  overflow: hidden;
  background: repeating-linear-gradient(135deg, var(--v5-sunk) 0 5px, var(--v5-sunk-2) 5px 10px);
}
.rv-thumb-img {
  display: block;
  width: 100%;
  height: 100%;
}
.rv-item-t {
  min-width: 0;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rv-q {
  margin-top: 24px;
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.01em;
}
/* 5 颗大星键：等分一行、56 高 */
.rv-stars {
  margin-top: 16px;
  display: flex;
  gap: 8px;
}
.rv-star {
  flex: 1;
  height: 56px;
  padding: 0;
}
/* 选中星键＝按下态（设计稿 stars：底 #f0f0ed、内阴影、下沉 1px） */
.rv-star-on {
  transform: translateY(1px);
  background: var(--v5-press);
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.12), 0 0 0 1px var(--v5-hair);
}
/* 没打分点发布：星排左右抖 360ms（设计稿 shake -6,6,-4,3,0） */
.rv-shake {
  animation: rv-shake 360ms linear;
}
@keyframes rv-shake {
  0%,
  100% {
    transform: translateX(0);
  }
  20% {
    transform: translateX(-6px);
  }
  40% {
    transform: translateX(6px);
  }
  60% {
    transform: translateX(-4px);
  }
  80% {
    transform: translateX(3px);
  }
}
.rv-label {
  margin-top: 12px;
  text-align: center;
  font-size: 17px;
  font-weight: 500;
  color: var(--v5-ink-2);
}
.rv-label.on {
  color: var(--v5-ink);
}

.rv-more {
  margin-top: 24px;
  padding-top: 16px;
  border-top: 1px solid var(--v5-hair-soft);
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.rv-cap {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.rv-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.rv-tag {
  height: 32px;
  padding: 0 12px;
  font-size: 13px;
  font-weight: 500; /* 圆体不出细体字重（只 500/700/900·字体瘦身） */
  color: var(--v5-ink-2); /* 未选灰字（设计稿 chip off） */
}
.rv-tag-on {
  color: var(--v5-ink);
}
/* 文字框固定 56 高 + 右侧 56×56「+」晒图键同一行 */
.rv-write {
  display: flex;
}
.rv-text {
  flex: 1;
  min-width: 0;
  height: 150px;
  padding: 12px;
  font-size: 17px;
  font-weight: 500;
  line-height: 1.5;
  color: var(--v5-ink);
}
.rv-ph {
  color: var(--v5-ink-4);
}
.rv-count {
  align-self: flex-end;
  margin-top: -4px;
  font-size: 13px;
  color: var(--v5-ink-2);
}
.rv-count-warn {
  color: var(--v5-warn-text);
}
.rv-count-full {
  color: var(--v5-err-text);
}
.rv-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
/* 不再 overflow:hidden：删除角标的 44 热区要伸出图外；圆角改由图片自己裁 */
.rv-photo {
  position: relative;
  width: 56px;
  height: 56px;
}
.rv-photo-img {
  display: block;
  width: 100%;
  height: 100%;
  background: var(--v5-sunk);
}
/* 44×44 透明热区：向上伸 12px、向右伸 6px（右侧只 8px 间距，少伸免得压到下一张） */
.rv-photo-del {
  position: absolute;
  top: -12px;
  right: -6px;
  width: 44px;
  height: 44px;
}
/* 看得见的角标：仍贴图片右上角 20×20（右上圆角跟图片走） */
.rv-photo-x {
  position: absolute;
  top: 12px;
  right: 6px;
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(17, 17, 17, 0.55);
}
.rv-add {
  width: 56px;
  height: 56px;
  flex: 0 0 auto;
  padding: 0;
  color: var(--v5-ink-2);
}
.rv-anon {
  align-self: flex-start;
  padding: 8px 0;
  display: flex;
  align-items: center;
  gap: 12px;
}
/* 按匿名整行任意处，勾选框下沉（同 v5-nav .nv-hit-down） */
.rv-anon-down .rv-box {
  transform: translateY(1px);
  background: var(--v5-press);
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.12), 0 0 0 1px var(--v5-hair);
}
.rv-box {
  width: 22px;
  height: 22px;
  padding: 0;
  border-radius: 4px;
}
.rv-anon-t {
  font-size: 17px;
  font-weight: 500;
}

.rv-dock {
  flex: 0 0 auto;
  padding: 12px 16px max(28px, env(safe-area-inset-bottom));
  display: flex;
  background: var(--v5-canvas);
}
.rv-pub {
  flex: 1;
}
