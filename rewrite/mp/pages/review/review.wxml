<!-- 写评价（v5 稿 B3 · 写评价 · 蛋壳）：半蛋壳地面 → 28 缩略图 +「名称 · 规格」→ 大问句 → 5 颗像素大星键（选中黄、按下态）→ 星级文案；
     分隔线下「补充一下 · 选填」：标签（选中浅色键/未选平面键）、56 高文字框 + 同行「+」晒图键、晒图缩略、匿名勾选；底部发布（有星＝墨黑键，否则平面键）。
     业务逻辑承接 review.ts：onStar(换星撒花)/onTag/onText/onAnon/onSubmit(busy 闸·没打分提示 + 星排抖)；晒图传云存储 cloud://，内容安全在云端提交时逐张校（fail-closed）。
     有改动时 <leave-sheet> 拦返回/侧滑；拦截武装会冻结页面级滚动，故内容套 scroll-view。 -->
<view class="rv-page">
  <v5-nav title="订单 · 写评价" guard="{{true}}" bind:back="onBack" />

  <scroll-view class="rv-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="rv-egg"><px-ground kind="egg" shell /></view>

    <view class="rv-main">
      <view class="rv-item" wx:if="{{item}}">
        <view class="rv-thumb"><image wx:if="{{cover}}" class="rv-thumb-img" src="{{cover}}" mode="aspectFill" /></view>
        <text class="t-sys rv-item-t">{{item}}</text>
      </view>
      <text class="rv-q">{{q}}</text>

      <view class="rv-stars {{shake ? 'rv-shake' : ''}}">
        <view wx:for="{{starIdx}}" wx:key="*this" id="rv-star-{{item}}" class="k k-light rv-star {{rating >= item ? 'rv-star-on' : ''}}" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100"
          data-n="{{item}}" bind:tap="onStar" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">
          <px-i name="star9" size="4" tone="{{rating >= item ? 'var(--v5-warn)' : 'var(--v5-rule)'}}" halo="none" />
        </view>
      </view>
      <text class="rv-label {{rating ? 'on' : ''}}">{{ratingLabel}}</text>

      <view class="rv-more">
        <text class="t-sys rv-cap">补充一下 · 选填</text>
        <view class="rv-tags">
          <view wx:for="{{tags}}" wx:key="t" class="k k-sm rv-tag hit44 hit-wrap {{item.on ? 'k-light rv-tag-on' : 'k-flat'}}"
            hover-start-time="20" hover-class="{{item.on ? 'k-light-down' : 'k-flat-down'}}" hover-stay-time="100" data-i="{{index}}" bind:tap="onTag" data-k="{{item.on ? 'light' : 'flat'}}" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">{{item.t}}</view>
        </view>

        <!-- 文字框固定 56 高 + 同行 56×56「+」晒图键（设计稿）；聚焦 1.5px 紫描边 -->
        <view class="rv-write">
          <textarea class="well rv-text t-sys {{focus ? 'well-focus' : ''}}" value="{{text}}" bind:input="onText" bind:focus="onFocus" bind:blur="onBlur" maxlength="500"
            placeholder="写几句感受…" placeholder-class="rv-ph" />
          <view wx:if="{{photos.length < maxPhotos}}" class="k k-flat rv-add" hover-start-time="20" hover-class="k-flat-down" hover-stay-time="100" bind:tap="onAddPhotos" data-k="flat" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">
            <px-anim wx:if="{{uploading}}" name="loader" size="2" />
            <px-i wx:else name="plus" />
          </view>
        </view>

        <text class="t-sys rv-cap">晒图最多 {{maxPhotos}} 张</text>

        <!-- 晒图：最多 maxPhotos 张，点缩略图预览、角标删除（角标外层 44×44 透明热区，看得见的仍是 20×20） -->
        <view class="rv-photos" wx:if="{{photos.length}}">
          <view class="rv-photo" wx:for="{{photos}}" wx:key="*this">
            <image class="rv-photo-img" src="{{item}}" mode="aspectFill" data-url="{{item}}" bind:tap="onPreviewPhoto" />
            <view class="rv-photo-del" data-i="{{index}}" catch:tap="onDelPhoto"><view class="rv-photo-x"><px-i name="times" tone="var(--v5-surface)" /></view></view>
          </view>
        </view>

        <view class="rv-anon hit44" bind:tap="onAnon">
          <view class="k k-sm k-light rv-box"><px-i wx:if="{{anon}}" name="check" tone="var(--v5-violet)" /></view>
          <text class="rv-anon-t">匿名评价</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="rv-dock">
    <view wx:if="{{rating && !busy}}" class="k k-ink k-48 rv-pub" hover-start-time="20" hover-class="k-ink-down" hover-stay-time="100" bind:tap="onSubmit" data-k="ink" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">发布评价</view>
    <view wx:else class="k k-flat k-off k-48 rv-pub" hover-start-time="20" hover-class="k-flat-down" hover-stay-time="100" bind:tap="onSubmit" data-k="flat" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">发布评价</view>
  </view>
</view>

<!-- 放弃编辑确认（设计稿 LEAVE.review）：有改动时拦返回/侧滑 -->
<leave-sheet id="leave" dirty="{{dirty}}" title="放弃这条评价？" sub="星级、文字和照片都不会保存。" />

<!-- 隐私授权弹窗（晒图走 wx.chooseMedia 属隐私接口·守卫 rw-mp-privacy-gated） -->
<privacy-sheet />

<!-- v5 全屏像素特效层（撒花/转场/提示·lib/pxFx）：页面根下、不进滚动容器 -->
<px-fx id="fx" />
