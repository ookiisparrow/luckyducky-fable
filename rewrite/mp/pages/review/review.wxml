<!-- 写评价（v5 稿 B3 · 写评价 · 蛋壳）：半蛋壳地面 → 商品名 → 大问句 → 5 颗像素大星键（选中黄/未选灰）→ 星级文案；
     分隔线下「补充一下 · 选填」：标签（选中浅色键/未选平面键）、文字、晒图、匿名勾选；底部发布（有星＝墨黑键，否则平面键）。
     业务逻辑承接 review.ts：onStar/onTag/onText/onAnon/onSubmit(busy 闸)；晒图传云存储 cloud://，内容安全在云端提交时逐张校（fail-closed）。
     ponytail: 设计稿选 4/5 星会从星键喷像素彩带，未做。 -->
<v5-nav title="订单 · 写评价" />

<view class="rv">
  <view class="rv-egg"><px-ground kind="egg" shell /></view>

  <view class="rv-main">
    <text wx:if="{{name}}" class="rv-item">{{name}}</text>
    <text class="rv-q">这次体验怎么样？</text>

    <view class="rv-stars">
      <view wx:for="{{starIdx}}" wx:key="*this" class="k k-light rv-star" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100"
        data-n="{{item}}" bind:tap="onStar">
        <px-i name="star9" size="4" tone="{{rating >= item ? '#F4BD3F' : '#C9C9C2'}}" halo="none" />
      </view>
    </view>
    <text class="rv-label {{rating ? 'on' : ''}}">{{ratingLabel}}</text>

    <view class="rv-more">
      <text class="rv-cap">补充一下 · 选填</text>
      <view class="rv-tags">
        <view wx:for="{{tags}}" wx:key="t" class="k k-sm rv-tag {{item.on ? 'k-light' : 'k-flat'}}"
          hover-start-time="20" hover-class="{{item.on ? 'k-light-down' : 'k-flat-down'}}" hover-stay-time="100" data-i="{{index}}" bind:tap="onTag">{{item.t}}</view>
      </view>

      <textarea class="well rv-text t-sys" value="{{text}}" bind:input="onText" maxlength="500" auto-height
        placeholder="写几句感受…" placeholder-class="rv-ph" />

      <!-- 晒图：选图传云存储·内容安全云端逐张校；最多 maxPhotos 张，点缩略图预览、角标删除 -->
      <view class="rv-photos">
        <view class="rv-photo" wx:for="{{photos}}" wx:key="*this">
          <image class="rv-photo-img" src="{{item}}" mode="aspectFill" data-url="{{item}}" bind:tap="onPreviewPhoto" />
          <view class="rv-photo-del" data-i="{{index}}" catch:tap="onDelPhoto"><px-i name="times" tone="#ffffff" /></view>
        </view>
        <view wx:if="{{photos.length < maxPhotos}}" class="k k-flat rv-add" hover-start-time="20" hover-class="k-flat-down" hover-stay-time="100" bind:tap="onAddPhotos">
          <px-anim wx:if="{{uploading}}" name="loader" size="2" />
          <px-i wx:else name="plus" />
        </view>
      </view>

      <view class="rv-anon" bind:tap="onAnon">
        <view class="k k-sm k-light rv-box"><px-i wx:if="{{anon}}" name="check" tone="#8A5AE0" /></view>
        <text class="rv-anon-t">匿名评价</text>
        <text class="rv-anon-sub">隐藏你的昵称与头像</text>
      </view>
    </view>
  </view>
</view>

<view class="rv-dock-space"></view>
<view class="rv-dock">
  <view wx:if="{{rating && !busy}}" class="k k-ink k-48 rv-pub" hover-start-time="20" hover-class="k-ink-down" hover-stay-time="100" bind:tap="onSubmit">发布评价</view>
  <view wx:else class="k k-flat k-48 rv-pub" hover-start-time="20" hover-class="k-flat-down" hover-stay-time="100" bind:tap="onSubmit">发布评价</view>
</view>

<!-- 隐私授权弹窗（晒图走 wx.chooseMedia 属隐私接口·守卫 rw-mp-privacy-gated） -->
<privacy-sheet />
