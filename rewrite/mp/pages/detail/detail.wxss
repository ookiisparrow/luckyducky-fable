/* 商品详情（v5「字重」稿 A2）。px 对齐设计稿；色值只来自 --v5-*。 */
/* 图集 */
.pd-gallery {
  position: relative;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: var(--v5-sunk);
}
.pd-swiper,
.pd-img {
  display: block;
  width: 100%;
  height: 100%;
}
.pd-slide {
  overflow: hidden;
}
/* 裁切焦点 50% 40%（设计稿 object-position）：widthFix 图按宽铺满，top 40% + translateY(-40%)＝上移（图高−框高）×40%。
   横图不挂本类（detail.ts onImgLoad）。同 home.wxss .focus-img。 */
.focus-img {
  position: absolute;
  left: 0;
  top: 40%;
  transform: translateY(-40%);
}
.pd-fade-top {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 12%;
  background: linear-gradient(to top, rgba(250, 250, 248, 0), var(--v5-canvas));
  pointer-events: none;
}
.pd-fade-bottom {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 16%;
  background: linear-gradient(to bottom, rgba(250, 250, 248, 0), var(--v5-canvas) 88%);
  pointer-events: none;
}
.pd-pager {
  height: 12px;
  padding: 0 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pd-dots {
  display: flex;
  align-items: center;
  gap: 4px;
}
.pd-dot {
  width: 4px;
  height: 4px;
  background: var(--v5-rule);
}
.pd-dot.on {
  width: 12px;
  background: var(--v5-violet);
}
.pd-gi {
  font-size: 13px;
  color: var(--v5-ink-2);
}

/* 名称 / 价格 / 评分 */
.pd-head {
  padding: 12px 16px 0;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 12px;
}
.pd-name {
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.01em;
}
.pd-price {
  flex: 0 0 auto;
  font-size: 22px;
  font-weight: 600;
}
.pd-rate {
  margin: 0 16px;
  padding: 8px 0;
  display: flex;
  align-items: center;
  gap: 4px;
  color: var(--v5-ink-2);
}
.pd-rate-text {
  margin-right: 4px;
  font-size: 13px;
  font-weight: 300;
}
.pd-sold {
  margin-left: auto;
  font-size: 13px;
  font-weight: 300;
}
.pd-policy {
  display: block;
  padding: 0 16px 8px;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}

/* 规格格：四列一行，多了换行 */
.pd-specs {
  margin: 2px 16px 0;
  display: flex;
  flex-wrap: wrap;
  border-top: 1px solid var(--v5-hair);
  border-bottom: 1px solid var(--v5-hair);
}
.pd-spec {
  box-sizing: border-box;
  width: 25%;
  padding: 8px 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.pd-spec-v {
  font-size: 17px;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 款式：凹槽里一排键，选中＝浅色键 + 紫灯 */
.pd-vars {
  margin: 8px 16px 0;
  padding: 4px;
  display: flex;
  gap: 4px;
}
.pd-var {
  flex: 1;
  min-width: 0;
  height: 36px;
  padding: 0 8px;
}
.pd-var-off {
  color: var(--v5-ink-2);
}
.pd-var-name {
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 图文 */
.pd-sec {
  margin: 24px 16px 0;
  padding-top: 16px;
  border-top: 1px solid var(--v5-hair);
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.pd-sec-title {
  font-size: 20px;
  font-weight: 700;
}
.pd-lead {
  font-size: 17px;
  font-weight: 500;
}
.pd-body {
  font-size: 17px;
  font-weight: 500;
  line-height: 1.7;
  color: var(--v5-ink-2);
}
.pd-kit {
  margin-top: 8px;
  display: flex;
  flex-direction: column;
}
.pd-kit-title {
  padding-bottom: 8px;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.pd-kit-row {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  border-top: 1px solid var(--v5-hair);
}
.pd-kit-row:last-child {
  border-bottom: 1px solid var(--v5-hair);
}
.pd-kit-name {
  font-size: 17px;
  font-weight: 500;
}
.pd-kit-qty {
  font-size: 15px;
  color: var(--v5-ink-2);
}

/* 底部操作区：客服 48 方键 + 加购 1 : 直买 1.25
   垫高＝操作栏高（上 12 + 键 48 + 底 max(28,安全区)）+ 16 留白 = 76 + max(28,安全区) */
.pd-dock-space {
  height: calc(76px + max(28px, env(safe-area-inset-bottom)));
}
.pd-dock {
  z-index: 10;
}
.pd-cs {
  flex: 0 0 48px;
  padding: 0;
}
.pd-add {
  flex: 1;
  min-width: 0;
}
.pd-buy {
  flex: 1.25;
  min-width: 0;
}
.pd-go {
  flex: 1; /* 客服键外全占＝加购+直买两键合计宽 */
  min-width: 0;
}

/* 骨架 / 空态 */
.pd-skel {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.pd-skel-hero {
  aspect-ratio: 1 / 1;
}
.pd-skel-line {
  height: 24px;
  margin: 0 16px;
  border-radius: 4px;
}
.pd-skel-line.short {
  width: 120px;
}
.pd-state {
  padding: 96px 16px 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  text-align: center;
}
.pd-state-title {
  font-size: 17px;
  font-weight: 500;
}
.pd-state-btn {
  margin-top: 8px;
  width: 120px;
}
/* 失败态（设计稿 E2）：上边距落在信号动画上＝88 */
.pd-fail {
  padding-top: 0;
}
.pd-signal {
  padding-top: 88px;
  display: flex;
}
