<!-- 商品详情（v5「字重」稿 A2）：1:1 图集 + 方格页码 + 名称/价格 + 评分 + 规格格 + 款式凹槽 + 图文，底部 客服/加购/直买
     「客服」键是 48px 方键，放不下「联系客服」四个字，保持「客服」。 -->
<v5-nav />

<view class="pd" wx:if="{{vm}}">
  <!-- 图集：窗口渲染（current±1·circular 首尾邻接算窗口内）：swiper 内 lazy-load 不生效（真机验证过），
       全量 swiper-item 会让画廊全部图并发下载；galleryWindow 由 detail.ts 随 galleryIndex 同步维护。 -->
  <view class="pd-gallery">
    <!-- current 绑 galleryIndex：切款式时置 0，swiper 自带动画滑回第 1 张（detail.ts onSelectSku）。
         裁切焦点 50% 40%（设计稿 object-position）：同首页写法——竖图/方图 widthFix + .focus-img，横图 onImgLoad 记进 wide 退回 aspectFill -->
    <swiper wx:if="{{vm.gallery.length}}" class="pd-swiper" current="{{galleryIndex}}" circular="{{vm.gallery.length > 1}}" bindchange="onGallery">
      <swiper-item wx:for="{{vm.gallery}}" wx:key="*this" class="pd-slide">
        <image wx:if="{{galleryWindow[index]}}" class="pd-img {{wide[item] ? '' : 'focus-img'}}" src="{{item}}" mode="{{wide[item] ? 'aspectFill' : 'widthFix'}}" data-src="{{item}}" bindload="onImgLoad" />
      </swiper-item>
    </swiper>
    <view class="pd-fade-top"></view>
    <view class="pd-fade-bottom"></view>
  </view>
  <!-- 页码行常驻（设计稿：只有一张图也留这行 12px，点只有一个）；页码补 0、斜杠两侧空格：01 / 06 -->
  <view class="pd-pager">
    <block wx:if="{{vm.gallery.length}}">
      <view class="pd-dots">
        <view wx:for="{{vm.gallery}}" wx:key="*this" class="pd-dot {{galleryIndex === index ? 'on' : ''}}"></view>
      </view>
      <text class="mono pd-gi">{{galleryIndex < 9 ? '0' : ''}}{{galleryIndex + 1}} / {{vm.gallery.length < 10 ? '0' : ''}}{{vm.gallery.length}}</text>
    </block>
  </view>

  <view class="pd-head">
    <text class="pd-name">{{vm.name}}</text>
    <text class="mono pd-price">¥{{currentPriceNum}}</text>
  </view>
  <view class="pd-rate hit44" hover-start-time="20" hover-class="k-row-down" bind:tap="onViewReviews">
    <block wx:if="{{rating}}">
      <px-i name="star5" />
      <text class="t-sys pd-rate-text">{{rating.scoreLabel}} · {{rating.count}} 条评价</text>
    </block>
    <text wx:else class="t-sys pd-rate-text">看看钩友们怎么说</text>
    <px-i name="arrow" />
    <text wx:if="{{vm.soldLabel}}" class="t-sys pd-sold">{{vm.soldLabel}}</text>
  </view>
  <!-- 顾客看见的运费/售后/退货口径（已拍板政策·shipping-returns-copy 测试钉）；结算算钱仍走 SHIP=0（不在本页改钱链）。
       不要写「满 ¥100 包邮」或「全场包邮」——都不是现政策。 -->
  <text class="t-sys pd-policy">包邮到家 · 售后无忧 · 开课后不可退货</text>

  <view class="pd-specs" wx:if="{{vm.params.length}}">
    <view class="pd-spec" wx:for="{{vm.params}}" wx:key="k">
      <text class="t-sys pd-spec-k">{{item.k}}</text>
      <text class="pd-spec-v">{{item.v}}</text>
    </view>
  </view>

  <view class="well pd-vars" wx:if="{{vm.skus.length > 1}}">
    <view wx:for="{{vm.skus}}" wx:key="name" data-index="{{index}}" bind:tap="onSelectSku"
      class="k pd-var hit44 {{skuIndex === index ? 'k-light' : 'pd-var-off'}}"
      hover-start-time="20" hover-class="{{skuIndex === index ? 'k-light-down' : 'k-flat-down'}}" hover-stay-time="100" data-k="{{skuIndex === index ? 'light' : 'flat'}}" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">
      <px-i wx:if="{{skuIndex === index}}" name="led" tone="var(--v5-violet)" />
      <text class="pd-var-name">{{item.name}}</text>
    </view>
  </view>

  <view class="pd-sec" wx:if="{{vm.sections.length || vm.kit.length}}">
    <text class="pd-sec-title">商品详情</text>
    <!-- wx:key 刻意用 index（同 about/reviews）：段落无 id 字段，lead 作 key 多段空标题必撞键；列表随 vm 整体替换、不重排，index 稳定 -->
    <block wx:for="{{vm.sections}}" wx:key="index">
      <text class="t-sys pd-lead" wx:if="{{item.lead}}">{{item.lead}}</text>
      <text class="t-sys pd-body" wx:if="{{item.body}}">{{item.body}}</text>
    </block>
    <view class="pd-kit" wx:if="{{vm.kit.length}}">
      <text class="t-sys pd-kit-title">套装包含</text>
      <!-- wx:key 刻意用 index：材料无 id 字段，name 作 key 同名不同规格必撞键；列表随 vm 整体替换、不重排，index 稳定 -->
      <view class="pd-kit-row" wx:for="{{vm.kit}}" wx:key="index">
        <text class="pd-kit-name">{{item.name}}</text>
        <text class="mono pd-kit-qty" wx:if="{{item.qty}}">{{item.qty}}</text>
      </view>
    </view>
  </view>

  <view class="pd-dock-space"></view>
  <view class="pd-dock">
    <view class="k k-light k-48 pd-cs k-sq" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onService" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i name="service" /></view>
    <!-- 加购成功后两颗键合并成「去结算」（老板拍板 8·宽度占两键合计）；换款式（detail.ts onSelectSku）恢复 -->
    <view wx:if="{{added}}" class="k k-ink k-48 pd-go enter-fade" hover-start-time="20" hover-class="k-ink-down" hover-stay-time="100" bind:tap="onGoCheckout" data-k="ink" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">去结算</view>
    <block wx:else>
      <view class="k k-light k-48 pd-add enter-fade k-sq" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onAddCart" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i name="cart" /></view>
      <view class="k k-ink k-48 pd-buy enter-fade" hover-start-time="20" hover-class="k-ink-down" hover-stay-time="100" bind:tap="onBuyNow" data-k="ink" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">立即购买</view>
    </block>
  </view>
</view>

<!-- 加载骨架：1:1 图块 + 两行文字 -->
<view class="pd-skel" wx:elif="{{loading}}">
  <view class="pd-skel-hero skel"></view>
  <view class="pd-skel-line skel"></view>
  <view class="pd-skel-line short skel"></view>
</view>

<!-- 失败态照设计稿 E2：像素信号动画 + 上边距 88、间距 12、重试键宽 120（同 order-list） -->
<view class="pd-state pd-fail" wx:elif="{{!loading && loadFailed}}">
  <view class="pd-signal"><px-anim name="signal" size="4" /></view>
  <text class="pd-state-title">网络开小差</text>
  <text class="t-sys pd-state-hint">商品加载失败，请重试</text>
  <view class="k k-light pd-state-btn" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onRetryLoad" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">重试</view>
</view>
<view class="pd-state" wx:elif="{{!loading}}">
  <text class="pd-state-title">商品不存在或已下架</text>
  <text class="t-sys pd-state-hint">回首页看看别的吧</text>
  <view class="k k-light pd-state-btn" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onGoHome" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">回首页</view>
</view>

<!-- v5 全屏像素特效层（撒花/转场/轻提示·lib/pxFx）：页面根下、不进滚动容器 -->
<px-fx id="fx" />
