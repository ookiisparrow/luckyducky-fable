<!-- 激活页（v5「字重」稿 C2 激活码无效 / C3 激活成功·开课须知）。只从「微信扫实体激活卡二维码」带 ?code= 进来——
     老板拍板不做应用内手动输码（设计稿 C1）与扫码按钮：
     phase 'nocode'（没带码直接进来）→ 提示用微信扫卡；'result' 且 kind mine/taken/invalid/error → C2 各变体（无「重新输入」）；
     'result' 且 kind==='activated' → W1（C3 上半）；'w2' → W2（C3 下半：三件事 + 不可退货 + 进课）。
     handler：onBack/onRetryCode/onEnter/onContact/onNextWelcome/onGoHome。 -->
<view class="wl">
  <!-- 自绘返回：custom 导航无原生返回箭头；带 tapHaptic 故不用 v5-nav（onBack 走 goBackOrHome） -->
  <view class="wl-nav" style="padding-top:{{statusBarHeight}}px">
    <view class="wl-hit" bind:tap="onBack">
      <view class="k k-sm k-light wl-back" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i name="back" /></view>
    </view>
    <text wx:if="{{phase === 'nocode' || (phase === 'result' && kind !== 'activated')}}" class="t-sys wl-nav-t">激活课程</text>
  </view>

  <!-- 没带码进来：只能用微信扫激活卡（不给输入框） -->
  <block wx:if="{{phase === 'nocode'}}">
    <view class="wl-body">
      <view class="wl-head wl-head-tight">
        <text class="wl-h1">扫码激活课程</text>
      </view>
      <view class="wl-msg">
        <view class="wl-msg-led"><px-i name="dot" tone="rgba(17,17,17,.28)" /></view>
        <text class="t-sys wl-msg-t">激活卡在初学者钩织学习套装里。用微信「扫一扫」扫卡上的二维码，就会回到这里开课。</text>
      </view>
    </view>
    <view class="wl-dock">
      <view class="k k-ink k-48 wl-main" hover-start-time="20" hover-class="k-ink-down" hover-stay-time="100" bind:tap="onBack" data-k="ink" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">返回</view>
    </view>
  </block>

  <!-- C2 兑课结果（非新激活）：标题 + 回显激活码 + 状态灯说明 + 底部两键 -->
  <block wx:elif="{{phase === 'result' && kind !== 'activated'}}">
    <view class="wl-body">
      <view class="wl-head wl-head-tight">
        <text wx:if="{{kind === 'mine'}}" class="wl-h1">欢迎回来</text>
        <text wx:elif="{{kind === 'taken'}}" class="wl-h1">这个码已被使用</text>
        <text wx:elif="{{kind === 'error'}}" class="wl-h1">{{errCopy.display}}</text>
        <text wx:else class="wl-h1">激活码不对哦</text>
      </view>
      <view wx:if="{{code}}" class="well mono wl-code wl-code-ro wl-code-{{kind}}">{{code}}</view>
      <view class="wl-msg">
        <!-- mine 绿·error（网络/频控/繁忙，码可能没问题）黄·taken/invalid 红 -->
        <view class="wl-msg-led"><px-i name="led" tone="{{kind === 'mine' ? 'var(--v5-ok)' : kind === 'error' ? 'var(--v5-warn)' : 'var(--v5-err)'}}" /></view>
        <text wx:if="{{kind === 'mine'}}" class="t-sys wl-msg-t wl-msg-mine">这个码已经是你的了，接着上次继续钩就好，慢慢来。</text>
        <text wx:elif="{{kind === 'taken'}}" class="t-sys wl-msg-t wl-msg-bad">它已经被别的账号激活了。如果是家人朋友，让 TA 用自己的手机继续学；买过初学者钩织学习套装想自己学，用套装里你自己的码。</text>
        <text wx:elif="{{kind === 'error'}}" class="t-sys wl-msg-t wl-msg-error">{{errCopy.lead}}</text>
        <text wx:else class="t-sys wl-msg-t wl-msg-bad">这张激活卡没认出来，可以联系客服帮你确认。</text>
      </view>
    </view>
    <view class="wl-dock">
      <view class="wl-row" wx:if="{{kind === 'mine'}}">
        <view class="k k-ink k-48 wl-main" hover-start-time="20" hover-class="k-ink-down" hover-stay-time="100" bind:tap="onEnter" data-k="ink" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">继续学习</view>
      </view>
      <!-- 没兑成但码可能是好的：「再试一次」用原码重发，不清码不误导 -->
      <view class="wl-row" wx:elif="{{kind === 'error'}}">
        <view class="k k-light k-48 wl-alt" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onContact" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">联系客服</view>
        <view class="k k-48 wl-main {{busy ? 'k-flat k-off' : 'k-ink'}}" hover-start-time="20" hover-class="{{busy ? 'none' : 'k-ink-down'}}" hover-stay-time="100" bind:tap="onRetryCode" data-k="{{busy ? 'none' : 'ink'}}" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">再试一次</view>
      </view>
      <view class="wl-row" wx:else>
        <view class="k k-light k-48 wl-alt" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onContact" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">联系客服</view>
        <view class="k k-ink k-48 wl-main" hover-start-time="20" hover-class="k-ink-down" hover-stay-time="100" bind:tap="onGoHome" data-k="ink" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">回首页</view>
      </view>
    </view>
  </block>

  <!-- W1（C3 上半）：1:1 主图（本课激活背景·缺席留凹槽灰）+ 绿灯标题 + 课程名（取不到不渲染）+ 说明 -->
  <block wx:elif="{{phase === 'result'}}">
    <view class="wl-body">
      <view class="wl-hero">
        <image wx:if="{{bg}}" class="wl-hero-img" src="{{bg}}" mode="aspectFill" />
        <view class="wl-fade-t"></view>
        <view class="wl-fade-b"></view>
      </view>
      <view class="wl-ok">
        <view class="wl-ok-row">
          <px-i name="led" tone="var(--v5-ok)" />
          <text class="wl-h0">{{welcome.w1.title}}</text>
        </view>
        <text wx:if="{{courseTitle}}" class="wl-meta">{{courseTitle}}</text>
        <text class="t-sys wl-lead">{{welcome.w1.sub}}</text>
      </view>
    </view>
    <view class="wl-dock">
      <view class="k k-ink k-48 wl-main" hover-start-time="20" hover-class="k-ink-down" hover-stay-time="100" bind:tap="onNextWelcome" data-k="ink" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">下一步</view>
    </view>
  </block>

  <!-- W2（C3 下半·开课须知）：三件事（CMS 覆盖 title/desc）+ 不可退货警示 + 先逛逛 / 进入课程 -->
  <block wx:elif="{{phase === 'w2'}}">
    <view class="wl-body">
      <view class="wl-head wl-head-tight">
        <text class="wl-h1">开始前，记住三件事</text>
      </view>
      <view class="wl-list">
        <view class="wl-item" wx:for="{{welcome.w2.items}}" wx:key="icon">
          <text class="mono wl-no">0{{index + 1}}</text>
          <view class="wl-item-tx">
            <text class="wl-item-h">{{item.title}}</text>
            <text class="t-sys wl-item-p">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="wl-dock wl-dock-col">
      <!-- 不可退货警示（业务告知义务·需求 R4，不省）·空则强制回默认（mapWelcome·不允许被清空） -->
      <view class="wl-warn">
        <view class="wl-msg-led"><px-i name="led" tone="var(--v5-warn)" /></view>
        <text class="t-sys wl-warn-t">{{welcome.w1.warning}}</text>
      </view>
      <view class="wl-row">
        <view class="k k-light k-48 wl-alt" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onGoHome" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">先逛逛</view>
        <view class="k k-48 wl-main {{busy ? 'k-flat k-off' : 'k-ink'}}" hover-start-time="20" hover-class="{{busy ? 'none' : 'k-ink-down'}}" hover-stay-time="100" bind:tap="onEnter" data-k="{{busy ? 'none' : 'ink'}}" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">进入课程</view>
      </view>
    </view>
  </block>
</view>
