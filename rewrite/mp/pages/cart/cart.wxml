<!-- 购物车（v5「字重」稿 A4）：标题 + 像素小货车（车斗箱数随行数）+ 行列表（勾选/加减/按住删）+ 小计 + 结算。
     真实购物车逻辑（lib/cart 单源·结算走选中项）全保留。
     列表在 <scroll-view> 里滚：退出提醒的 page-container 武装态会冻结页面级滚动（决策§30·见 utils/exitGuard）。 -->
<view class="ca" style="padding-top: {{statusBarHeight}}px">
  <view class="ca-head"><text class="ca-title">购物车</text></view>
  <view class="ca-truck"><px-truck id="truck" cargo="{{cargo}}" /></view>

  <block wx:if="{{items.length}}">
    <scroll-view class="ca-list" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="ca-rows">
        <view class="ca-row" wx:for="{{items}}" wx:key="lineId">
          <view class="ca-check-hit" data-id="{{item.id}}" data-sku="{{item.sku}}" catch:tap="onToggle">
            <view class="k k-sm k-light ca-check" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">
              <px-i wx:if="{{item.selected}}" name="check" tone="#8a5ae0" />
            </view>
          </view>
          <view class="ca-thumb" data-id="{{item.id}}" catch:tap="onOpen">
            <!-- 焦点 50% 40%（设计稿 object-position）：<image> 的 aspectFill 只能居中，改背景图定焦点 -->
            <view wx:if="{{item.cover}}" class="ca-thumb-img" style="background-image: url('{{item.cover}}')"></view>
          </view>
          <view class="ca-mid" data-id="{{item.id}}" catch:tap="onOpen">
            <text class="ca-name">{{item.name}}</text>
            <text class="t-sys ca-sku" wx:if="{{item.sku}}">{{item.sku}}</text>
          </view>
          <view class="ca-right">
            <text class="mono ca-price {{item.selected ? '' : 'ca-price-off'}}">¥{{item.priceNum}}</text>
            <view class="ca-step">
              <!-- 数量 >1：减号；=1：红色 ×，按住 0.6s 删除（防误删·设计稿「危险操作用浅色键+红字+长按」） -->
              <view wx:if="{{item.qty > 1}}" class="ca-step-hit ca-step-l" data-id="{{item.id}}" data-sku="{{item.sku}}" catch:tap="onDec">
                <view class="k k-sm k-light ca-step-key" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i name="minus" /></view>
              </view>
              <view wx:else class="ca-step-hit ca-step-l" data-line="{{item.lineId}}" data-id="{{item.id}}" data-sku="{{item.sku}}"
                catch:touchstart="onHoldStart" bind:touchmove="onHoldMove" catch:touchend="onHoldEnd" catch:touchcancel="onHoldEnd">
                <view class="k k-sm k-light ca-step-key ca-del {{holding === item.lineId ? 'ca-del-on' : ''}}" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">
                  <view class="ca-del-fill"></view>
                  <px-i name="times" />
                </view>
              </view>
              <text class="mono ca-qty">{{item.qty}}</text>
              <view class="ca-step-hit ca-step-r" data-id="{{item.id}}" data-sku="{{item.sku}}" catch:tap="onInc">
                <view class="k k-sm k-light ca-step-key" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i name="plus" /></view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="ca-foot">
      <view class="ca-sum">
        <text class="t-sys ca-sum-k">小计</text>
        <view class="ca-leader"></view>
        <text class="mono ca-sum-v">{{totalLabel}}</text>
      </view>
      <!-- tab 首屏只能用 tier1 字：完整政策写在详情/结算/协议。勿写七天无理由。 -->
      <text class="t-sys ca-policy">包邮到家 · 售后无忧</text>
      <view wx:if="{{selectedCount}}" class="k k-ink k-48" hover-start-time="20" hover-class="k-ink-down" hover-stay-time="100" bind:tap="onCheckout" data-k="ink" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">结算（{{selectedCount}}）</view>
      <view wx:else class="k k-flat k-48" hover-start-time="20" hover-class="k-flat-down" hover-stay-time="100" bind:tap="onCheckout" data-k="flat" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">选择要结算的商品</view>
    </view>
  </block>

  <!-- 空车补出路：只有一行灰字的话，整页就没地方可去了 -->
  <view wx:else class="ca-empty">
    <text class="ca-empty-t">购物车还是空的</text>
    <view class="k k-light" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onGoHome" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">去首页逛逛</view>
  </view>
  <view class="ca-tab-space"></view>
</view>

<!-- 自绘轻提示（按住删除/已删除/先勾选·lib/pxFx fxHint） -->
<px-fx id="fx" />

<!-- 误触退出提醒（决策§30）：隐形容器武装拦第一次返回 →「再按一次退出」·仅安卓返回键·见 utils/exitGuard -->
<page-container show="{{exitGuardArmed}}" overlay="{{false}}" duration="{{0}}" bindbeforeleave="onExitGuardBeforeLeave" />
