<view class="ld-mc">
  <!-- 顶栏标题在原生导航条；此处编辑式副标题 -->
  <view class="ld-mc-intro" wx:if="{{!loading && list.length}}">
    <view class="ld-mc-eyebrow">MY COURSES</view>
    <view class="ld-mc-lead">{{list.length}} 门课程 · 继续钩下去</view>
  </view>

  <!-- 骨架占位（加载中，不写死假进度） -->
  <view class="ld-mc-list" wx:if="{{loading}}">
    <view class="ld-mc-card" wx:for="{{[1,2]}}" wx:key="*this">
      <view class="ld-mc-cover ld-mc-skel"></view>
      <view class="ld-mc-meta">
        <view class="ld-mc-skel-line"></view>
      </view>
    </view>
  </view>

  <!-- 课程卡列表 -->
  <view class="ld-mc-list" wx:if="{{!loading && list.length}}">
    <view class="ld-mc-card" wx:for="{{list}}" wx:key="courseId" data-id="{{item.courseId}}" bind:tap="onTapCourse" hover-class="ld-mc-card-h" hover-stay-time="80">
      <view class="ld-mc-cover">
        <view class="ld-mc-cover-scrim"></view>
        <view class="ld-mc-play">
          <image class="ld-mc-play-ico" src="/static/icons/play.svg" mode="aspectFit" />
        </view>
        <view class="ld-mc-cover-title">{{item.title}}</view>
        <image class="ld-mc-cover-chev" src="/static/icons/chevron-right.svg" mode="aspectFit" />
      </view>
      <!-- 学习进度（段粒度·与后台 360 同口径·无段不渲染·真值不编数·独立整行） -->
      <!-- 进度没读到（progressUnknown·根因#14）：不画 0% 进度条冒充「一段没学过」。
           本页没有下拉刷新，点这一行走已有 onRetryLoad；catch 住，避免连课卡一起点进目录。 -->
      <view class="ld-mc-prog" wx:if="{{item.totalSegments && item.progressUnknown}}" catch:tap="onRetryLoad" hover-class="ld-mc-prog-unknown-h" hover-stay-time="80">
        <view class="ld-mc-prog-text ld-mc-prog-unknown">学习进度暂时读不到，<text class="ld-mc-prog-retry">点此重试</text></view>
      </view>
      <view class="ld-mc-prog" wx:elif="{{item.totalSegments}}">
        <!-- percent=0 不渲染 fill：min-width 下限只该抬「已学一点点」，不能让「一段没学」也显出一截紫条（自查发现·2026-07-25） -->
        <view class="ld-mc-prog-track"><view wx:if="{{item.percent > 0}}" class="ld-mc-prog-fill" style="width: {{item.percent}}%"></view></view>
        <!-- 单位「段」对齐数据模型与目录页（章>课时>段落·2026-07-25 体检批 P3）：此处数的是 segments，
             原写「集」是全仓孤例，与课程目录页的「课时/段落」对不上号，同一门课出现三种叫法。 -->
        <view class="ld-mc-prog-text">已学 {{item.doneCount}}/{{item.totalSegments}} 段 · {{item.percent}}%</view>
      </view>
      <view class="ld-mc-meta">
        <view class="ld-mc-entered" wx:if="{{item.enteredAtLabel}}">进课于 {{item.enteredAtLabel}}</view>
        <view class="ld-mc-entered ld-mc-entered-faint" wx:else>视频课程</view>
        <view class="ld-mc-go">
          继续学习
          <image class="ld-mc-go-ico" src="/static/icons/chevron-right.svg" mode="aspectFit" />
        </view>
      </view>
    </view>
  </view>

  <!-- 失败态与空态分治（根因#14·守卫 rw-mp-list-loadfailed-state）：弱网失败不引导输码 -->
  <view class="ld-mc-empty" wx:if="{{!loading && loadFailed}}">
    <view class="ld-mc-empty-title">网络开小差</view>
    <view class="ld-mc-empty-hint">课程没加载出来，请重试</view>
    <view class="ld-mc-empty-btn" bind:tap="onRetryLoad" hover-class="ld-mc-empty-btn-h" hover-stay-time="80">重试</view>
  </view>

  <!-- 空态 -->
  <view class="ld-mc-empty" wx:elif="{{!loading && !list.length}}">
    <view class="ld-mc-empty-ico">
      <image class="ld-mc-empty-img" src="/static/icons/graduation-cap.svg" mode="aspectFit" />
    </view>
    <view class="ld-mc-empty-title">还没有进行中的课程</view>
    <view class="ld-mc-empty-hint">扫描二维码开始</view>
    <view class="ld-mc-empty-btn" bind:tap="onActivate" hover-class="ld-mc-empty-btn-h" hover-stay-time="80">输入激活码</view>
  </view>
</view>
