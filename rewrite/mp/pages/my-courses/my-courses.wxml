<!-- 我的课程（v5「字重」稿 C5）：课卡（缩略占位 + 课名 + 像素分段进度 + 已学/百分比）；空态给「去逛逛」（不做应用内扫码·15 问 12b） -->
<v5-nav title="我的课程" />

<view class="mc">
  <text class="mc-title">我的课程</text>

  <!-- 失败态与空态分治（根因#14·守卫 rw-mp-list-loadfailed-state）：弱网失败不引导输码 -->
  <view class="mc-state mc-fail" wx:if="{{!loading && loadFailed}}">
    <px-anim name="signal" size="4" />
    <text class="mc-state-t">网络开小差</text>
    <text class="t-sys mc-state-h">课程没加载出来，请重试</text>
    <view class="k k-light mc-retry" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onRetryLoad" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">重试</view>
  </view>

  <!-- 骨架占位（加载中，不写死假进度） -->
  <view class="mc-list mc-list-load" wx:elif="{{loading}}">
    <view class="t-sys mc-loading"><px-anim name="loader" size="2" /><text>加载中</text></view>
    <view class="mc-card mc-skel-card px-skin px-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
      <view class="mc-skel-bar skel" style="width: 96px"></view>
      <view class="mc-row">
        <view class="mc-skel-thumb skel"></view>
        <view class="mc-body">
          <view class="mc-skel-bar skel" style="width: 60%"></view>
          <view class="mc-skel-bar skel" style="width: 36%"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 课卡列表 -->
  <view class="mc-list" wx:elif="{{list.length}}">
    <view class="k-card mc-card px-skin px-card" wx:for="{{list}}" wx:key="courseId" data-id="{{item.courseId}}" bind:tap="onTapCourse" hover-start-time="20" hover-class="k-card-down" hover-stay-time="100">
      <view class="mc-row">
        <view class="mc-thumb px-clip-4"></view>
        <view class="mc-body">
          <text class="t-sys mc-name">{{item.title}}</text>
          <!-- 进度没读到（progressUnknown·根因#14）：不画 0% 进度条冒充「一段没学过」。
               本页没有下拉刷新，点这一行走已有 onRetryLoad；catch 住，避免连课卡一起点进目录。 -->
          <view class="mc-meta" wx:if="{{item.totalSegments && item.progressUnknown}}" catch:tap="onRetryLoad" hover-start-time="20" hover-class="k-row-down" hover-stay-time="100">
            <text class="t-sys mc-left">学习进度暂时读不到，<text class="mc-retry-t">点此重试</text></text>
          </view>
          <block wx:elif="{{item.totalSegments}}">
            <!-- 像素分段进度（高 4·每格 4 间隔 2·直角）：已学墨色、未学凹槽灰；percent=0 不画填充 -->
            <view class="mc-track"><view wx:if="{{item.percent > 0}}" class="mc-fill" style="width: {{item.percent}}%"></view></view>
            <view class="mc-meta">
              <!-- 单位「段」对齐数据模型与目录页（章>课时>段落）：此处数的是 segments，别另起「集」之类叫法。 -->
              <text class="t-sys mc-left">已学 {{item.doneCount}}/{{item.totalSegments}} 段</text>
              <view class="t-sys mc-fin" wx:if="{{item.percent >= 100}}"><px-i name="led" tone="var(--v5-ok)" /><text>学完</text></view>
              <text class="mono mc-pct" wx:else>{{item.percent}}%</text>
            </view>
          </block>
        </view>
      </view>
    </view>
  </view>

  <!-- 空态（15 问 12b）：全站统一叫「激活卡」；小程序里不做扫码/输码入口，给「去逛逛」出口 -->
  <view class="mc-state" wx:else>
    <view style="padding-top: {{groundGap - 36}}px"><px-ground kind="box" /></view>
    <text class="mc-state-t">还没有课程</text>
    <text class="t-sys mc-state-h">用微信「扫一扫」材料包里的激活卡，课程会出现在这里</text>
    <view class="k k-light mc-retry" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onGoShop" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">去逛逛</view>
  </view>

</view>
<px-fx id="fx" />
