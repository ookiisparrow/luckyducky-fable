/* 我的课程（v5「字重」稿 C5） */
page {
  background: var(--v5-canvas);
  color: var(--v5-ink);
}
.mc-title {
  display: block;
  padding: 4px 16px 0;
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.01em;
}

/* 课卡 */
.mc-list {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.mc-list-load {
  padding-top: 12px;
}
.mc-card {
  border-radius: 8px;
  background: #fff;
  box-shadow: 0 0 0 1px var(--v5-hair);
  padding: 16px;
}
/* 卡片按下（设计稿 PRESS.card：底 #f3f3f0·下沉 1px） */
.mc-row {
  display: flex;
  align-items: center;
  gap: 12px;
}
/* 课程缩略：无课程图数据，按设计稿无图态画斜纹占位 */
.mc-thumb {
  width: 64px;
  height: 64px;
  flex: 0 0 auto;
  border-radius: 4px;
  background: repeating-linear-gradient(135deg, #ededea 0 5px, #e3e3df 5px 10px);
}
.mc-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.mc-name {
  font-size: 17px;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 分段条：高 4、每格 4 间隔 2、直角（设计规范·像素小元素）；已学墨色、未学 #E0E1D9 */
.mc-track {
  position: relative;
  height: 4px;
  background: repeating-linear-gradient(90deg, #e0e1d9 0 4px, transparent 4px 6px);
}
.mc-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  min-width: 4px;
  background: repeating-linear-gradient(90deg, var(--v5-ink) 0 4px, transparent 4px 6px);
}
.mc-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}
.mc-left {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.mc-retry-t {
  color: var(--v5-violet-text);
  font-weight: 500;
}
.mc-pct {
  font-size: 13px;
  font-weight: 500;
  color: var(--v5-ink-2);
}
.mc-fin {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: var(--v5-ok-text);
}

/* 加载中 */
.mc-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 2px 0 4px;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.mc-skel-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.mc-skel-bar {
  height: 12px;
  background: var(--v5-sunk);
}
.mc-skel-thumb {
  width: 44px;
  height: 44px;
  flex: 0 0 auto;
  border-radius: 4px;
  background: var(--v5-sunk);
}

/* 失败 / 空 */
.mc-state {
  padding: 0 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  text-align: center;
}
.mc-fail {
  padding-top: 88px;
}
.mc-empty {
  padding-top: 64px;
}
.mc-state-t {
  font-size: 17px;
  font-weight: 500;
}
.mc-state-h {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.mc-retry {
  margin-top: 8px;
  width: 120px;
}

/* 底部操作区 */
