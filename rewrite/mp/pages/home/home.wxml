<!-- 首页（v5「字重」稿 A1）。整页内容套 <scroll-view>：退出提醒的 page-container 武装态会冻结页面级滚动（决策§30·见 utils/exitGuard），
     滚动/下拉刷新/锚点跳转全部改在 scroll-view 内发生：
       · 下拉刷新 ← 原 enablePullDownRefresh（页面级下拉在 fixed 下失效）→ refresher-enabled + bindrefresherrefresh
       · 锚点跳转 ← 原 wx.pageScrollTo({selector}) （scroll-view 内不生效）→ scroll-into-view（见 home.ts scrollTo）
       · 回顶按钮阈值 ← 原 onPageScroll → bindscroll
     顶栏（状态栏 + 44 logo 条）在 scroll-view 外固定不动；浮层（回顶/toast/登录半屏/开屏）fixed 当兄弟。 -->
<view class="hm-bar" style="padding-top: {{statusBarHeight}}px">
  <image class="hm-bar-logo" src="/static/logo-wordmark.svg" mode="heightFix" />
</view>
<scroll-view class="hm-scroll" style="top: {{statusBarHeight + 44}}px" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}"
  refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresher"
  refresher-background="#fafaf8" scroll-into-view="{{scrollInto}}" scroll-with-animation="{{scrollAnim}}"
  bindscroll="onScroll">

  <!-- 回顶锚点（scroll-into-view 目标·零高度不占版式） -->
  <view id="top"></view>

  <!-- ① 首屏：1:1 主图 + 大标题 + 两键（高度＝可视区减底部 TabBar，一屏看完） -->
  <view class="hm-fold" style="height: calc(100vh - {{statusBarHeight + 44}}px - 52px - max(24px, env(safe-area-inset-bottom)))">
    <view class="hm-gap-a"></view>
    <view class="hm-hero">
      <image wx:if="{{content.hero.img}}" class="hm-hero-img" src="{{content.hero.img}}" mode="aspectFill" />
      <view class="hm-fade-top"></view>
      <view class="hm-fade-bottom"></view>
    </view>
    <view class="hm-gap-b"></view>
    <view class="hm-hero-copy">
      <text class="hm-display">{{content.hero.title}}</text>
      <text class="mono hm-tagline">{{content.hero.tagline}}</text>
    </view>
    <view class="hm-hero-keys">
      <view class="k k-light hm-search" hover-class="k-light-down" hover-stay-time="100" bind:tap="toIntro">
        <text class="hm-search-text">{{content.hero.search}}</text>
        <px-i name="down" tone="#62625c" />
      </view>
      <view class="k k-ink hm-buy" hover-class="k-ink-down" hover-stay-time="100" bind:tap="toProducts">购买</view>
    </view>
    <view class="hm-gap-c"></view>
  </view>

  <!-- ② 品牌：logo + 一句话 + 三幕像素小鸭 -->
  <view class="hm-brand" id="intro">
    <image class="hm-brand-logo" src="/static/logo-wordmark.svg" mode="heightFix" />
    <text class="t-sys hm-lead">{{content.brand.lead}}</text>
  </view>
  <view class="hm-scenes">
    <view class="hm-scene" wx:for="{{scenes}}" wx:key="kind">
      <px-scene kind="{{item.kind}}" />
      <text class="hm-scene-cap">{{item.caption}}</text>
    </view>
  </view>

  <!-- ③ 套装：标题 + 商品横滑 -->
  <view class="hm-sec" id="friends">
    <text class="hm-h2">{{content.feature.title}}</text>
    <text class="t-sys hm-sub">{{content.feature.body}}</text>
  </view>
  <scroll-view wx:if="{{products.length}}" class="hm-rail" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="hm-card" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bind:tap="onTapProduct">
      <view class="hm-card-media">
        <image wx:if="{{item.cover}}" class="hm-card-img" src="{{item.cover}}" mode="aspectFill" />
      </view>
      <view class="hm-card-info">
        <text class="hm-card-name">{{item.name}}</text>
        <view class="hm-card-foot">
          <text class="mono hm-price">{{item.priceLabel}}</text>
          <view class="hm-add-hit" catch:tap="onAddProduct" data-id="{{item.id}}">
            <view class="k k-light hm-add" hover-class="k-light-down" hover-stay-time="100"><px-i name="plus" /></view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
  <view wx:elif="{{loading}}" class="hm-rail hm-rail-skel">
    <view class="hm-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
      <view class="hm-card-media skel"></view>
      <view class="hm-skel-line skel"></view>
      <view class="hm-skel-line short skel"></view>
    </view>
  </view>
  <view wx:else class="t-sys hm-empty">{{loadFailed ? '货架暂时没连上云端，下拉重试' : '上新在路上，先逛逛别处吧'}}</view>

  <!-- ④ 信任条：三格像素动画 -->
  <view class="hm-trust">
    <view class="hm-trust-item" wx:for="{{content.trust}}" wx:key="label">
      <view class="hm-trust-ico"><px-anim name="{{item.anim}}" size="4" delay="{{index * 600}}" /></view>
      <text class="hm-trust-label">{{item.label}}</text>
    </view>
  </view>

  <!-- ⑤ 拆门槛：编号平铺（配图 + 编号标题 + 正文） -->
  <view class="hm-sec hm-sec-tight">
    <text class="hm-h2">{{content.reassure.heading}}</text>
    <text class="t-sys hm-sub">{{content.reassure.lead}}</text>
  </view>
  <view class="hm-reassure">
    <view class="hm-rs" wx:for="{{content.reassure.items}}" wx:key="title">
      <view wx:if="{{item.img}}" class="hm-rs-media">
        <image class="hm-rs-img" src="{{item.img}}" mode="aspectFill" lazy-load />
      </view>
      <view class="hm-rs-head">
        <text class="mono hm-no">{{index < 9 ? '0' : ''}}{{index + 1}}</text>
        <text class="hm-rs-title">{{item.title}}</text>
      </view>
      <text class="t-sys hm-body">{{item.body}}</text>
    </view>
  </view>

  <!-- ⑥ 真实买家秀 -->
  <view class="hm-sec"><text class="hm-h2">{{content.reviews.heading}}</text></view>
  <scroll-view class="hm-rail hm-rail-reviews" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="hm-rv" wx:for="{{content.reviews.items}}" wx:key="user">
      <view class="hm-rv-media">
        <image wx:if="{{item.img}}" class="hm-card-img" src="{{item.img}}" mode="aspectFill" />
      </view>
      <view class="hm-rv-body">
        <view class="hm-stars"><px-i wx:for="{{[1, 2, 3, 4, 5]}}" wx:key="*this" wx:for-item="s" name="star5" /></view>
        <text class="t-sys hm-rv-quote">{{item.quote}}</text>
        <view class="hm-rv-meta">
          <text class="hm-rv-user">{{item.user}}</text>
          <view class="hm-verified">
            <px-i name="led" tone="#3f9a5e" />
            <text>已验证买家</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- ⑦ 大家都在问：编号行，点开/收起 -->
  <view class="hm-sec"><text class="hm-h2">大家都在问</text></view>
  <view class="hm-faq">
    <view class="hm-faq-item" wx:for="{{content.faq}}" wx:key="title">
      <view class="hm-faq-row" hover-class="k-row-down" data-index="{{index}}" bind:tap="toggleFaq">
        <text class="mono hm-no {{openFaq === index ? 'hm-no-on' : ''}}">{{index < 9 ? '0' : ''}}{{index + 1}}</text>
        <text class="hm-faq-title">{{item.title}}</text>
        <text class="hm-faq-act">{{openFaq === index ? '收起' : '展开'}}</text>
      </view>
      <text wx:if="{{openFaq === index}}" class="t-sys hm-faq-body">{{item.body}}</text>
    </view>
  </view>

  <!-- ⑧ 收尾：大图 + 大字 + 墨黑键（带一道扫光） -->
  <view class="hm-closing">
    <view class="hm-closing-media">
      <image wx:if="{{content.closing.img}}" class="hm-hero-img" src="{{content.closing.img}}" mode="aspectFill" lazy-load />
      <view class="hm-fade-top"></view>
      <view class="hm-fade-bottom hm-fade-short"></view>
    </view>
    <view class="hm-closing-copy">
      <text class="hm-closing-title">{{content.closing.title}}</text>
      <view class="k k-ink k-48 hm-closing-btn" hover-class="k-ink-down" hover-stay-time="100" bind:tap="toProducts">
        <view class="hm-sheen"></view>
        <text class="hm-closing-cta">{{content.closing.cta}}</text>
      </view>
    </view>
  </view>

  <!-- ⑨ 页脚 -->
  <view class="hm-footer">
    <image class="hm-footer-logo" src="/static/logo-wordmark.svg" mode="heightFix" />
    <view class="hm-footer-links">
      <block wx:for="{{content.footer.links}}" wx:key="*this">
        <text wx:if="{{index > 0}}" class="hm-footer-dot">·</text>
        <text class="hm-footer-link" data-label="{{item}}" bind:tap="onTapFooterLink">{{item}}</text>
      </block>
    </view>
    <text class="mono hm-footer-copy">{{content.footer.copy}}</text>
  </view>
  <view class="hm-tab-space"></view>
</scroll-view>

<!-- 回到顶部（滚过一屏半浮现） -->
<view wx:if="{{showTop}}" class="k k-light hm-backtop" hover-class="k-light-down" hover-stay-time="100" bind:tap="backTop">
  <px-i name="up" />
  <text>顶部</text>
</view>

<!-- 轻提示 -->
<view class="ld-toast {{toast.show ? 'show' : ''}}"><text>{{toast.text}}</text></view>

<!-- 登录授权半屏（R1·软门槛）：进 App 首个落地页即弹（未同意时·本会话一次）·可「暂不登录」关掉先逛·经 lib/loginGate 单例驱动 -->
<login-sheet />

<!-- 冷启动品牌开屏（每次冷启动一次·min-hold+数据就绪 race+硬上限自撤后 onSplashDone 撤下）·全屏 fixed 覆盖层压过 tabBar 与登录半屏 -->
<brand-splash wx:if="{{showSplash}}" ready="{{splashReady}}" bind:done="onSplashDone" />

<!-- 误触退出提醒（决策§30）：隐形容器武装拦第一次返回 →「再按一次退出」·仅安卓返回键·见 utils/exitGuard -->
<page-container show="{{exitGuardArmed}}" overlay="{{false}}" duration="{{0}}" bindbeforeleave="onExitGuardBeforeLeave" />
