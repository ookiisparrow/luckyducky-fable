/* 首页（v5「字重」稿 A1）。尺寸用 px 对齐设计稿（390 宽基准）；色值只来自 tokens.wxss 的 --v5-*。 */
page {
  background: var(--v5-canvas);
  color: var(--v5-ink);
}

/* 顶栏：状态栏 + 44 logo 条（右侧留给胶囊） */
.hm-bar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 10;
  background: var(--v5-canvas);
}
.hm-bar-logo {
  display: block;
  height: 22px;
  margin: 11px 104px 11px 16px;
}
.hm-scroll {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--v5-canvas);
}

/* ① 首屏 */
.hm-fold {
  min-height: 360px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.hm-gap-a {
  flex: 2 1 0;
  min-height: 0;
  max-height: 76px;
}
.hm-gap-b {
  flex: 2 1 0;
  min-height: 0;
  max-height: 72px;
}
.hm-gap-c {
  flex: 3 1 0;
  min-height: 0;
}
.hm-hero {
  flex: 0 1 auto;
  min-height: 0;
  aspect-ratio: 1 / 1;
  position: relative;
  overflow: hidden;
  background: var(--v5-sunk);
}
.hm-hero-img {
  display: block;
  width: 100%;
  height: 100%;
}
/* 裁切焦点 50% 40%（设计稿 object-position）：widthFix 图按宽铺满、高度随图，
   top 40% + translateY(-40%) ＝ 上移（图高−框高）×40%，与 object-position 同公式。横图不挂本类（见 home.ts onImgLoad）。 */
.focus-img {
  position: absolute;
  left: 0;
  top: 40%;
  transform: translateY(-40%);
}
.hm-fade-top {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 12%;
  background: linear-gradient(to top, rgba(250, 250, 248, 0), var(--v5-canvas));
  pointer-events: none;
}
.hm-fade-bottom {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 36%;
  background: linear-gradient(to bottom, rgba(250, 250, 248, 0), var(--v5-canvas) 88%);
  pointer-events: none;
}
.hm-fade-short {
  height: 16%;
}
.hm-hero-copy {
  flex: 0 0 auto;
  padding: 12px 16px 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  text-align: center;
}
.hm-display {
  font-size: 48px;
  font-weight: 900;
  letter-spacing: -0.01em;
  line-height: 1.1;
}
.hm-tagline {
  font-size: 15px;
  letter-spacing: -0.01em;
  color: var(--v5-ink-2);
}
.hm-hero-keys {
  flex: 0 0 auto;
  padding: 16px;
  display: flex;
  gap: 8px;
}
.hm-search {
  flex: 1;
  min-width: 0;
}
.hm-search-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hm-buy {
  flex: 0 0 96px;
  padding: 0;
}

/* ② 品牌 + 三幕 */
.hm-brand {
  padding: 56px 32px 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  text-align: center;
}
.hm-brand-logo {
  height: 28px;
}
.hm-lead {
  font-size: 17px;
  font-weight: 500;
  line-height: 1.7;
  color: var(--v5-ink-2);
}
.hm-scenes {
  margin-top: 32px;
  padding: 0 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.hm-scene {
  aspect-ratio: 1 / 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20px;
}
.hm-scene-cap {
  font-size: 17px;
  font-weight: 500;
}

/* 通用段落头 */
.hm-sec {
  padding: 56px 16px 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.hm-sec-tight {
  gap: 8px;
}
.hm-h2 {
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.01em;
}
.hm-sub,
.hm-body {
  font-size: 17px;
  font-weight: 500;
  line-height: 1.65;
  color: var(--v5-ink-2);
}
.hm-body {
  line-height: 1.7;
}
.hm-no {
  font-size: 15px;
  font-weight: 600;
  color: var(--v5-ink-2);
}
.hm-no-on {
  color: var(--v5-violet-text);
}

/* 下拉刷新区（设计稿物流页：高 64、居中、加载器 + 13px 细字 #62625c） */
.hm-ptr {
  width: 100vw; /* refresher 插槽按内容定宽（工具实测 103px），不撑满就不居中 */
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
}
.hm-ptr-t {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}

/* ③ 商品横滑 */
.hm-rail {
  margin-top: 12px;
}
/* 横排层（设计稿 data-scroll="rail"：flex + gap + padding 1px 16px 4px）。余量不能写在 scroll-view 上——
   安卓真机 scroll-view 的 padding 不生效，卡片 1px 外描边顶边被裁（老板真机截图）；flex 同排默认拉齐＝卡片等高。 */
.hm-rail-row {
  display: flex;
  gap: 16px;
  width: max-content;
  padding: 1px 16px 4px;
}
.hm-card {
  flex: 0 0 148px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.hm-card-media {
  position: relative;
  aspect-ratio: 1 / 1;
  border-radius: 4px;
  overflow: hidden;
  background: var(--v5-sunk);
}
.hm-card-img {
  display: block;
  width: 100%;
  height: 100%;
}
.hm-card-info {
  padding: 0 1px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.hm-card-name {
  font-size: 17px;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hm-card-foot {
  margin-top: 2px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hm-price {
  font-size: 17px;
  font-weight: 600;
}
.hm-add-hit {
  width: 44px;
  height: 44px;
  margin: -6px -6px -6px 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hm-add {
  width: 32px;
  height: 32px;
  padding: 0;
}
.hm-loading {
  padding: 2px 0 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.hm-skel-line {
  height: 17px;
  border-radius: 4px;
}
.hm-skel-line.short {
  width: 64px;
}
.hm-empty {
  display: block;
  padding: 24px 16px 0;
  font-size: 15px;
  color: var(--v5-ink-2);
}

/* ④ 信任条 */
.hm-trust {
  margin: 40px 16px 0;
  display: flex;
  border-top: 1px solid var(--v5-hair);
  border-bottom: 1px solid var(--v5-hair);
}
.hm-trust-item {
  flex: 1;
  min-width: 0;
  padding: 24px 4px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}
.hm-trust-ico {
  height: 52px;
  display: flex;
  align-items: center;
}
.hm-trust-label {
  font-size: 17px;
  font-weight: 500;
}

/* ⑤ 拆门槛 */
.hm-reassure {
  padding: 16px 16px 0;
  display: flex;
  flex-direction: column;
  gap: 32px;
}
.hm-rs {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.hm-rs-media {
  position: relative;
  aspect-ratio: 1 / 1;
  border-radius: 8px;
  overflow: hidden;
  background: var(--v5-sunk);
}
.hm-rs-img {
  display: block;
  width: 100%;
  height: 100%;
}
.hm-rs-head {
  display: flex;
  align-items: baseline;
  gap: 12px;
}
.hm-rs-title {
  font-size: 17px;
  font-weight: 500;
}

/* ⑥ 买家秀 */
.hm-rail-reviews {
  margin-top: 16px;
}
.hm-rail-reviews .hm-rail-row {
  gap: 12px;
}
.hm-rv {
  flex: 0 0 200px;
  display: flex;
  flex-direction: column;
  border-radius: 8px;
  background: var(--v5-surface);
  box-shadow: 0 0 0 1px var(--v5-hair);
  overflow: hidden;
}
.hm-rv-media {
  aspect-ratio: 3 / 4;
  background: var(--v5-sunk);
}
.hm-rv-body {
  flex: 1;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.hm-stars {
  height: 18px;
  display: flex;
  align-items: center;
  gap: 2px;
}
.hm-rv-quote {
  flex: 1; /* 撑满剩余高度 → 署名贴底（整排卡片等高＝最高那张） */
  font-size: 15px;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3; /* 最多 3 行（UI 审查 15 问 3a·全文是下一级信息） */
  overflow: hidden;
}
.hm-rv-meta {
  display: flex;
  align-items: center;
  gap: 8px;
}
.hm-rv-user {
  flex: 1;
  min-width: 0;
  font-size: 15px;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hm-verified {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ok-text);
}

/* ⑦ FAQ */
.hm-faq {
  padding: 16px 16px 0;
}
.hm-faq-item {
  border-top: 1px solid var(--v5-hair);
}
.hm-faq-item:last-child {
  border-bottom: 1px solid var(--v5-hair);
}
.hm-faq-row {
  min-height: 52px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.hm-faq-title {
  flex: 1;
  padding: 16px 0;
  font-size: 17px;
  font-weight: 500;
}
.hm-faq-act {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.hm-faq-body {
  display: block;
  padding: 0 0 16px 32px;
  font-size: 17px;
  font-weight: 500;
  line-height: 1.7;
  color: var(--v5-ink-2);
}

/* ⑧ 收尾 */
.hm-closing {
  margin-top: 56px;
}
.hm-closing-media {
  position: relative;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: var(--v5-sunk);
}
.hm-closing-copy {
  padding: 4px 16px 0;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.hm-closing-title {
  font-size: 30px;
  font-weight: 900;
  letter-spacing: -0.01em;
  line-height: 1.15;
  text-align: center;
}
.hm-closing-btn {
  position: relative;
  overflow: hidden;
  letter-spacing: -0.01em;
}
.hm-closing-cta {
  position: relative;
}
/* 像素光泽（v5 定稿 sheenEl）：紫棋盘 32 · 浅紫实色 16 · 深紫棋盘 32，不斜、无缝，steps(22) 一格一格扫过；
   上 4 下 7 让出键座。棋盘＝conic-gradient 8px 平铺（4px 一格）。 */
.hm-sheen {
  position: absolute;
  top: 4px;
  bottom: 7px;
  left: 0;
  display: flex;
  transform: translateX(-120px);
  animation: hm-sheen 3.6s steps(22) 1.2s infinite;
  pointer-events: none;
}
.hm-sheen-a {
  width: 32px;
  background-image: conic-gradient(var(--v5-violet) 25%, transparent 0 50%, var(--v5-violet) 0 75%, transparent 0);
  background-size: 8px 8px;
  opacity: 0.9;
}
.hm-sheen-b {
  width: 16px;
  background: var(--v5-violet-soft);
  opacity: 0.85;
}
.hm-sheen-c {
  width: 32px;
  background-image: conic-gradient(var(--v5-violet-text) 25%, transparent 0 50%, var(--v5-violet-text) 0 75%, transparent 0);
  background-size: 8px 8px;
  opacity: 0.7;
}
@keyframes hm-sheen {
  0% {
    transform: translateX(-120px);
  }
  38% {
    transform: translateX(420px);
  }
  100% {
    transform: translateX(420px);
  }
}

/* ⑨ 页脚 */
.hm-footer {
  margin: 56px 16px 0;
  padding-top: 24px;
  border-top: 1px solid var(--v5-hair);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}
.hm-footer-logo {
  height: 20px;
  opacity: 0.85;
}
.hm-footer-links {
  display: flex;
  align-items: center;
  gap: 8px;
}
.hm-footer-link,
.hm-footer-dot {
  padding: 8px 0;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.hm-footer-copy {
  font-size: 13px;
  color: var(--v5-ink-2);
  text-align: center;
}
.hm-tab-space {
  height: calc(72px + max(24px, env(safe-area-inset-bottom)));
}

/* 回到顶部 */
.hm-backtop {
  position: fixed;
  right: 16px;
  bottom: calc(64px + max(24px, env(safe-area-inset-bottom)));
  z-index: 5;
  height: 36px;
  padding: 0 12px;
  gap: 12px; /* 设计稿 gap 4 + 图标右边距 8 */
  font-size: 15px;
  box-shadow: inset 0 -2px 0 rgba(0, 0, 0, 0.08), 0 0 0 1px var(--v5-hair), 0 1px 2px rgba(17, 17, 17, 0.08),
    0 6px 14px -6px rgba(0, 0, 0, 0.25);
}
