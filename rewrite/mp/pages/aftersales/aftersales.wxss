/* 我的售后（v5「字重」稿 B4） */
page {
  background: var(--v5-canvas);
  color: var(--v5-ink);
}
.as-title {
  display: block;
  padding: 4px 16px 0;
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.01em;
}
/* 倒车进场的小货车：大标题下留出场景空间，地面线与其它带车页一致（顶栏下 120px 起算） */
.as-truck {
  padding: 84px 16px 12px;
}
.as-list {
  margin: 0 16px 16px;
  border-bottom: 1px solid var(--v5-hair);
}
.as-row {
  padding: 12px 0;
  display: flex;
  align-items: flex-start;
  gap: 12px;
  border-top: 1px solid var(--v5-hair);
}
.as-ico {
  width: 26px;
  flex: 0 0 auto;
  padding-top: 4px;
  display: flex;
  justify-content: center;
}
.as-coin {
  margin-top: -7px;
}
.as-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.as-top {
  display: flex;
  justify-content: space-between;
  gap: 8px;
}
.as-name {
  min-width: 0;
  font-size: 17px;
  font-weight: 500;
}
.as-st {
  flex: 0 0 auto;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
/* 状态字：只有已退款绿，其余次要灰（设计稿 AS_ST） */
.as-st-refunded {
  color: var(--v5-ok-text);
}
.as-note {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
/* 热区 ≥44 高：上下内边距加到 13px、再用负外边距吃回去（视觉位置与原 margin-top 2 + padding 4 一致） */
.as-link {
  align-self: flex-start;
  margin: -7px -12px -9px 0;
  padding: 13px 12px 13px 0;
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 300;
}
.as-more {
  padding: 8px 0 16px;
  text-align: center;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.as-loading {
  padding: 12px 0 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.as-skel {
  margin: 8px 16px 0;
  padding: 16px;
  border-radius: 8px;
  background: #ffffff;
  box-shadow: 0 0 0 1px var(--v5-hair);
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.as-skel-bar {
  height: 12px;
}
.as-skel-row {
  display: flex;
  align-items: center;
  gap: 12px;
}
.as-skel-thumb {
  width: 44px;
  height: 44px;
  flex: 0 0 auto;
  border-radius: 4px;
}
.as-skel-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.as-state {
  padding: 0 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  text-align: center;
}
/* 空态纸箱：与有记录时的小货车同一条地面线（.as-truck 同样下移 84px） */
.as-box {
  align-self: stretch;
  padding-top: 84px;
}
.as-signal {
  padding-top: 88px;
  display: flex;
}
.as-state-t {
  font-size: 17px;
  font-weight: 500;
}
.as-retry {
  margin-top: 8px;
  min-width: 120px;
}
.as-dock-space {
  height: calc(72px + max(28px, env(safe-area-inset-bottom)));
}
.as-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12px 16px max(28px, env(safe-area-inset-bottom));
  display: flex;
  background: var(--v5-canvas);
}
.as-cs {
  flex: 1;
}
