/* 结业页（v5「字重」稿 C10） */
/* 孵化小鸭：顶栏下 groundGap 处落地（屏高<700 为 56、其余 120·lib/ground·全站同一条地面线） */
.fn-egg {
  padding: 0 16px 12px;
}
.fn-copy {
  padding: 12px 16px 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  text-align: center;
}
.fn-name {
  font-size: 17px;
  font-weight: 500;
  color: var(--v5-ink-2);
}
.fn-title {
  font-size: 30px;
  font-weight: 900;
  letter-spacing: -0.01em;
  line-height: 1.2;
}
.fn-sub {
  font-size: 17px;
  font-weight: 500;
  line-height: 1.6;
  color: var(--v5-ink-2);
}
.fn-stats {
  margin: 24px 16px 0;
  padding-top: 16px;
  border-top: 1px solid var(--v5-hair);
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.fn-row {
  display: flex;
  align-items: center;
  gap: 8px;
}
.fn-leader {
  flex: 1;
  height: 2px;
  background: repeating-linear-gradient(90deg, var(--v5-rule) 0 2px, transparent 2px 4px);
}
.fn-v {
  font-size: 15px;
}
/* 固定底栏的等高占位：内容滚到底不被底栏盖住（UI 审查 2026-09-29） */
.fn-dock-space {
  height: calc(60px + max(28px, env(safe-area-inset-bottom)));
}
.fn-main {
  flex: 1;
}
