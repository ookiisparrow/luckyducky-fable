/* 物流页壳（v5 设计稿「物流轨迹」341-350） */
page {
  background: var(--v5-canvas);
  color: var(--v5-ink);
}
/* 小货车：顶栏下 120px 处落地（全站同一条地面线） */
.lg-truck {
  padding: 120px 16px 12px;
}
.lg-no {
  padding: 4px 16px 0;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12px;
}
.lg-no-l {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.lg-co {
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.lg-track {
  font-size: 22px;
  font-weight: 600;
  letter-spacing: -0.01em;
  word-break: break-all;
}
/* 平面「复制」键：32 高、13/300 灰字（设计稿 copyTrack） */
.lg-copy {
  height: 32px;
  padding: 0 12px;
  flex: 0 0 auto;
  font-size: 13px;
  font-weight: 500; /* 圆体不出细体字重（只 500/700/900） */
  color: var(--v5-ink-2);
}
.lg-more {
  padding: 24px 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.lg-note {
  text-align: center;
  font-size: 13px;
  font-weight: 300;
  color: var(--v5-ink-2);
}
.lg-skel {
  padding: 4px 16px 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.lg-skel-bar {
  height: 13px;
}
.lg-skel-big {
  height: 22px;
}
.lg-state {
  padding: 12px 16px 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}
.lg-state-t {
  font-size: 17px;
  font-weight: 500;
}
.lg-retry {
  min-width: 120px;
}
