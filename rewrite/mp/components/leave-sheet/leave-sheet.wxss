/* 设计稿「放弃编辑确认」半屏（main.dc.html 693-699）：z 140、圆角 12、内边距 12/16/28、间距 16 */
.lv-root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 140;
}
.lv-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}
.lv-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 12px 12px 0 0;
  background: var(--v5-canvas);
  padding: 12px 16px max(28px, env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.lv-grip {
  align-self: center;
  width: 36px;
  height: 4px;
  border-radius: 2px;
  background: var(--v5-grab);
}
.lv-t {
  padding-top: 4px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.lv-h {
  font-size: 20px;
  font-weight: 700;
}
.lv-sub {
  font-size: 17px;
  font-weight: 500;
  line-height: 1.5;
  color: var(--v5-ink-2);
}
.lv-ks {
  padding-top: 8px;
  display: flex;
  gap: 8px;
}
.lv-go {
  flex: 1;
  color: var(--v5-err-text);
}
.lv-stay {
  flex: 1.6;
}
