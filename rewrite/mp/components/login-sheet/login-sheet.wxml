<!-- 登录半屏（v5「字重」稿 D2）：顶边探头小鸭 + 字标 + 标题 + 协议勾选 + 暂不登录 / 微信一键登录。点遮罩＝暂不登录。
     遮罩/面板走全局 .sh-mask/.sh-panel（关时加 .out 下滑淡出）。 -->
<view wx:if="{{visible}}" class="v5-scope ls-root" catch:touchmove="noop">
  <view class="sh-mask ls-mask {{out ? 'out' : ''}}" bind:tap="onClose"></view>
  <view class="sh-panel ls-sheet {{out ? 'out' : ''}}">
    <view class="ls-duck"><px-duck scale="4" /></view>
    <image class="ls-logo" src="/static/logo-wordmark.svg" mode="heightFix" />
    <text class="ls-title">登录后同步订单与学习进度</text>

    <view class="ls-agree {{shake ? 'ls-shake' : ''}}">
      <view class="ls-hit" catch:tap="onToggleAgree">
        <view class="ls-check"><px-i wx:if="{{agreed}}" name="check" tone="var(--v5-violet)" /></view>
      </view>
      <view class="t-sys ls-agree-t">
        <text class="ls-agree-s" catch:tap="onToggleAgree">已阅读并同意</text>
        <text class="ls-link hit44" catch:tap="onUserAgreement">《用户协议》</text>
        <text class="ls-link hit44" catch:tap="onPrivacy">《隐私政策》</text>
      </view>
    </view>
    <text class="t-sys ls-cs-note">登录即默认开启受托客服数据共享，可随时撤回</text>

    <view class="ls-row">
      <view class="k k-flat k-48 ls-later k-sq" hover-start-time="20" hover-class="k-flat-down" hover-stay-time="100" catch:tap="onClose" data-k="flat" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i name="times" /></view>
      <!-- 始终墨黑主键做视觉引导（老板 2026-09-30 改·原「未勾协议置灰」）：未勾协议点了，协议行抖一下并提示先勾选（不代勾） -->
      <view class="k k-ink k-48 ls-go" hover-start-time="20" hover-class="k-ink-down" hover-stay-time="100" catch:tap="onLogin" data-k="ink" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">微信一键登录</view>
    </view>
  </view>
</view>
