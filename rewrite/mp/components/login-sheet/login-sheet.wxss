/* v5 半屏（稿 D2）：遮罩 rgba(17,17,17,.42) 淡入 + 面板自底滑入；privacy-sheet 同一套。 */
.ls-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 300;
  background: rgba(17, 17, 17, 0.42);
  display: flex;
  align-items: flex-end;
  animation: ls-fade 200ms ease-out both;
}
.ls-sheet {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  border-radius: 12px 12px 0 0;
  background: var(--v5-canvas);
  color: var(--v5-ink);
  padding: 12px 16px max(28px, env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16px;
  animation: ls-up 240ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}
/* 探头小鸭：13×7 格 ×4 = 52×28，底边压在面板顶边上 */
.ls-duck {
  position: absolute;
  right: 28px;
  top: -28px;
  line-height: 0;
  pointer-events: none;
}
.ls-grab {
  align-self: center;
  width: 36px;
  height: 4px;
  border-radius: 2px;
  background: rgba(17, 17, 17, 0.2);
}
.ls-logo {
  align-self: flex-start;
  height: 22px;
}
.ls-title {
  font-size: 20px;
  font-weight: 700;
}
.ls-agree {
  display: flex;
  align-items: center;
  gap: 12px;
}
/* 勾选框 22×22 浅色键帽，热区扩到 44 */
.ls-hit {
  flex: 0 0 auto;
  width: 44px;
  height: 44px;
  margin: -11px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ls-check {
  box-sizing: border-box;
  width: 22px;
  height: 22px;
  border-radius: 4px;
  background: #ffffff;
  box-shadow: inset 0 -2px 0 rgba(0, 0, 0, 0.08), 0 0 0 1px var(--v5-hair), 0 1px 2px rgba(17, 17, 17, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 0;
}
.ls-agree-t {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  font-size: 13px;
  font-weight: 300;
}
.ls-agree-s,
.ls-link {
  padding: 8px 0;
}
.ls-link {
  font-weight: 700;
}
.ls-row {
  display: flex;
  gap: 8px;
}
.ls-later {
  flex: 1;
  min-width: 0;
}
.ls-go {
  flex: 1.6;
  min-width: 0;
}
@keyframes ls-fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
@keyframes ls-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}
