/* v5 半屏（稿 D2）：遮罩/面板动效走 app.wxss .sh-mask/.sh-panel；这里只管摆位与版式。privacy-sheet 同一套。 */
.ls-root {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 300;
}
.ls-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}
.ls-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  border-radius: 12px 12px 0 0;
  background: var(--v5-canvas);
  color: var(--v5-ink);
  padding: 20px 16px max(28px, env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16px;
}
/* 探头小鸭：13×7 格 ×4 = 52×28，底边压在面板顶边上 */
.ls-duck {
  position: absolute;
  right: 28px;
  top: -28px;
  line-height: 0;
  pointer-events: none;
}
.ls-logo {
  align-self: flex-start;
  height: 22px;
}
.ls-title {
  font-size: 20px;
  font-weight: 700;
}
.ls-agree {
  display: flex;
  align-items: center;
  gap: 12px;
}
/* 勾选框 22×22 浅色键帽，热区扩到 44 */
.ls-hit {
  flex: 0 0 auto;
  width: 44px;
  height: 44px;
  margin: -11px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ls-check {
  box-sizing: border-box;
  width: 22px;
  height: 22px;
  border-radius: 4px;
  background: var(--v5-surface);
  box-shadow: inset 0 -2px 0 rgba(0, 0, 0, 0.08), 0 0 0 1px var(--v5-hair), 0 1px 2px rgba(17, 17, 17, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 0;
}
.ls-agree-t {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  font-size: 13px;
  font-weight: 300;
}
.ls-agree-s,
.ls-link {
  padding: 8px 0;
}
/* 数据共享默认开启告知（老板 2026-09-30·§40）：紧跟协议勾选 */
.ls-cs-note {
  margin-top: -8px;
  font-size: 13px;
  font-weight: 300; /* 与「已阅读并同意」同粗细（老板 2026-09-30） */
  color: var(--v5-ink-2);
}
.ls-link {
  font-weight: 700;
}
.ls-row {
  display: flex;
  gap: 8px;
}
.ls-later {
  flex: 1;
  min-width: 0;
}
.ls-go {
  flex: 1.6;
  min-width: 0;
}
/* 没勾协议点登录：协议行左右抖（设计稿 shake 360ms） */
.ls-shake {
  animation: ls-shake 360ms;
}
@keyframes ls-shake {
  20% {
    transform: translateX(-6px);
  }
  40% {
    transform: translateX(6px);
  }
  60% {
    transform: translateX(-4px);
  }
  80% {
    transform: translateX(3px);
  }
}
