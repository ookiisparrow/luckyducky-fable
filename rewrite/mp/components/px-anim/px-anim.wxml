<view wx:if="{{baked}}" class="{{bakedCls}}{{paused ? ' pxb-paused' : ''}}" style="{{bakedStyle}}"></view>
<view wx:else class="pxc" style="width:{{size * 13}}px;height:{{size * 13}}px">
  <view wx:for="{{pxRows}}" wx:key="t" wx:if="{{item.g}}" class="pxr" style="top:{{item.t}}px;height:{{pxCell}}px;background:{{item.g}}"></view>
</view>
