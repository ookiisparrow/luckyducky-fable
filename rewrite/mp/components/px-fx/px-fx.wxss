.fx {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 900;
}
.fx-block {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 901;
}
.fx-toast {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  z-index: 902;
}
