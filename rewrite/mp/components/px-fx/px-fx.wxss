.fx {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 900;
}
/* 跨页纯色遮罩（见 px-fx.ts 文件头）：.out 照设计稿 fxEnter 280ms ease-out 淡出 */
.fx-cover {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  transition: opacity 280ms ease-out;
}
.fx-cover.out {
  opacity: 0;
}
.fx-block {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 901;
}
.fx-toast {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  z-index: 902;
}
