<canvas type="2d" id="fx" class="fx"></canvas>
<view wx:if="{{cover}}" class="fx-cover {{coverOut ? 'out' : ''}}" style="background:{{cover}}" catch:touchstart="noop" catch:tap="noop"></view>
<!-- 自绘系统层（像素化 9c·老板 2026-09-30）：确认半屏（替原生 showModal）+ 轻提示/加载框（替原生 showToast/showLoading） -->
<!-- 标题与按键圆体（老板 2026-09-30「弹窗换圆体」）；正文黑体（同「放弃编辑」半屏） -->
<view wx:if="{{cf}}" class="v5-scope fx-cf" catch:touchmove="noop">
  <view class="sh-mask fx-cf-mask {{cfOut ? 'out' : ''}}" bind:tap="onCfMask"></view>
  <view class="sh-panel fx-cf-panel {{cfOut ? 'out' : ''}}">
    <view class="fx-cf-t">
      <text class="fx-cf-h">{{cf.title}}</text>
      <text wx:if="{{cf.content}}" class="t-sys fx-cf-sub">{{cf.content}}</text>
    </view>
    <view class="fx-cf-ks">
      <!-- 危险：左浅色红字按住 700ms 才执行，右墨黑＝保留 -->
      <block wx:if="{{cf.danger}}">
        <view class="k k-light k-48 fx-cf-l fx-cf-danger {{cfHold ? 'fx-hold-on' : ''}}" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100"
          catch:touchstart="onCfHoldStart" bind:touchmove="onCfHoldMove" catch:touchend="onCfHoldEnd" catch:touchcancel="onCfHoldCancel">
          <view class="fx-cf-fill px-clip-6"></view>
          <text class="fx-cf-kt">{{cf.confirmText}}</text>
        </view>
        <view class="k k-ink k-48 fx-cf-r" hover-start-time="20" hover-class="k-ink-down" hover-stay-time="100" bind:tap="onCfNo" data-k="ink" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">{{cf.cancelText}}</view>
      </block>
      <block wx:else>
        <view wx:if="{{!cf.single}}" class="k k-light k-48 fx-cf-l" hover-start-time="20" hover-class="k-light-down" hover-stay-time="100" bind:tap="onCfNo" data-k="light" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">{{cf.cancelText}}</view>
        <view class="k k-ink k-48 fx-cf-r" hover-start-time="20" hover-class="k-ink-down" hover-stay-time="100" bind:tap="onCfYes" data-k="ink" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">{{cf.confirmText}}</view>
      </block>
    </view>
  </view>
</view>
<view class="ld-toast fx-toast {{toastShow ? 'show' : ''}}">
  <px-anim wx:if="{{toastKind === 'loading'}}" name="loader" size="2" dark />
  <px-i wx:elif="{{toastKind === 'ok'}}" class="fx-ok" name="check" size="3" tone="var(--v5-canvas)" />
  <text>{{toastText}}</text>
</view>
<view wx:if="{{busy || blocking}}" class="fx-block" catch:touchstart="noop" catch:tap="noop"></view>
