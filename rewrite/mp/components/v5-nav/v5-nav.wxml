<view class="v5-scope nv-space" style="height:{{sb + 44}}px">
  <view class="nv-bar" style="padding-top:{{sb}}px">
    <!-- 返回只留像素箭头（v6 Lite 去键帽·老板 2026-09-30）：44×44 热区不变，按下淡一下 -->
    <view wx:if="{{back}}" class="nv-hit" bind:tap="onBack" hover-start-time="20" hover-class="press-fade" hover-stay-time="100" data-k="flat" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">
      <px-i name="back" />
    </view>
    <text wx:if="{{title}}" class="t-sys nv-title">{{title}}</text>
  </view>
</view>
