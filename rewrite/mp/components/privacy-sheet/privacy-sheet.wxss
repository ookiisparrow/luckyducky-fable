/* v5 半屏（同 login-sheet / 稿 D2）：遮罩 rgba(17,17,17,.42) 淡入 + 面板自底滑入。 */
.ps-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 300;
  background: rgba(17, 17, 17, 0.42);
  display: flex;
  align-items: flex-end;
  animation: ps-fade 200ms ease-out both;
}
.ps-sheet {
  width: 100%;
  box-sizing: border-box;
  border-radius: 12px 12px 0 0;
  background: var(--v5-canvas);
  color: var(--v5-ink);
  padding: 12px 16px max(28px, env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16px;
  animation: ps-up 240ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}
.ps-grab {
  align-self: center;
  width: 36px;
  height: 4px;
  border-radius: 2px;
  background: rgba(17, 17, 17, 0.2);
}
.ps-title {
  font-size: 20px;
  font-weight: 700;
}
.ps-body {
  font-size: 15px;
  font-weight: 400;
  line-height: 1.6;
  color: var(--v5-ink-2);
}
.ps-link {
  font-weight: 700;
  color: var(--v5-ink);
}
.ps-row {
  display: flex;
  gap: 8px;
}
.ps-no {
  flex: 1;
  min-width: 0;
}
/* 原生 button 去默认外观，交给 .k .k-ink 键帽（双类提权：压过内置 button:not([size=mini]) 等带属性选择器的默认样式） */
.ps-row .ps-btn {
  flex: 1.6;
  display: flex;
  height: 48px;
  background: var(--v5-key);
  color: var(--v5-key-hi);
  min-width: 0;
  width: auto;
  margin: 0;
  padding: 0 16px;
  line-height: normal;
  font-size: 17px;
  font-weight: 500;
  border-radius: 6px;
}
.ps-btn::after {
  border: none;
}
@keyframes ps-fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
@keyframes ps-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}
