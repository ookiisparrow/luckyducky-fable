/* v5 半屏（设计稿 723-731·同 login-sheet）：遮罩/面板动效走 app.wxss .sh-mask/.sh-panel；这里只管摆位与版式。 */
.ps-root {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 300;
}
.ps-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}
/* 设计稿 min-height = 登录半屏实测高（--lgh）。
   ponytail: 按登录半屏版式算死（12+把手4+字标22+标题28+协议行34+键48+间距16×4=212，再加底部安全区），登录半屏改版式要同步这里 */
.ps-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  min-height: calc(212px + max(28px, env(safe-area-inset-bottom)));
  border-radius: 12px 12px 0 0;
  background: var(--v5-canvas);
  color: var(--v5-ink);
  padding: 12px 16px max(28px, env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.ps-grab {
  align-self: center;
  width: 36px;
  height: 4px;
  border-radius: 2px;
  background: var(--v5-grab);
}
.ps-title {
  font-size: 20px;
  font-weight: 700;
}
.ps-body {
  font-size: 17px;
  font-weight: 500;
  line-height: 1.65;
  color: var(--v5-ink-2);
}
.ps-link {
  font-weight: 700;
  color: var(--v5-ink);
}
/* 按键行贴底（面板被 min-height 撑高时） */
.ps-row {
  margin-top: auto;
  padding-top: 4px;
  display: flex;
  gap: 8px;
}
.ps-no {
  flex: 1;
  min-width: 0;
}
/* 原生 button 去默认外观，交给 .k .k-ink 键帽（双类提权：压过内置 button:not([size=mini]) 等带属性选择器的默认样式） */
.ps-row .ps-btn {
  flex: 1.6;
  display: flex;
  height: 48px;
  background: var(--v5-key);
  color: var(--v5-key-hi);
  min-width: 0;
  width: auto;
  margin: 0;
  padding: 0 16px;
  line-height: normal;
  font-size: 17px;
  font-weight: 500;
  border-radius: 6px;
}
.ps-btn::after {
  border: none;
}
