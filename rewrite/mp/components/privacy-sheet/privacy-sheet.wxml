<!-- 微信隐私授权半屏（v5 设计稿 main.dc.html 723-731）：标题 + 正文（17/500 行高 1.65）+ 拒绝 / 同意并继续；面板至少和登录半屏一样高、按键行贴底。
     正文沿用原合规措辞（链《隐私政策》与微信完整指引），只改版式——设计稿那句列举场景的话与实际触发场景不一致，未照搬。
     「同意并继续」必须是原生 button open-type=agreePrivacyAuthorization（能力按钮·守卫 rw-mp-privacy-gated），套键帽类。 -->
<view wx:if="{{visible}}" class="v5-scope ps-root" catch:touchmove="noop">
  <view class="sh-mask ps-mask {{out ? 'out' : ''}}"></view>
  <view class="sh-panel ps-sheet {{out ? 'out' : ''}}">
    <text class="ps-title">隐私保护指引</text>
    <text class="t-sys ps-body">为给你提供完整服务，我们需要在调用相关功能前征得你的同意。请阅读<text class="ps-link" catch:tap="onPolicy">《隐私政策》</text>了解我们如何收集与使用信息，也可<text class="ps-link" catch:tap="onContract">查看完整指引</text>。</text>
    <view class="ps-row">
      <view class="k k-flat k-48 ps-no k-sq" hover-start-time="20" hover-class="k-flat-down" hover-stay-time="100" bind:tap="onDisagree" data-k="flat" bind:touchstart="onKeyDown" bind:touchend="onKeyUp"><px-i name="times" /></view>
      <button id="privacy-agree-btn" class="k k-ink k-48 ps-btn" hover-class="k-ink-down" hover-stay-time="100" open-type="agreePrivacyAuthorization" bind:agreeprivacyauthorization="onAgree" data-k="ink" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">同意并继续</button>
    </view>
  </view>
</view>
