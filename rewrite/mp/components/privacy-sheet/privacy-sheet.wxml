<!-- 微信隐私授权半屏：设计稿未单画，沿用 D2 登录半屏同一套样式（遮罩/圆角面板/把手/20px 标题/底部 次1:主1.6）。
     「同意并继续」必须是原生 button open-type=agreePrivacyAuthorization（能力按钮·守卫 rw-mp-privacy-gated），套键帽类。 -->
<view wx:if="{{visible}}" class="v5-scope ps-mask" catch:touchmove="noop">
  <view class="ps-sheet">
    <view class="ps-grab"></view>
    <text class="ps-title">隐私保护提示</text>
    <text class="t-sys ps-body">为给你提供完整服务，我们需要在调用相关功能前征得你的同意。请阅读<text class="ps-link" catch:tap="onPolicy">《隐私政策》</text>了解我们如何收集与使用信息，也可<text class="ps-link" catch:tap="onContract">查看完整指引</text>。</text>
    <view class="ps-row">
      <view class="k k-flat k-48 ps-no" hover-start-time="20" hover-class="k-flat-down" hover-stay-time="100" bind:tap="onDisagree" data-k="flat" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">不同意</view>
      <button id="privacy-agree-btn" class="k k-ink k-48 ps-btn" hover-class="k-ink-down" hover-stay-time="100" open-type="agreePrivacyAuthorization" bind:agreeprivacyauthorization="onAgree" data-k="ink" bind:touchstart="onKeyDown" bind:touchend="onKeyUp">同意并继续</button>
    </view>
  </view>
</view>
