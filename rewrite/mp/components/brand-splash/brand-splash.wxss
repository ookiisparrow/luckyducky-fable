/* 冷启动品牌开屏（v5 稿 data-splash）：#fafaf8 底、居中字标 36px 高 + 15px 等宽口号，间距 16。
   组件样式禁标签选择器（只用 class·mp 组件 wxss 约定）。 */
.ld-splash {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000; /* 压过自定义 tabBar（首页是 tabBar 页）·真机需验覆盖完整 */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16px;
  background: var(--v5-canvas);
}
/* 淡出时长须与 brand-splash.ts FADE_MS（500）一致 */
.ld-splash.leaving {
  animation: ld-splash-out 500ms ease-out both;
}
.ld-splash-logo {
  height: 36px;
}
.ld-splash-slogan {
  font-size: 15px;
  font-weight: 500;
  letter-spacing: -0.01em;
  color: var(--v5-ink-2);
}
@keyframes ld-splash-out {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}
