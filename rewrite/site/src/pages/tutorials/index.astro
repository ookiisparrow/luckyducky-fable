---
// 教程列表页。
import Base from '../../layouts/Base.astro'
import { breadcrumbSchema, jsonLd } from '../../lib/schema'
import { sortedTutorials, TUTORIALS_DESCRIPTION } from '../../lib/tutorials'

const tutorials = await sortedTutorials()
const crumbs = breadcrumbSchema([
  { name: '首页', path: '/' },
  { name: '钩织教程', path: '/tutorials/' },
])
---

<Base title="钩织入门教程合集" description={TUTORIALS_DESCRIPTION}>
  {crumbs && <script type="application/ld+json" set:html={jsonLd(crumbs)} />}
  <h1>钩织教程</h1>
  <ul>
    {tutorials.map((t) => (
      <li>
        <a href={`/tutorials/${t.slug}/`}>{t.data.title}</a>
        <span class="desc">{t.data.description}</span>
      </li>
    ))}
  </ul>
</Base>

<style>
  h1 {
    color: #241733;
  }
  ul {
    padding-left: 18px;
  }
  li {
    margin-bottom: 12px;
  }
  a {
    color: #7b5caf;
  }
  .desc {
    display: block;
    font-size: 13px;
    color: #7e6e96;
  }
</style>
