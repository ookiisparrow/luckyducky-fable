# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
__pycache__/
*.pyc
.DS_Store
dist
*.local

# Editor directories and files
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 微信开发者工具在项目根生成的本地配置（不入库）
project.config.json
project.private.config.json
# 小程序自动化测试(minitest)自动生成的本地配置（不入库）
rewrite/mp/minitest/

# format-hook 测试的临时格式化目录（afterEach 自删，防意外残留入库）
.fmt-test-*

# build:cloud 并发锁（原子 mkdir，构建完即删；崩溃残留由下次构建 2min 破除）
.build-cloud.lock

# 体检面板产物（npm run report 生成 核不入库）
reports/

# vitest --coverage 产物（B8·仅本地/CI 度量用，不入库）
coverage/

# Astro 生成目录（默认不入库；typecheck 先 astro sync 再给 env.d.ts 用）
rewrite/site/.astro/
# 变异测试沙盒（StrykerJS 运行时副本，报告在 reports/mutation/·已随 reports/ 不入库）
.stryker-tmp/

